#. module: custom_work_order
#: model:ir.model.fields,field_description:custom_work_order.field_res_partner__delivery_contact_name
#: model:ir.model.fields,field_description:custom_work_order.field_res_users__delivery_contact_name
msgid "Delivery Contact"
msgstr "Contacto de Entrega"

#. module: custom_work_order
#: model:ir.model.fields,help:custom_work_order.field_res_partner__delivery_contact_name
#: model:ir.model.fields,help:custom_work_order.field_res_users__delivery_contact_name
msgid ""
"Name of the person who picks up or receives the goods at this delivery "
"address. It is printed in the 'Shipping Details' section (Part 3) of the Work "
"Order report as the contact responsible for the delivery. Leave it empty if "
"no specific contact applies; the report will then show only the phone number, "
"or '-' if none."
msgstr ""
"Nombre de la persona que recoge o recibe la mercancía en esta dirección de "
"entrega. Se imprime en la sección 'Detalles del Envío' (Parte 3) del reporte "
"de Orden de Trabajo como el contacto responsable de la entrega. Déjalo vacío "
"si no aplica un contacto específico; en ese caso el reporte mostrará solo el "
"número de teléfono, o '-' si no hay ninguno."

#. module: custom_work_order
#: model:ir.actions.report,name:custom_work_order.report_work_order_action
