<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Smart button de ECOs en la orden de venta -->
    <record id="sale_order_view_form_inherit_eco" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.auto.eco</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ecos"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cogs"
                        invisible="eco_count == 0">
                    <field name="eco_count"
                           widget="statinfo"
                           string="ECOs"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
