<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- STOCK PICKING TYPE FORM VIEW EXTENSION -->
    <record id="view_picking_type_form_delivery_portal" model="ir.ui.view">
        <field name="name">stock.picking.type.form.delivery.portal</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Delivery Portal" name="delivery_portal">
                    <group string="Portal Settings" name="portal_settings">
                        <field name="delivery_portal_show_items" help="Show product items in the delivery portal"/>
                        <field name="allow_driver_contact" help="Allow drivers to contact recipients via call, SMS, WhatsApp"/>
                        <field name="show_reference_in_portal"/>
                        <field name="show_barcode_in_portal"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
