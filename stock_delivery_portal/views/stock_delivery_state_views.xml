<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH View -->
    <record id="view_stock_delivery_state_search" model="ir.ui.view">
        <field name="name">stock.delivery.state.search</field>
        <field name="model">stock.delivery.state</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- FORM View -->
    <record id="view_stock_delivery_state_form" model="ir.ui.view">
        <field name="name">stock.delivery.state.form</field>
        <field name="model">stock.delivery.state</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="icon"/>
                        </group>
                        <group name="classification" string="Classification">
                            <field name="is_result_state"/>
                            <field name="result_type" required="is_result_state" invisible="not is_result_state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration" name="configuration">
                            <group>
                                <group string="Applies To">
                                    <field name="picking_type_ids" widget="many2many_tags"/>
                                </group>
                                <group string="Requirements">
                                    <field name="require_signature"/>
                                    <field name="is_signature_mandatory" invisible="not require_signature"/>
                                    <field name="require_photo"/>
                                    <field name="is_photo_mandatory" invisible="not require_photo"/>
                                    <field name="require_receiver_name"/>
                                    <field name="is_receiver_name_mandatory" invisible="not require_receiver_name"/>
                                </group>
                            </group>
                        </page>
                        <page string="Automation" name="automation">
                            <group>
                                <field name="mail_template_id"/>
                                <field name="whatsapp_template_id"/>
                            </group>
                        </page>
                        <page string="Portal Info" name="portal_info">
                            <group>
                                <field name="help_delivery"/>
                                <field name="legal_text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TREE View -->
    <record id="view_stock_delivery_state_tree" model="ir.ui.view">
        <field name="name">stock.delivery.state.tree</field>
        <field name="model">stock.delivery.state</field>
        <field name="arch" type="xml">
            <list editable="bottom" multi_edit="1" open_form_view="True">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="picking_type_ids" widget="many2many_tags"/>
                <field name="is_result_state"/>
                <field name="result_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_stock_delivery_state" model="ir.actions.act_window">
        <field name="name">Delivery States</field>
        <field name="res_model">stock.delivery.state</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define delivery states
            </p>
        </field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_stock_delivery_state"
              name="Delivery States"
              parent="stock.menu_stock_config_settings"
              action="action_stock_delivery_state"
              sequence="50"/>

</odoo>
