<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company Rule for Delivery State -->
        <record id="stock_delivery_state_comp_rule" model="ir.rule">
            <field name="name">Stock Delivery State Multi-company</field>
            <field name="model_id" ref="model_stock_delivery_state"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Portal User Rule for Pickings -->
        <!-- Only see pickings where they are the assigned delivery partner -->
        <record id="stock_picking_portal_delivery_rule" model="ir.rule">
            <field name="name">Stock Picking Portal Delivery Driver</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[('delivery_partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/> <!-- Drivers need write access to update state/evidence? Via API usually requires write, or we use sudo() in method. 
            The prompt says "Cambiar estado permitido, Adjuntar evidencias". 
            If they use the API method, `self.write` checks permissions. 
            So they need write permission on the picking or we use sudo in the method.
            "API methods (model methods)" -> If called by portal user, `self.write` will trigger access check.
            So strict rule: They can WRITE their assigned pickings.
            CAUTION: Giving portal users write access to stock.picking is risky if views allow other fields.
            Since there are NO portal views, they only access via API.
            But if they hack the call, they could write other fields?
            Standard Odoo portal logic usually grants specific access or uses sudo.
            However, restricting write access to ONLY their pickings is safe-ish.
            I'll give write access. -->
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
