<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ple_update_purchase_tags_wizard_form" model="ir.ui.view">
        <field name="name">ple.update.purchase.tags.wizard.form</field>
        <field name="model">ple.update.purchase.tags.wizard</field>
        <field name="arch" type="xml">
            <form string="Update PLE Tags">
                <group>
                    <div class="alert alert-info" role="alert">
                        This wizard will update the <b>Account Tax Repartition Lines</b> for the selected configurations.
                        <br/>
                        It searches for taxes by their <b>External ID</b> (e.g. <i>account.[company_id]_[suffix]</i>) and appends the configured tags.
                    </div>
                </group>
                <group>
                    <group>
                        <field name="company_id" readonly="1"/>
                    </group>
                </group>
                <field name="config_ids">
                    <list string="Configurations" create="0" delete="0">
                        <field name="name"/>
                        <field name="tax_xml_suffix"/>
                        <field name="repartition_type"/>
                        <field name="tag_invoice_id"/>
                        <field name="tag_refund_id"/>
                    </list>
                </field>
                <footer>
                    <button name="action_execute" string="Update Tags" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>


</odoo>
