#. module: ple_purchase_book
#: model:ir.model.fields,field_description:ple_purchase_book.field_account_move__igv_withholding_indicator
msgid "Purchases IGV or Rent Withholding Indicator"
msgstr "Indicador de retención del IGV o Renta en Compras"

#. module: ple_purchase_book
#: model:ir.model.fields,help:ple_purchase_book.field_account_move__igv_withholding_indicator
msgid "If the field is activated, it automatically appears in the purchase record that the payment receipt is subject to IGV, Rent or both withholding inclusive"
msgstr "Si el campo se activa, de forma automática aparece el en registro de compras que el comprobante de pago registrado está afecto a retención del IGV, Renta o ambas inclusive"

#. module: ple_purchase_book
#: model:ir.model.fields,field_description:ple_purchase_book.field_account_move__inv_id
msgid "Proof of Payment"
msgstr "C. P. Sustento"

#. module: ple_purchase_book
#: model:ir.model.fields,field_description:ple_purchase_book.field_account_move__inv_type_document
msgid "Document Type"
msgstr "Tipo documento"

#. module: ple_purchase_book
#: model:ir.model.fields,help:ple_purchase_book.field_account_move__inv_type_document
msgid "Document Type that supports the fiscal credit."
msgstr "Tipo de Comprobante de Pago o Documento que sustenta el crédito fiscal."

#. module: ple_purchase_book
#: model:ir.model.fields,field_description:ple_purchase_book.field_account_move__inv_serie
msgid "Receipt Series"
msgstr "Serie de Comprabante"

#. module: ple_purchase_book
#: model:ir.model.fields,help:ple_purchase_book.field_account_move__inv_serie
msgid "Series of the payment voucher or document that supports the fiscal credit.In the cases of the Single Customs Declaration (DUA) or the Simplified Import Declaration (DSI) the code of the Customs dependency shall be entered."
msgstr "Serie del comprobante de pago o documento que sustenta el crédito fiscal.En los casos de la Declaración Única de Aduanas (DUA) o de la Declaración Simplificada de Importación (DSI) se consignará el código de la dependencia Aduanera."

#. module: ple_purchase_book
#: model:ir.model.fields,field_description:ple_purchase_book.field_account_move__inv_correlative
msgid "Receipt Correlative"
msgstr "Correlativo de Comprobante"

#. module: ple_purchase_book
#: model:ir.model.fields,help:ple_purchase_book.field_account_move__inv_correlative
msgid "Number of the payment voucher or document or order number of the physical or virtual form where the payment of the tax is stated, in the case of the use of services provided by non-domiciled or others, number of the DUA or DSI, which supports the fiscal credit."
msgstr "Número del comprobante de pago o documento o número de orden del formulario físico o virtual donde conste el pago del impuesto, tratándose de la utilización de servicios prestados por no domiciliados u otros, número de la DUA o de la DSI, que sustente el crédito fiscal."

#. module: ple_purchase_book
#: model:ir.model.fields,field_description:ple_purchase_book.field_account_move__inv_year_dua_dsi
msgid "Year of Issuance DUA or DSI"
msgstr "Año emisión DUA o DSI"

#. module: ple_purchase_book
#: model:ir.model.fields,help:ple_purchase_book.field_account_move__inv_year_dua_dsi
msgid "Year of issuance of the DUA or DSI that supports the fiscal credit. Odoo validates that this field registers a number greater than 1981 and less than or equal to the year of the reported period"
msgstr "Año de emisión de la DUA o DSI que sustenta el crédito fiscal. Odoo valida que en este campo se registre número mayor a 1981 y menor o igual al año del periodo informado"

#. module: ple_purchase_book
