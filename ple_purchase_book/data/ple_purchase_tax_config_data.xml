        <!-- ACCOUNT TAGS (Unsigned Strategy) -->
        <!-- ======================================================== -->
        
        <!-- P_BASE_GDG: Gravado Destinado a Gravado -->
        <record id="tag_ple_purchase_base_gdg" model="account.account.tag">
            <field name="name">P_BASE_GDG</field>
            <field name="applicability">taxes</field>
            <field name="country_id" ref="base.pe"/>
        </record>

