msgid ""
"<i class=\"fa fa-flask\" title=\"Simulation\"/> <strong>Simulation is on.</strong>\n"
"                    Nothing is sent to the carrier: tracking numbers and statuses of this shipping method are fictitious.\n"
"                    Use it only for demos and training."
msgstr ""
"<i class=\"fa fa-flask\" title=\"Simulación\"/> <strong>La simulación está activa.</strong>\n"
"                    No se envía nada al transportista: los números de seguimiento y los estados de este método de envío son ficticios.\n"
"                    Úsela solo para demostraciones y formación."

