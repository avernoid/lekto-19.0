<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_carrier_form_delivery_status" model="ir.ui.view">
        <field name="name">delivery.carrier.form.delivery.status</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <div name="title" position="before">
                <div class="alert alert-warning" role="alert" invisible="not delivery_simulation">
                    <i class="fa fa-flask" title="Simulation"/> <strong>Simulation is on.</strong>
                    Nothing is sent to the carrier: tracking numbers and statuses of this shipping method are fictitious.
                    Use it only for demos and training.
                </div>
            </div>
            <field name="tracking_url" position="after">
                <field name="delivery_simulation"/>
                <field name="delivery_simulation_prefix" invisible="not delivery_simulation"/>
            </field>
        </field>
    </record>

</odoo>
