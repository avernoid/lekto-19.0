<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_payment_control" model="ir.ui.view">
        <field name="name">sale.order.form.payment.control</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Ribbons for Elegant Display -->
            <xpath expr="//sheet" position="before">
                 <!-- Ribbons need to be inside the form but outside sheet? No, inside sheet usually. 
                      Actually, standard is inside sheet. -->
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="No Control" bg_color="bg-muted" invisible="payment_coverage_status != 'no_control'"/>
                <widget name="web_ribbon" title="Not Covered" bg_color="bg-danger" invisible="payment_coverage_status != 'not_covered'"/>
                <widget name="web_ribbon" title="Partially Covered" bg_color="bg-warning" invisible="payment_coverage_status != 'partially_covered'"/>
                <widget name="web_ribbon" title="Fully Covered" bg_color="bg-success" invisible="payment_coverage_status != 'fully_covered'"/>
                <widget name="web_ribbon" title="Credit Not Due" bg_color="bg-success" invisible="payment_coverage_status != 'credit_not_due'"/>
            </xpath>
            
            <xpath expr="//page[@name='other_information']" position="inside">
                <group string="Delivery Payment Control">
                    <field name="payment_control_active"/>
                    <field name="payment_validation_level" invisible="not payment_control_active"/>
                    <field name="include_credit_analysis" invisible="not payment_control_active"/>
                    <field name="require_full_payment" invisible="not payment_control_active"/>
                    <!-- Also keep the field invisible somewhere if needed for domain? It is used in ribbon invisible attr -->
                    <field name="payment_coverage_status" invisible="1"/> 
                </group>
            </xpath>
        </field>
    </record>
    
    <!-- Quotations Tree: Optional Hide -->
    <record id="view_quotation_tree_inherit_payment_control" model="ir.ui.view">
        <field name="name">sale.quotation.tree.payment.control</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="payment_coverage_status" widget="badge" 
                    optional="hide"
                    decoration-success="payment_coverage_status in ('fully_covered', 'credit_not_due')"
                    decoration-warning="payment_coverage_status == 'partially_covered'"
                    decoration-danger="payment_coverage_status == 'not_covered'"
                />
            </field>
        </field>
    </record>

    <!-- Sales Order Tree: Optional Show (Default Visible) -->
    <record id="view_order_tree_inherit_payment_control" model="ir.ui.view">
        <field name="name">sale.order.tree.payment.control</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="payment_coverage_status" widget="badge" 
                    optional="show"
                    decoration-success="payment_coverage_status in ('fully_covered', 'credit_not_due')"
                    decoration-warning="payment_coverage_status == 'partially_covered'"
                    decoration-danger="payment_coverage_status == 'not_covered'"
                />
            </field>
        </field>
    </record>
</odoo>
