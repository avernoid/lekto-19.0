<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_team_form_inherit_payment_control" model="ir.ui.view">
        <field name="name">crm.team.form.payment.control</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
             <xpath expr="//group[@name='right']" position="inside">
                <group string="Delivery Payment Control Defaults">
                    <field name="payment_control_active"/>
                    <field name="payment_validation_level" invisible="not payment_control_active"/>
                     <field name="include_credit_analysis" invisible="not payment_control_active"/>
                    <field name="require_full_payment" invisible="not payment_control_active"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
