<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_payment_control" model="ir.ui.view">
        <field name="name">res.partner.form.payment.control</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']" position="inside">
                <group string="Delivery Payment Control Defaults" colspan="2">
                    <field name="payment_control_active"/>
                    <field name="payment_validation_level" invisible="not payment_control_active"/>
                     <field name="include_credit_analysis" invisible="not payment_control_active"/>
                    <field name="require_full_payment" invisible="not payment_control_active"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
