<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_payment_control" model="ir.ui.view">
        <field name="name">stock.picking.form.payment.control</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="No Control" bg_color="bg-muted" invisible="payment_coverage_status != 'no_control'"/>
                <widget name="web_ribbon" title="Not Covered" bg_color="bg-danger" invisible="payment_coverage_status != 'not_covered'"/>
                <widget name="web_ribbon" title="Partially Covered" bg_color="bg-warning" invisible="payment_coverage_status != 'partially_covered'"/>
                <widget name="web_ribbon" title="Fully Covered" bg_color="bg-success" invisible="payment_coverage_status != 'fully_covered'"/>
                <widget name="web_ribbon" title="Credit Not Due" bg_color="bg-success" invisible="payment_coverage_status != 'credit_not_due'"/>
                <field name="payment_coverage_status" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_tree_inherit_payment_control" model="ir.ui.view">
        <field name="name">stock.picking.tree.payment.control</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
             <field name="state" position="before">
                <field name="payment_coverage_status" widget="badge" 
                    optional="hide"
                    decoration-success="payment_coverage_status in ('fully_covered', 'credit_not_due')"
                    decoration-warning="payment_coverage_status == 'partially_covered'"
                    decoration-danger="payment_coverage_status == 'not_covered'"
                />
            </field>
        </field>
    </record>
</odoo>
