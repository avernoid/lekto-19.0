#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_sale_order__payment_control_active
msgid "Check this box to enable the delivery blocking mechanism based on payment status for this specific order. Defaults are loaded from the Customer or Sales Team."
msgstr "Marque esta casilla para habilitar el mecanismo de bloqueo de entrega basado en el estado de pago para este pedido específico. Los valores predeterminados se cargan desde el Cliente o el Equipo de Ventas."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_res_partner__payment_control_active
msgid "If configured, sales orders for this customer will have Payment Control enabled by default."
msgstr "Si está configurado, los pedidos de venta para este cliente tendrán el Control de Pago habilitado por defecto."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_crm_team__payment_control_active
msgid "If configured, sales orders for this team will have Payment Control enabled by default (unless overridden by Customer settings)."
msgstr "Si está configurado, los pedidos de venta para este equipo tendrán el Control de Pago habilitado por defecto (a menos que sea anulado por la configuración del Cliente)."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_sale_order__payment_validation_level
msgid "Select 'Sale Order Level' to validate based on the total order payment status, or 'Picking Level' to validate based on the specific value of goods in the picking."
msgstr "Seleccione 'Nivel Orden de Venta' para validar según el estado de pago total del pedido, o 'Nivel Albarán' para validar según el valor específico de los bienes en el albarán."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_res_partner__payment_validation_level
msgid "Default validation level for this customer's orders."
msgstr "Nivel de validación por defecto para los pedidos de este cliente."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_crm_team__payment_validation_level
msgid "Default validation level for this team's orders."
msgstr "Nivel de validación por defecto para los pedidos de este equipo."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_sale_order__include_credit_analysis
msgid "If checked, the system will consider the partner's credit terms. If the credit is not due (payment term days > 0), validation will be allowed even if unpaid."
msgstr "Si está marcado, el sistema considerará los términos de crédito del cliente. Si el crédito está vigente (días de plazo de pago > 0), se permitirá la validación incluso si no se ha pagado."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_res_partner__include_credit_analysis
msgid "Default setting for credit analysis inclusion for this customer."
msgstr "Configuración por defecto para la inclusión del análisis de crédito para este cliente."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_crm_team__include_credit_analysis
msgid "Default setting for credit analysis inclusion for this team."
msgstr "Configuración por defecto para la inclusión del análisis de crédito para este equipo."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_sale_order__require_full_payment
msgid "If checked, the delivery will only be allowed if the order (or picking value) is 100% paid. Partial payments will block validation."
msgstr "Si está marcado, la entrega solo se permitirá si el pedido (o el valor del albarán) está pagado al 100%. Los pagos parciales bloquearán la validación."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_res_partner__require_full_payment
msgid "Default setting for requiring full payment before delivery for this customer."
msgstr "Configuración por defecto para requerir el pago completo antes de la entrega para este cliente."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_crm_team__require_full_payment
msgid "Default setting for requiring full payment before delivery for this team."
msgstr "Configuración por defecto para requerir el pago completo antes de la entrega para este equipo."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_sale_order__payment_coverage_status
#: model:ir.model.fields,help:stock_delivery_payment_control.field_stock_picking__payment_coverage_status
msgid "The current calculated payment status. 'Fully Covered' means paid or within credit terms 'Not Covered' means payment is required."
msgstr "El estado de pago calculado actual. 'Totalmente Cubierto' significa pagado o dentro de los términos de crédito. 'No Cubierto' significa que se requiere el pago."

#. module: stock_delivery_payment_control
#: model:ir.model.fields,help:stock_delivery_payment_control.field_stock_picking_type__enforce_payment_control
msgid "If checked, pickings of this type will be subject to payment control validation and will count towards the delivered value of the sale order."
msgstr "Si está marcado, los albaranes de este tipo estarán sujetos a la validación de control de pago y contarán para el valor entregado del pedido de venta."

#. module: stock_delivery_payment_control
#: code:addons/stock_delivery_payment_control/models/stock_picking.py:0
#, python-format
msgid "Blocking Validation: Payment not covered (Status: %s)"
msgstr "Bloqueo de Validación: Pago no cubierto (Estado: %s)"

#. module: stock_delivery_payment_control
#: code:addons/stock_delivery_payment_control/models/stock_picking.py:0
#, python-format
msgid "Blocking Validation: Partial payment not allowed (Full Payment Required)"
msgstr "Bloqueo de Validación: Pago parcial no permitido (Se requiere pago completo)"

#. module: stock_delivery_payment_control
#: model:ir.ui.view,arch_db:stock_delivery_payment_control.view_picking_type_form_inherit_payment_control
msgid "Warning:"
msgstr "Advertencia:"

#. module: stock_delivery_payment_control
#: model:ir.ui.view,arch_db:stock_delivery_payment_control.view_picking_type_form_inherit_payment_control
msgid "In multi-step routes (e.g. Pick -> Pack -> Ship), enable this ONLY on one operation (usually the final Delivery) to avoid double-counting delivered value and blocking internal transfers."
msgstr "En rutas de varios pasos (ej. Recoger -> Empaquetar -> Enviar), habilite esto SOLO en una operación (generalmente la Entrega final) para evitar el conteo doble del valor entregado y el bloqueo de transferencias internas."

#. module: stock_delivery_payment_control
