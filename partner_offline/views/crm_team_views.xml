<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_view_form_portal_visibility" model="ir.ui.view">
        <field name="name">crm.team.form.portal.visibility</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="portal_contact_visibility" widget="radio"/>
            </xpath>
        </field>
    </record>
</odoo>
