<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project_inherit_auto_cancel" model="ir.ui.view">
        <field name="name">project.project.form.inherit.auto.cancel</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_start']" position="before">
                <label for="antiquity_in_hours"/>
                <div class="o_row">
                    <field name="antiquity_in_hours"/>
                    <button name="action_manually_run_cron" 
                            string="Run Manually" 
                            type="object" 
                            class="oe_link"
                            invisible="antiquity_in_hours == 0"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
