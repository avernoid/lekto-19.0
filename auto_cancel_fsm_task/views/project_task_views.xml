<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherit_auto_cancel" model="ir.ui.view">
        <field name="name">project.task.form.inherit.auto.cancel</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="not_executed" invisible="state != '1_done'"/>
            </xpath>
        </field>
    </record>
</odoo>
