#. module: ple_cash_book
#: model:ir.model.fields,help:ple_cash_book.field_ple_report_cash_bank__txt_binary_bank
msgid "Downloadable TXT file in SUNAT PLE format for Bank Account entries (TXT 1.2). Upload this file directly to SUNAT's PLE program."
msgstr "Archivo TXT descargable en formato PLE SUNAT para entradas de Cuentas Corrientes (TXT 1.2). Suba este archivo directamente al programa PLE de SUNAT."

#. module: ple_cash_book
#: model:ir.model.fields,field_description:ple_cash_book.field_account_account__bank_id
msgid "Bank Account"
msgstr "Cuenta Bancaria"

#. module: ple_cash_book
#: model:ir.model.fields,help:ple_cash_book.field_account_account__bank_id
msgid "Link this account to a bank account. The bank's SUNAT code (l10n_pe_edi_code) will be used in the PLE Bank report (TXT 1.2). Only relevant for accounts of type 'Cash and Bank Accounts' (asset_cash)."
msgstr "Vincula esta cuenta a una cuenta bancaria. El código SUNAT del banco (l10n_pe_edi_code) se usará en el reporte PLE de Bancos (TXT 1.2). Solo relevante para cuentas de tipo 'Efectivo y Bancos' (asset_cash)."

#. module: ple_cash_book
#: model:ir.model.fields,field_description:ple_cash_book.field_account_payment__means_payment_id
#: model:ir.model.fields,field_description:ple_cash_book.field_account_payment_register__means_payment_id
msgid "Payment Method (Bank Book)"
msgstr "Medio de Pago (Libro Bancos)"

#. module: ple_cash_book
#: model:ir.model.fields,help:ple_cash_book.field_account_payment__means_payment_id
msgid "SUNAT payment method code used in the PLE Bank Book report (TXT 1.2). Defaults to code '003' (bank transfer). Select the appropriate method matching how this payment was made (e.g., check, wire transfer, deposit)."
msgstr "Código de medio de pago SUNAT usado en el reporte PLE Libro de Bancos (TXT 1.2). Por defecto código '003' (transferencia bancaria). Seleccione el método apropiado según cómo se realizó el pago (ej. cheque, transferencia, depósito)."

#. module: ple_cash_book
#: model:ir.model.fields,help:ple_cash_book.field_account_payment_register__means_payment_id
msgid "SUNAT payment method code used in the PLE Bank Book report (TXT 1.2). Defaults to code '003' (bank transfer). This field only appears when the selected journal is of bank type. For cash journals, code '003' is used automatically."
msgstr "Código de medio de pago SUNAT usado en el reporte PLE Libro de Bancos (TXT 1.2). Por defecto código '003' (transferencia bancaria). Este campo solo aparece cuando el diario seleccionado es de tipo banco. Para diarios de efectivo, se usa automáticamente el código '003'."

#. module: ple_cash_book
#: model:ir.model.fields,field_description:ple_cash_book.field_account_payment_register__inv
msgid "Show Payment Method"
msgstr "Mostrar Medio de Pago"

#. module: ple_cash_book
#: model:ir.model.fields,help:ple_cash_book.field_account_payment_register__inv
msgid "Technical field that controls the visibility of the Payment Method (Medio de Pago) field. When True (journal is not cash type), the payment method selector is shown. When False (cash journal), it is hidden since cash payments default to code '003'."
msgstr "Campo técnico que controla la visibilidad del campo Medio de Pago. Cuando es Verdadero (diario no es de tipo efectivo), se muestra el selector de medio de pago. Cuando es Falso (diario de efectivo), se oculta ya que los pagos en efectivo usan por defecto el código '003'."

