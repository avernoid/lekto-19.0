<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_inherit_amount_to_text" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.amount.to.text</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']" position="inside">
                <group string="Amount to Text Configuration">
                    <field name="amount_text_format"/>
                    <field name="amount_text_in_caps"/>
                    <field name="amount_text_lang_id" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
