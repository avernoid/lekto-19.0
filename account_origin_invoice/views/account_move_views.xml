<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_form_view_inherit_account_origin_invoice" model="ir.ui.view">
        <field name="name">account.move.form.view.inherit.account_origin_invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reversed_entry_id']" position="replace"/>
            <xpath expr="//field[@name='debit_origin_id']" position="replace"/>
            <xpath expr="//page[@name='other_info']" position="after">
                <page name="document_refund_invoice" string="Rectified Document" invisible="internal_type not in ['debit_note','credit_note']">
                    <group>
                        <group>
                            <field name="reversed_entry_id" invisible="internal_type != 'credit_note'"/>
                            <field name="debit_origin_id" invisible="internal_type != 'debit_note'"/>
                            <field name="origin_move_id" options="{'no_create_edit': True}" invisible= "reversed_entry_id != 'False'and debit_origin_id != 'False'"/>
                            <field name="origin_number" required="l10n_latam_document_type_id.code in ['07', '08']"/>
                            <field name="origin_invoice_date" required= "l10n_latam_document_type_id.code in ['07', '08']"/>
                        </group>
                        <group>
                            <field name="origin_l10n_latam_document_type_id" required= "l10n_latam_document_type_id.code in ['07', '08']"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
