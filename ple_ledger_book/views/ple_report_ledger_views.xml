<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    
    <record id="ple_report_ledger_view_form" model="ir.ui.view">
        <field name="name">ple.report.ledger.view.form</field>
        <field name="model">ple.report.ledger</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_excel" string="Generar Reporte" type="object" invisible="state != 'draft'"/>
                    <button name="action_close" string="Declarar a SUNAT" invisible="state != 'load'" type="object"/>
                    <button name="action_rollback" string="Regresar a Borrador" invisible="state not in ('load','closed')" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group string="Reportes PLE" id="ple_cash_bank">
                        <group>
                            <field name="company_id"/>
                            <label for="date_start" string="Period"/>
                            <div class="o_address_format">
                                <field name="date_start" class="oe_inline" placeholder="Start date..."/>
                                <i class="fa fa-long-arrow-right mx-2 oe_inline" aria-label="to" title="to"/>
                                <field name="date_end" class="oe_inline" placeholder="End date..."/>
                            </div>
                            <field name="state_send"/>
                            <field name="date_ple"/>
                        </group>
                        <group>
                            <field name="xls_filename_ledger" invisible="1"/>
                            <field name="xls_binary_ledger" filename="xls_filename_ledger" readonly="1" string="Reporte Excel"/>
                            <field name="txt_filename_ledger" invisible="1"/>
                            <field name="txt_binary_ledger" filename="txt_filename_ledger" readonly="1"/>
                        </group>
                    </group>
                    <field name="error_dialog" readonly="1" invisible="not error_dialog" string="Advertencias"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ple_report_ledger_view_list" model="ir.ui.view">
        <field name="name">ple.report.ledger.view.list</field>
        <field name="model">ple.report.ledger</field>
        <field name="arch" type="xml">
            <list string="Libro Mayor">
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id" optional="show"/>
                <field name="date_ple"/>
                <field name="state"/>
                <field name="xls_filename_ledger" column_invisible="1"/>
                <field name="xls_binary_ledger" widget="binary" filename="xls_filename_ledger" string="Excel" optional="show"/>
                <field name="txt_filename_ledger" column_invisible="1"/>
                <field name="txt_binary_ledger" widget="binary" filename="txt_filename_ledger" string="TXT" optional="show"/>
            </list>
        </field>
    </record>

    <record id="ple_report_ledger_view_search" model="ir.ui.view">
        <field name="name">ple.report.ledger.view.search</field>
        <field name="model">ple.report.ledger</field>
        <field name="arch" type="xml">
            <search string="Libro Mayor">
                <field name="company_id"/>
                <field name="date_start"/>
                <separator/>
                <filter name="filter_draft" string="Borrador" domain="[('state','=','draft')]"/>
                <filter name="filter_generated" string="Generado" domain="[('state','=','load')]"/>
                <filter name="filter_declared" string="Declarado" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}"/>
                <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                <filter name="group_period" string="Periodo" context="{'group_by': 'date_start:month'}"/>
            </search>
        </field>
    </record>
    
</odoo>
