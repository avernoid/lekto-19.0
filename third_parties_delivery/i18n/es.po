#. module: third_parties_delivery
#: model:ir.model.fields,field_description:third_parties_delivery.field_stock_picking__customer_id
msgid "New delivery address"
msgstr "Nueva dirección de entrega"

#. module: third_parties_delivery
#: model:ir.model.fields,help:third_parties_delivery.field_stock_picking__customer_id
msgid "Specific address for the physical delivery of goods. Used when the delivery location differs from the invoice partner address."
msgstr "Dirección específica para la entrega física de bienes. Se utiliza cuando la ubicación de entrega difiere de la dirección del socio de la factura."

#. module: third_parties_delivery
#: model:ir.model.fields,field_description:third_parties_delivery.field_stock_picking__deliver_to_third_parties
msgid "Deliver to third parties"
msgstr "Entregar a proveedor/comprador a terceros"

#. module: third_parties_delivery
#: model:ir.model.fields,help:third_parties_delivery.field_stock_picking__deliver_to_third_parties
msgid "Check this box to specify a different delivery address (Point of Arrival) for the Electronic Delivery Guide."
msgstr "Marque esta casilla para especificar una dirección de entrega diferente (Punto de Llegada) para la Guía de Remisión Electrónica."

#. module: third_parties_delivery
#: model:ir.model.fields,field_description:third_parties_delivery.field_stock_picking__third_parties
msgid "Supplier/Buyer"
msgstr "Proveedor/Comprador"

#. module: third_parties_delivery
#: model:ir.model.fields,help:third_parties_delivery.field_stock_picking__third_parties
