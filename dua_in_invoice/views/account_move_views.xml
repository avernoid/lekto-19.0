<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="account_move_form_view_inherit_dua_in_invoice" model="ir.ui.view">
        <field name="name">account.move.form.view.inherit.dua_in_invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_latam_invoice_document.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_latam_document_type_id']" position="after">
                <field name="related_document_type_code" invisible="1"/>
                <field name="year_aduana"
                       invisible="related_document_type_code not in ('50', '52','53')"
                       required="related_document_type_code in ('50', '52','53')"/>
                <field name="code_aduana"
                       invisible="related_document_type_code not in ('50', '52','53')"
                       required="related_document_type_code in ('50', '52','53')"/>
            </xpath>
        </field>
    </record>

</odoo>
