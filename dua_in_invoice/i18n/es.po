#. module: dua_in_invoice
#: model:ir.model,name:dua_in_invoice.model_account_move
msgid "Journal Entry"
msgstr "Asiento Contable"

#. module: dua_in_invoice
#: model:ir.model.fields,field_description:dua_in_invoice.field_account_move__year_aduana
msgid "Year of Emission"
msgstr "Año de Emisión"

#. module: dua_in_invoice
#: model:ir.model.fields,help:dua_in_invoice.field_account_move__year_aduana
msgid "Year of issuance of the Customs Declaration of Goods - Definitive Import or Simplified Dispatch - Simplified Import."
msgstr "Año de emisión de la Declaración Aduanera de Mercancías - Importación definitiva o del Despacho Simplificado - Importación Simplificada."

#. module: dua_in_invoice
#: model:ir.model.fields,field_description:dua_in_invoice.field_account_move__code_aduana
msgid "Customs Dependency"
msgstr "Dependencia Aduanera"

#. module: dua_in_invoice
#: model:ir.model.fields,help:dua_in_invoice.field_account_move__code_aduana
msgid "Select the Customs Dependency code associated with this document. This code identifies the specific customs office where the declaration was processed."
msgstr "Seleccione el código de Dependencia Aduanera asociado con este documento. Este código identifica la oficina aduanera específica donde se procesó la declaración."

#. module: dua_in_invoice
#: model:ir.model.fields,field_description:dua_in_invoice.field_account_move__related_document_type_code
msgid "Document Type Code"
msgstr "Código de Tipo de Documento"

#. module: dua_in_invoice
#: model:ir.model.fields,help:dua_in_invoice.field_account_move__related_document_type_code
msgid "Technical field used to store the code of the selected L10N LATAM Document Type. It is used to conditionally display customs-related fields."
msgstr "Campo técnico utilizado para almacenar el código del Tipo de Documento L10N LATAM seleccionado. Se utiliza para mostrar condicionalmente los campos relacionados con aduanas."
