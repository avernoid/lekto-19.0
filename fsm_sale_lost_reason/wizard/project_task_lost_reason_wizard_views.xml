<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_lost_reason_wizard_view_form" model="ir.ui.view">
        <field name="name">project.task.lost.reason.wizard.view.form</field>
        <field name="model">project.task.lost.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Lost Reason">
                <group>
                    <field name="task_id" invisible="1"/>
                    <field name="from_geo_visit" invisible="1"/>
                    <field name="lost_reason_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
