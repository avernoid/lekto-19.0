<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_view_form_inherit_fsm_sale_lost_reason" model="ir.ui.view">
        <field name="name">project.task.view.form.inherit.fsm.sale.lost.reason</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="lost_reason_id" invisible="not lost_reason_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
