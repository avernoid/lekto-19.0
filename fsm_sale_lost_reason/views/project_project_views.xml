<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_inherit_fsm_sale_lost_reason" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.fsm.sale.lost.reason</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="industry_fsm_sale.project_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allow_material']/.." position="inside">
                <div class="col-lg-12 mt8">
                    <field name="use_lost_reason" invisible="not allow_material"/>
                    <span invisible="not allow_material" class="text-muted">
                        Force complete lost reason
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
