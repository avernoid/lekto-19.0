#. module: l10n_pe_localization_menu
#: model:ir.model,name:l10n_pe_localization_menu.model_account_spot_detraction
msgid "SPOT Detraction"
msgstr "Detracción SPOT"

#. module: l10n_pe_localization_menu
#: model:ir.model,name:l10n_pe_localization_menu.model_account_spot_retention
msgid "SPOT Retention"
msgstr "Retención SPOT"

#. module: l10n_pe_localization_menu
#: model:ir.model,name:l10n_pe_localization_menu.model_code_aduana
msgid "Customs Unit Code (Customs)"
msgstr "Código de Dependencia Aduanera"

#. module: l10n_pe_localization_menu
#: model:ir.model.fields,field_description:l10n_pe_localization_menu.field_account_spot_detraction__name
#: model:ir.model.fields,field_description:l10n_pe_localization_menu.field_account_spot_retention__name
msgid "Name"
msgstr "Nombre"

#. module: l10n_pe_localization_menu
#: model:ir.model.fields,help:l10n_pe_localization_menu.field_account_spot_detraction__name
msgid "Name or description of the SPOT detraction type. This identifies the specific classification for detraction purposes."
msgstr "Nombre o descripción del tipo de detracción SPOT. Esto identifica la clasificación específica para fines de detracción."

#. module: l10n_pe_localization_menu
#: model:ir.model.fields,help:l10n_pe_localization_menu.field_account_spot_retention__name
msgid "Name or description of the SPOT retention type. This identifies the specific classification for retention purposes."
msgstr "Nombre o descripción del tipo de retención SPOT. Esto identifica la clasificación específica para fines de retención."

#. module: l10n_pe_localization_menu
#: model:ir.model.fields,field_description:l10n_pe_localization_menu.field_code_aduana__name
msgid "Description"
msgstr "Descripción"

#. module: l10n_pe_localization_menu
#: model:ir.model.fields,help:l10n_pe_localization_menu.field_code_aduana__name
msgid "Descriptive name of the Customs Unit. This helps identify the specific customs location or entity."
msgstr "Nombre descriptivo de la Dependencia Aduanera. Esto ayuda a identificar la ubicación o entidad aduanera específica."

#. module: l10n_pe_localization_menu
#: model:ir.model.fields,field_description:l10n_pe_localization_menu.field_code_aduana__code
msgid "Code"
msgstr "Código"

#. module: l10n_pe_localization_menu
#: model:ir.model.fields,help:l10n_pe_localization_menu.field_code_aduana__code
msgid "Unique code identifier for the Customs Unit (e.g., 001, 118). Use the official code assigned by the customs authority."
msgstr "Código identificador único para la Dependencia Aduanera (ej. 001, 118). Use el código oficial asignado por la autoridad aduanera."
