#: code:addons/stock_landed_cost_variance/models/stock_value_variance.py:0
#, python-format
msgid "%(categ)s - value variance (%(origin)s)"
msgstr "%(categ)s - varianza de valor (%(origin)s)"

#. module: stock_landed_cost_variance
#. odoo-python
#: code:addons/stock_landed_cost_variance/models/product_category.py:0
#, python-format
msgid ""
"Account %(acc)s is used as a stock variation/expense account, so the periodic "
"closing nets its balance out and would cancel the reclassification. Use a "
"dedicated cost of sales account."
msgstr ""
"La cuenta %(acc)s se usa como cuenta de variación/gasto de existencias, así "
"que el cierre periódico compensa su saldo y anularía la reclasificación. Use "
"una cuenta de costo de ventas dedicada."

#. module: stock_landed_cost_variance
