<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_value_variance_view_list" model="ir.ui.view">
        <field name="name">stock.value.variance.list</field>
        <field name="model">stock.value.variance</field>
        <field name="arch" type="xml">
            <list string="Value Variances" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="product_id"/>
                <field name="move_id"/>
                <field name="kind"/>
                <field name="revaluation_id"/>
                <field name="ledger_amount" sum="Ledger Effect"/>
                <field name="absorbed" optional="show"/>
                <field name="variance_move_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="stock_value_variance_action" model="ir.actions.act_window">
        <field name="name">Value Variances</field>
        <field name="res_model">stock.value.variance</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
