<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_category_view_form_variance" model="ir.ui.view">
        <field name="name">product.category.form.variance</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Value Variance Accounts" groups="account.group_account_manager">
                    <field name="variance_valuation_account_id"/>
                    <field name="variance_variation_account_id"/>
                    <field name="variance_cogs_account_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
