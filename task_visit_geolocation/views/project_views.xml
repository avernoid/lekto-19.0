<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="project_project_view_form_inherit_geolocation" model="ir.ui.view">
            <field name="name">project.project.form.geolocation.settings</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">

                <xpath expr="//sheet/notebook" position="inside">
                    <page string="Geolocalización">
                        <group>
                            <field name="register_geo_visit"/>
                            <field name="max_distance_m"/>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>

        <record id="project_task_view_form_inherit_geolocation" model="ir.ui.view">
            <field name="name">project.task.form.geolocation</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">

                <xpath expr="//sheet//group" position="after">
                    <group string="Última ubicación registrada" 
                           invisible="not register_geo_visit">
                        <field name="register_geo_visit" invisible="1"/>
                        <field name="last_latitude" readonly="1"/>
                        <field name="last_longitude" readonly="1"/>
                    </group>
                </xpath>

                <xpath expr="//header" position="inside">
                    <field name="register_geo_visit" invisible="1"/>
                    <button name="action_register_visit"
                            type="object"
                            string="Registrar visita"
                            class="btn-primary"
                            invisible="not register_geo_visit"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
