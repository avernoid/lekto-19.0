<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- [V19 Migration] Verified compatibility of list views and widgets. -->

    <record id="wizard_report_financial_currency_view_form" model="ir.ui.view">
        <field name="name">wizard.report.financial.currency.view.form</field>
        <field name="model">wizard.report.financial.currency</field>
        <field name="arch" type="xml">
            <form string="Unrealized Gain/Loss Analysis">
                <group>
                    <group>
                        <field name="date_start"/>
                        <field name="xls_filename" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_end"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert" style="margin-bottom: 20px;">
                     <p><b>Note:</b> Only accounts with a <b>Foreign Currency</b> set (different from the Company Currency) will appear in this list.</p>
                     <p>Please enter the <b>Closing Exchange Rate</b> for each account to calculate the unrealized gain/loss.</p>
                </div>
                <field name="account_ids"
                       domain="[('currency_id', '!=', False),('currency_id', '!=', currency_id)]">
                    <list editable="bottom" create="1" delete="1" multi_edit="1">
                        <field name="code" readonly="True"/>
                        <field name="name" readonly="True"/>
                        <field name="account_type" widget="account_type_selection" readonly="True"/>
                        <field name="group_id" optional="hide" readonly="True"/>
                        <field name="internal_group" readonly="True" column_invisible="True"/>
                        <field name="reconcile" widget="boolean_toggle" readonly="1" optional="hide"
                               invisible="account_type in ('asset_cash', 'liability_credit_card', 'off_balance')"/>
                        <field name="tax_ids" optional="hide" widget="many2many_tags" readonly="True"/>
                        <field name="tag_ids" optional="hide" widget="many2many_tags" readonly="True"/>

                        <field name="currency_id" options="{'no_create': True}" groups="base.group_multi_currency"
                               readonly="True" optional="show"/>
                        <field name="adjustment_rate" readonly="False"/>
                    </list>
                </field>
                <div class="text-muted" style="margin-top: 10px; margin-bottom: 20px; font-style: italic;">
                    <p><i class="fa fa-info-circle" title="Info"></i> <b>Workflow Guide:</b></p>
                    <ol>
                        <li>Click <b>Generate Excel Preview</b> to calculate adjustments for selected accounts.</li>
                        <li>Download and review the Excel file to verify the proposed entries.</li>
                        <li>If correct, come back and click <b>Generate Adjustment Entry</b> to post it to the General Ledger.</li>
                    </ol>
                </div>
                <footer>
                    <button string="Generate Excel Preview" name="action_generate_excel" type="object" default_focus="1"
                            class="oe_highlight"/>
                    <field name="xls_binary" filename="xls_filename" readonly="1" invisible="not xls_filename"/>
                    or
                    <button string="Cancel" class="oe_link" special="cancel"/>
                    <button string="Generate Adjustment Entry" name="generate_thing" type="object" class="oe_highlight"
                            invisible="not xls_binary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_report_financial_currency" model="ir.actions.act_window">
        <field name="name">Currency Exchange Difference</field>
        <field name="res_model">wizard.report.financial.currency</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
            id="change_diference"
            name="Unrealized Gains/Losses"
            action="action_wizard_report_financial_currency"
            parent="account.account_reports_management_menu"
            sequence="5"
    />

</odoo>
