# ── Field help texts ─────────────────────────────────────────────────────
#. module: partner_industry_sector
#: model:ir.model.fields,help:partner_industry_sector.field_industry_sector__name
msgid "Unique sector name, shown when classifying contacts and when grouping or filtering them by sector."
msgstr "Nombre único del sector, que se muestra al clasificar contactos y al agruparlos o filtrarlos por sector."

#. module: partner_industry_sector
#: model:ir.model.fields,help:partner_industry_sector.field_industry_sector__active
msgid "Uncheck to archive: kept on existing contacts but no longer selectable on new ones."
msgstr "Desmarque para archivar: se mantiene en los contactos existentes pero ya no podrá seleccionarse en los nuevos."

#. module: partner_industry_sector
#: model:ir.model.fields,help:partner_industry_sector.field_res_partner__industry_sector_id
msgid "Sector this customer belongs to. Lets you filter and group contacts by industry. Shown for customers only."
msgstr "Sector al que pertenece este cliente. Permite filtrar y agrupar contactos por industria. Solo se muestra para clientes."

# ── Constraint ───────────────────────────────────────────────────────────
#. module: partner_industry_sector
#: model:ir.model.constraint,message:partner_industry_sector.constraint_industry_sector_name_uniq
msgid "The sector name must be unique."
msgstr "El nombre del sector debe ser único."

