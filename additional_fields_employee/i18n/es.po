# ===== Helps =====

#. module: additional_fields_employee
#: model:ir.model.fields,help:additional_fields_employee.field_hr_employee__academic_degree_id
msgid "Educational level of the employee according to SUNAT classification. Used in official payroll reports (T-Registro, PLAME)."
msgstr "Nivel educativo del empleado acorde a la clasificación de SUNAT. Usado en reportes oficiales de nómina (T-Registro, PLAME)."

#. module: additional_fields_employee
#: model:ir.model.fields,help:additional_fields_employee.field_hr_employee__health_regime_id
msgid "Health coverage type assigned to the employee (e.g., EsSalud, EPS). Determines health contribution calculations in payroll."
msgstr "Cobertura de salud asignada al empleado (ej., EsSalud, EPS). Determina el cálculo de aportaciones a salud en nómina."

#. module: additional_fields_employee
#: model:ir.model.fields,help:additional_fields_employee.field_hr_employee__labor_regime_id
msgid "Employment regime under which the employee works (e.g., General Private Regime, MYPE, Public Sector). Required for SUNAT T-Registro declarations."
msgstr "Régimen laboral bajo el cual labora el empleado (ej., Régimen General Privado, MYPE, Sector Público). Requerido para T-Registro."

#. module: additional_fields_employee
#: model:ir.model.fields,help:additional_fields_employee.field_hr_employee__labor_condition_id
msgid "Type of employment contract (e.g., Indefinite, Fixed-term, Part-time). Used in payroll calculations and SUNAT reporting."
msgstr "Tipo de contrato laboral (ej., Indefinido, Plazo fijo, Tiempo parcial). Usado en cálculos de planillas y reportes a SUNAT."

#. module: additional_fields_employee
#: model:ir.model.fields,help:additional_fields_employee.field_hr_employee__maximum_working_day
msgid "Enable if the employee works the maximum legal working hours (48 hours/week in Peru). Affects overtime calculation rules."
msgstr "Activar si el empleado labora la jornada máxima legal (48 horas semanales). Afecta al cálculo de horas extras."

#. module: additional_fields_employee
#: model:ir.model.fields,help:additional_fields_employee.field_hr_employee__atypical_cumulative_day
msgid "Enable if the employee has an atypical or cumulative work schedule (e.g., mining shifts, 14x7 rotations). Affects rest day calculations."
msgstr "Habilitar si el trabajador tiene jornada atípica o acumulativa (rotativas, mineras). Afecta a cálculos de días de descanso."

#. module: additional_fields_employee
#: model:ir.model.fields,help:additional_fields_employee.field_hr_employee__nocturnal_schedule
msgid "Enable if the employee works night shifts (between 10:00 PM and 6:00 AM). Triggers the 35% nocturnal surcharge in payroll calculations."
msgstr "Habilitar si trabajador tiene horario nocturno (22:00 a 06:00). Activa la sobretasa del 35%."

#. module: additional_fields_employee
#: model:ir.model.fields,help:additional_fields_employee.field_hr_employee__unionized
msgid "Enable if the employee is a member of a labor union. May affect specific payroll deductions and benefits."
msgstr "Habilitar si el empleado pertenece a un sindicato laboral. Genera cálculos de deducciones especiales."

#. module: additional_fields_employee
#: model:ir.model.fields,help:additional_fields_employee.field_hr_employee__is_practitioner
msgid "Enable if the employee is an intern or trainee (practicante). Practitioners have different contribution rules and minimum wage thresholds."
msgstr "Indicar si es practicante. El esquema varía respecto a contribución y RMV (Remuneración Mínima Vital)."

#. module: additional_fields_employee
#: model:ir.model.fields,help:additional_fields_employee.field_hr_employee__work_occupation_id
msgid "Job category classification (Executive, Employee, Worker). Used for SUNAT reporting and CTS calculation rules."
msgstr "Categoría ocupacional (Ejecutivo, Empleado, Obrero). Se utiliza en T-Registro y en cálculos como la CTS."

#. module: additional_fields_employee
#: model:ir.model.fields,help:additional_fields_employee.field_academic_degree__code
#: model:ir.model.fields,help:additional_fields_employee.field_employee_regime__code
#: model:ir.model.fields,help:additional_fields_employee.field_health_regime__code
#: model:ir.model.fields,help:additional_fields_employee.field_type_contract__code
#: model:ir.model.fields,help:additional_fields_employee.field_work_occupation__code
msgid "Official SUNAT code for this record. Used in electronic declarations (T-Registro, PLAME)."
msgstr "Código oficial SUNAT para este registro. Usado en declaraciones de planilla electrónica (T-Registro, PLAME)."

#. module: additional_fields_employee
#: model:ir.model.fields,help:additional_fields_employee.field_employee_regime__is_mype
msgid "Enable if this regime corresponds to a Micro or Small Enterprise (MYPE). MYPE regimes have reduced labor benefits and contribution rates."
msgstr "Activar si el régimen es para Micro o Pequeña Empresa (MYPE), aplicando beneficios reducidos."
