<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_partner_form_inherit_current_location" model="ir.ui.view">
            <field name="name">res.partner.form.current.location</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base_geolocalize.view_crm_partner_geo_form"/>
            <field name="arch" type="xml">
                
                <!-- Agregar botón dentro del div geo_localize_button -->
                <xpath expr="//div[@name='geo_localize_button']" position="inside">
                    <button name="action_get_current_location"
                            type="object"
                            string="Current Location"
                            icon="fa-location-arrow"
                            class="btn btn-link p-0"
                            help="Get coordinates from device's current location"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>