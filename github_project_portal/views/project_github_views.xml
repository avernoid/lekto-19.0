<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.rule" id="access_res_partner_user_portal_read">
        <field name="name">Read-only access for the res_partner model</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="portal_new_github" model="ir.ui.view">
        <field name="name">project.task.portal.new.github.view</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="is_github_project"/>
                <label for="repository_id" invisible="not is_github_project"/>
                <div class="o_row" invisible="not is_github_project">
                    <field name="repository_id" options="{'no_create': 1, 'no_edit': 1, 'no_open': 1}"/>
                    <button name="action_sync_repositories" type="object" icon="fa-refresh" title="Sync Repositories" class="btn btn-link"/>
                </div>
                <field name="organization_id" options="{'no_create': 1, 'no_edit': 1, 'no_open': 1}" invisible="1"/>
                <field name="repository_branch_id" options="{'no_create': 1, 'no_edit': 1, 'no_open': 1}" invisible="not is_github_project"/>
                <field name="module_id" options="{'no_edit': 1, 'no_open': 1}" invisible="is_github_project == False"/>
                <field name="github_branch_name" force_save="1" readonly="1" invisible="not is_github_project"/>
                <field name="release_candidate_name" force_save="1" readonly="1" invisible="not is_github_project"/>
                <field name="release_name" force_save="1" readonly="1" invisible="not is_github_project"/>
                <field name="task_steps" force_save="1" readonly="1" invisible="not is_github_project"/>
                <field name="pr_dev_id" force_save="1" readonly="1" invisible="not is_github_project"/>
                <field name="pr_prod_id" force_save="1" readonly="1" invisible="not is_github_project"/>
            </xpath>
        </field>
    </record>

    <record id="portal_new_github_steps" model="ir.ui.view">
        <field name="name">project.steps.new.github.view</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence']" position="after">
                <field name="by_steps" />
            </xpath>
        </field>
    </record>
    
</odoo>