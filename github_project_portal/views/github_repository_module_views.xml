<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="github_repository_module_form_view" model="ir.ui.view">
        <field name="name">github.repository.module.form.view</field>
        <field name="model">github.repository.module</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="repository_id"/>
                    <field name="organization_serie_id"/>
                    <field name="url_repository"/>
                    <field name="repo_branch_id"/>
                </group>
            </form>
        </field>
    </record>

    <record id="github_repository_module_list_view" model="ir.ui.view">
        <field name="name">github.repository.module.list.view</field>
        <field name="model">github.repository.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="repository_id"/>
                <field name="repo_branch_id"/>
            </list>
        </field>
    </record>

    <record id="github_repository_module_search_view" model="ir.ui.view">
        <field name="name">github.repository.module.search.view</field>
        <field name="model">github.repository.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="repository_id"/>
                <field name="repo_branch_id"/>
            </search>
        </field>
    </record>

    <record id="github_repository_module_action" model="ir.actions.act_window">
        <field name="name">Repository modules</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">github.repository.module</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_github_repository_module"
              parent="github_connector_api.menu_github_repository_root"
              sequence="3"
              action="github_repository_module_action"
    />

</odoo>