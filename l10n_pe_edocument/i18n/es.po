#. module: l10n_pe_edocument
#: model:ir.model.fields,field_description:l10n_pe_edocument.field_account_move__payment_method_id
msgid "Payment Method"
msgstr "Medio de pago"

#. module: l10n_pe_edocument
#: model:ir.model.fields,help:l10n_pe_edocument.field_account_move__payment_method_id
msgid "Indicates the payment method used for this transaction, required for electronic invoicing."
msgstr "Indica el medio de pago usado para esta transacción, requerido para facturación electrónica."

#. module: l10n_pe_edocument
#: model:ir.model.fields,field_description:l10n_pe_edocument.field_account_move__related_tax_documents_code
msgid "Related Tax Document Code"
msgstr "Código de documentos relacionados tributarios"

#. module: l10n_pe_edocument
#: model:ir.model.fields,help:l10n_pe_edocument.field_account_move__related_tax_documents_code
msgid "Code of the related tax document, used for specific SUNAT operations like debit notes or rectifications."
msgstr "Código del documento relacionado tributario, usado para operaciones específicas de SUNAT como notas de débito o rectificaciones."

#. module: l10n_pe_edocument
#: model:ir.model.fields.selection,name:l10n_pe_edocument.selection__account_move__l10n_pe_edi_refund_reason__13
#: model:ir.model.fields.selection,name:l10n_pe_edocument.selection__account_move_reversal__l10n_pe_edi_refund_reason__13
msgid "Correction of the net amount pending payment and/or due dates"
msgstr "Corrección del monto neto pendiente de pago y/o la(s) de vencimiento del pago único o de las cuotas y/o los montos correspondientes a cada cuota , de ser el caso"

#. module: l10n_pe_edocument
#: model:ir.model.fields,field_description:l10n_pe_edocument.field_account_invoice_correction__move_id
msgid "Journal Entry"
msgstr "Asiento contable"

#. module: l10n_pe_edocument
#: model:ir.model.fields,field_description:l10n_pe_edocument.field_account_invoice_correction__journal_id
msgid "Specific Journal"
msgstr "Diario específico"

#. module: l10n_pe_edocument
#: model:ir.model.fields,help:l10n_pe_edocument.field_account_invoice_correction__journal_id
msgid "If empty, it uses the journal of the journal entry to make the charge."
msgstr "Si está vacío, utiliza el diario del asiento contable para hacer el cargo."

#. module: l10n_pe_edocument
#: code:addons/l10n_pe_edocument/wizards/account_invoice_correction.py:0
#, python-format
msgid "This correction invoice was created from:"
msgstr "Esta factura de corrección fue creada a partir de:"

#. module: l10n_pe_edocument
#: code:addons/l10n_pe_edocument/wizards/account_invoice_correction.py:0
#, python-format
msgid "Correction Invoice"
msgstr "Factura de corrección"

#. module: l10n_pe_edocument
#: code:addons/l10n_pe_edocument/wizards/account_move_reversal.py:0
#, python-format
msgid "Reversal of: %s"
msgstr "Reversión de: %s"

#. module: l10n_pe_edocument
#: model:ir.actions.act_window,name:l10n_pe_edocument.action_view_account_invoice_correction
#: model:ir.ui.view,arch_db:l10n_pe_edocument.view_account_invoice_correction
msgid "Add Correction Invoice"
msgstr "Agregar factura de corrección"

#. module: l10n_pe_edocument
#: model:ir.ui.view,arch_db:l10n_pe_edocument.view_account_invoice_correction
msgid "The correction invoice is created in draft and can be edited before being issued."
msgstr "La factura de corrección se crea en borrador y puede ser editada antes de expedirse."

#. module: l10n_pe_edocument
#: model:ir.ui.view,arch_db:l10n_pe_edocument.view_account_invoice_correction
