<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_inherit_fsm_sale_start_required" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.fsm.sale.start.required</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="industry_fsm_sale.project_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allow_material']/.." position="inside">
                <div class="col-lg-12" invisible="not allow_material">
                    <field name="require_start_to_sell"/>
                    <span class="text-muted">Require start before selling</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
