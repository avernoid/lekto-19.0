<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_portal_app_tree" model="ir.ui.view">
        <field name="name">portal.app.list</field>
        <field name="model">portal.app</field>
        <field name="arch" type="xml">
            <list string="Portal Apps">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="action_url"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_portal_app_form" model="ir.ui.view">
        <field name="name">portal.app.form</field>
        <field name="model">portal.app</field>
        <field name="arch" type="xml">
            <form string="Portal App">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Photo Evidence"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="action_url"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                        <group string="PWA Configuration">
                            <field name="pwa_name"/>
                            <field name="technical_name"/>
                            <field name="color_scheme" widget="selection" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_portal_app" model="ir.actions.act_window">
        <field name="name">Portal Apps</field>
        <field name="res_model">portal.app</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <!-- Top Level Menu -->
    <menuitem id="menu_portal_app_root"
              name="App Launcher"
              web_icon="portal_app_launcher,static/description/icon.png"
              groups="group_portal_app_manager"
              sequence="50"/>

    <!-- Config Menu -->
    <menuitem id="menu_portal_app_config"
              name="Apps Configuration"
              parent="menu_portal_app_root"
              action="action_portal_app"
              groups="group_portal_app_manager"
              sequence="10"/>
</odoo>
