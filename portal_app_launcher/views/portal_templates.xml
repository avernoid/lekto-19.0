<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_app_launcher_home" name="App Launcher">
        <t t-call="portal_app_launcher.portal_app_layout">
            <div class="container py-5 text-center">
                <h3 class="mb-4 text-white">Welcome, <t t-esc="user.name"/></h3>

                <!-- PWA Install Button (Hidden by default) -->
                <!-- PWA Install Button (Always Visible) -->
                <!-- PWA Install Button (Always Visible by default, hidden by JS if installed) -->
                <button id="pwaInstallBtn" class="btn btn-light rounded-pill mb-4 shadow-sm fw-bold px-4">
                    <i class="fa fa-download me-2"/> Install App
                </button>
                <div id="pwaInstalledMsg" class="mb-4 text-white small" style="display: none;">
                    <i class="fa fa-check-circle me-1"/> App Installed
                </div>

                
                <div class="row justify-content-center">
                    <t t-foreach="apps" t-as="app">
                        <div class="col-6 col-md-4 col-lg-3 mb-4">
                            <a t-att-href="app.action_url" class="text-decoration-none">
                                <div class="card shadow-sm border-0 h-100 app-card">
                                    <div class="card-body text-center d-flex flex-column align-items-center justify-content-center">
                                        <div class="app-icon mb-3">
                                            <img t-if="app.image" t-att-src="image_data_uri(app.image)" class="img-fluid" style="max-height: 80px;"/>
                                            <i t-else="" class="fa fa-cube fa-3x text-primary"></i>
                                        </div>
                                        <h5 class="card-title text-dark mb-0"><t t-esc="app.name"/></h5>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>

                <!-- Bottom Logout (Ergonomic) -->
                <div class="mt-5 mb-4">
                     <a href="/web/session/logout?redirect=/" class="btn btn-outline-light rounded-pill px-4">
                        <i class="fa fa-power-off me-2"/> Log Out
                    </a>
                </div>
            </div>
        </t>
    </template>

    <!-- Minimal Layout for Apps -->
    <template id="portal_app_layout" name="Portal App Layout">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="active_app" t-value="request.env['portal.app'].sudo().search([]).filtered(lambda a: request.httprequest.path.startswith(a.action_url))[:1]"/>
            <t t-set="title" t-value="title or 'In-House App'"/>
            <t t-set="manifest_url" t-value="manifest_url or '/portal_app/manifest.webmanifest'"/>
            <t t-set="theme_color" t-value="active_app.theme_color if active_app else '#667eea'"/>
            <t t-set="pwa_name" t-value="active_app.pwa_name or active_app.name if active_app else 'Portal App'"/>
            <t t-set="app_bg" t-value="active_app.app_background_color or '#f0f4f7'"/>
            <t t-set="app_text" t-value="active_app.app_text_color or '#212529'"/>
            <t t-set="app_card_bg" t-value="'#1e1e1e' if active_app and active_app.color_scheme == 'dark' else '#ffffff'"/>
            <t t-set="app_card_text" t-value="'#ffffff' if active_app and active_app.color_scheme == 'dark' else '#212529'"/>
            <t t-set="color_scheme" t-value="active_app.color_scheme if active_app else 'light'"/>
            <t t-set="website_id" t-value="website.id if website else None"/>
            <t t-set="lang_direction" t-value="lang_direction"/>
            <t t-set="apple_touch_icon" t-value="'/web/binary/company_logo'"/>
            
            <t t-set="btn_text_color" t-value="'#212529' if color_scheme == 'light' else '#fff'"/>
            
            <t t-set="head">
                <meta name="theme-color" t-att-content="theme_color"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
                <meta name="apple-mobile-web-app-title" t-att-content="pwa_name"/>
                <link rel="manifest" t-att-href="manifest_url"/>
                <link rel="apple-touch-icon" t-att-href="apple_touch_icon"/>
                
                <style>
                    :root {
                        --app-theme-color: <t t-esc="theme_color"/>;
                        --app-bg: <t t-esc="app_bg"/>;
                        --app-text: <t t-esc="app_text"/>;
                        --app-card-bg: <t t-esc="app_card_bg"/>;
                        --app-card-text: <t t-esc="app_card_text"/>;
                        --btn-text-color: <t t-esc="btn_text_color"/>;
                    }
                    /* SCOPED STYLES: Target #portal_app_scope or .portal_app_body */
                    
                    .portal_app_body {
                        background-color: var(--app-bg) !important;
                        color: var(--app-text) !important;
                    }
                    .portal_app_body .text-white, 
                    .portal_app_body .text-dark,
                    .portal_app_body h1, .portal_app_body h2, .portal_app_body h3, 
                    .portal_app_body h4, .portal_app_body h5, .portal_app_body h6 {
                        color: var(--app-text) !important;
                    }
                    .portal_app_body .card {
                        background-color: var(--app-card-bg) !important;
                        color: var(--app-card-text) !important;
                    }
                    .portal_app_body .card h1, .portal_app_body .card h2, 
                    .portal_app_body .card h3, .portal_app_body .card h4, 
                    .portal_app_body .card h5, .portal_app_body .card h6,
                    .portal_app_body .card .text-dark, .portal_app_body .card .text-white {
                        color: var(--app-card-text) !important;
                    }

                    /* Theme Utilities */
                    .app-text-primary { color: var(--app-theme-color) !important; }
                    .app-bg-primary { background-color: var(--app-theme-color) !important; }
                    .app-border-primary { border-color: var(--app-theme-color) !important; }
                    
                    /* Custom Button Primary that respects theme */
                    .btn-app-primary {
                        background-color: var(--app-theme-color);
                        border-color: var(--app-theme-color);
                        color: var(--btn-text-color) !important; 
                    }
                    .btn-app-primary:hover {
                         opacity: 0.9;
                         color: var(--btn-text-color) !important; 
                    }
                    
                    .btn-outline-app-primary {
                        color: var(--app-theme-color);
                        border-color: var(--app-theme-color);
                        background-color: transparent;
                    }
                    .btn-outline-app-primary:hover {
                        background-color: var(--app-theme-color);
                        color: var(--btn-text-color) !important;
                    }

                    /* ============================================================
                       FIX: Light Theme High Contrast Overrides (Scoped and Enforced)
                       ============================================================ */

                    /* 1. Force Text Elements (Headers, Icons using app-text-primary) to be DARK in Light Theme */
                    .portal_app_body.theme-light .app-text-primary {
                        color: #212529 !important;
                    }

                    /* 2. Forces text-white elements to be dark when using Light theme (e.g. Deliveries Header) */
                    .portal_app_body.theme-light .text-white,
                    .portal_app_body.theme-light .app-bg-primary.text-white,
                    .portal_app_body.theme-light .delivery-top-bar.text-white,
                    .portal_app_body.theme-light h4.text-white {
                        color: #212529 !important;
                    }
                    
                    /* 3. Ensure headers in Light theme have a bottom border if they are white */
                    .portal_app_body.theme-light .app-bg-primary,
                    .portal_app_body.theme-light .delivery-top-bar {
                        border-bottom: 1px solid #dee2e6;
                    }
                    
                    /* 4. Ensure Primary Buttons (Upload, etc) have a visible border and dark text/icon in Light Theme */
                    .portal_app_body.theme-light .btn-app-primary {
                         border: 1px solid #ced4da !important;
                         background-color: #ffffff !important;
                         color: #212529 !important;
                    }
                    .portal_app_body.theme-light .btn-app-primary i,
                    .portal_app_body.theme-light .btn-app-primary span {
                         color: #212529 !important;
                    }
                    
                    /* 5. Fix Outline Buttons in Light Theme (View Details) */
                    .portal_app_body.theme-light .btn-outline-app-primary {
                        color: #212529 !important;
                        border-color: #ced4da !important;
                        background-color: #ffffff !important;
                    }
                    .portal_app_body.theme-light .btn-outline-app-primary:hover {
                         background-color: #e9ecef !important;
                    }

                    /* 6. Fix Opacity elements inside forced dark containers (e.g. delivery count) */
                    /* Targeted specifically to override the .text-white containment */
                    .portal_app_body.theme-light .text-white .opacity-75,
                    .portal_app_body.theme-light .app-bg-primary .opacity-75,
                    .portal_app_body.theme-light .delivery-top-bar .opacity-75 {
                        color: rgba(33, 37, 41, 0.75) !important;
                        opacity: 1 !important;
                    }
                    
                    /* 7. Extra: Fix Badges in Light Theme */
                    .portal_app_body.theme-light .badge.text-white,
                    .portal_app_body.theme-light .badge.app-text-primary {
                        color: #212529 !important;
                        border: 1px solid #dee2e6;
                    }

                    @media all and (display-mode: standalone) {
                        .pwa-only-hidden {
                            display: none !important;
                        }
                    }
                </style>
                <!-- Inherit extra_head if defined elsewhere -->
                <t t-out="extra_head or ''"/>
            </t>

            <t t-set="body_class" t-value="'portal_app_body theme-' + color_scheme"/>
            
            <!-- Wrapper to guarantee class application -->
            <div id="portal_app_scope" t-att-class="'portal_app_body theme-' + color_scheme" style="min-height: 100vh;">
                <t t-out="0"/>
            </div>
            
            <!-- Force Body Class via JS as backup for Modals/Fixed elements stuck on Body -->
            <script>
                document.body.classList.add('portal_app_body', 'theme-<t t-esc="color_scheme"/>');
            </script>
            <main class="d-none"> <!-- Deprecated --> </main>

            <script>
                if ('serviceWorker' in navigator) {
                    window.addEventListener('load', function() {
                        navigator.serviceWorker.register('/service-worker.js').then(function(registration) {
                            console.log('ServiceWorker registration successful');
                        }, function(err) {
                            console.log('ServiceWorker registration failed: ', err);
                        });
                    });
                }
                let deferredPrompt;
                window.addEventListener('beforeinstallprompt', (e) => {
                    e.preventDefault();
                    deferredPrompt = e;
                    console.log("PWA: beforeinstallprompt captured");
                });
                document.addEventListener('click', (e) => {
                    const btn = e.target.closest('#pwaInstallBtn');
                    if (btn) {
                        console.log("PWA: Install button clicked");
                        const installedMsg = document.getElementById('pwaInstalledMsg');
                        if(deferredPrompt) {
                            deferredPrompt.prompt();
                            deferredPrompt.userChoice.then((choiceResult) => {
                                if (choiceResult.outcome === 'accepted') {
                                    console.log('User accepted the A2HS prompt');
                                    if(installedMsg) installedMsg.style.display = 'block';
                                    btn.style.display = 'none';
                                } else {
                                    console.log('User dismissed the A2HS prompt');
                                }
                                deferredPrompt = null;
                            });
                        } else {
                            alert('To install this app:\n\n1. Tap the Share/Menu button (three dots).\n2. Select "Add to Home Screen" or "Install App".');
                        }
                    }
                });
                if (window.matchMedia('(display-mode: standalone)').matches) {
                    const installBtn = document.getElementById('pwaInstallBtn');
                    const installedMsg = document.getElementById('pwaInstalledMsg');
                    if(installBtn) installBtn.style.display = 'none';
                    if(installedMsg) installedMsg.style.display = 'block';
                }
            </script>
            <t t-set="extra_footer" t-value="extra_footer or ''"/>
        </t>
    </template>
</odoo>
