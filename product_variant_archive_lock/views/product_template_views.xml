<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_archive_lock" model="ir.ui.view">
        <field name="name">product.template.form.variant.archive.lock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Place the lock inside the "Attributes & Variants" page, below the
                 values list, mirroring the native "Sales Variant Selection" group.
                 The page is already restricted to product.group_product_variant. -->
            <xpath expr="//page[@name='variants']" position="inside">
                <group name="variant_archive_lock_group" invisible="not attribute_line_ids">
                    <group string="Manual Variant Archiving">
                        <field name="variant_archive_lock"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
