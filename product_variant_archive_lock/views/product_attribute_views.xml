<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_attribute_value_view_tree_hide_matrix" model="ir.ui.view">
        <field name="name">product.template.attribute.value.list.hide.matrix</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree"/>
        <field name="arch" type="xml">
            <field name="ptav_active" position="after">
                <field name="hide_from_matrix" optional="show"/>
            </field>
        </field>
    </record>

    <record id="product_template_attribute_value_view_form_hide_matrix" model="ir.ui.view">
        <field name="name">product.template.attribute.value.form.hide.matrix</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">
            <field name="price_extra" position="after">
                <field name="hide_from_matrix"/>
            </field>
        </field>
    </record>

</odoo>
