<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_form_view_inherit_first_and_last_name" model="ir.ui.view">
        <field name="name">res.partner.form.view.inherit.first_and_last_name</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']/parent::h1" position="after">
                <div class="d-flex align-items-center gap-2 mb-1" invisible="is_company">
                    <i class="fa fa-fw me-1 fa-id-card-o text-primary" title="Name Details"/>
                    <field name="partner_name" placeholder="First Names" nolabel="1"/>
                    <field name="first_name" placeholder="Paternal Surname" nolabel="1"/>
                    <field name="second_name" placeholder="Maternal Surname" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
