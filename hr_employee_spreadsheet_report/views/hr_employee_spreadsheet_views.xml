<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_spreadsheet_view_form" model="ir.ui.view">
        <field name="name">hr.employee.spreadsheet.view.form</field>
        <field name="model">hr.employee.spreadsheet</field>
        <field name="arch" type="xml">
            <form string="Employee Spreadsheet" class="o_spreadsheet_form">
                <field name="spreadsheet_binary_data" widget="spreadsheet" />
                <field name="spreadsheet_data" invisible="1" />
                <field name="spreadsheet_file_name" invisible="1" />
            </form>
        </field>
    </record>
</odoo>
