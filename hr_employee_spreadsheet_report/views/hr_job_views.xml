<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_job_form_inherit_spreadsheet" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.spreadsheet</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='job']" position="inside">
                <field name="spreadsheet_template_id"/>
            </xpath>
        </field>
    </record>
</odoo>
