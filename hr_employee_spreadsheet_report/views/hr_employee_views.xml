<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_spreadsheet" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.spreadsheet</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_spreadsheet_report" type="object" class="oe_stat_button" icon="fa-table">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="spreadsheet_count" widget="statinfo" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">Spreadsheet</span>
                    </div>
                </button>
            </div>
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="spreadsheet_template_id"/>
            </xpath>
        </field>
    </record>
</odoo>
