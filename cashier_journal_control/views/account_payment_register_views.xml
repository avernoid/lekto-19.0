<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_inherit_cashier" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.cashier</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="attributes">
                <attribute name="domain">
                    [('id', 'in', available_journal_ids), '|', ('allowed_user_ids', '=', False), ('allowed_user_ids', 'in', [uid])]
                </attribute>
            </field>
        </field>
    </record>
</odoo>
