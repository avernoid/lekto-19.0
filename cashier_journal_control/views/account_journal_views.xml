<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_inherit_cashier" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.cashier</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='bank_account']" position="after">
                <page string="Cashier Control" name="cashier_control">
                    <group>
                        <group string="Access Control">
                            <field name="allowed_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group string="Defaults">
                            <field name="is_default_cash"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
