#. module: payroll_field
#: model:ir.model.fields,field_description:payroll_field.field_hr_version__disability
#: model:ir.model.fields,field_description:payroll_field.field_hr_employee__disability
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_input__disability
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_line__disability
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_worked_days__disability
msgid "Disability"
msgstr "Discapacidad"

#. module: payroll_field
#: model:ir.model.fields,help:payroll_field.field_hr_version__disability
msgid "Indicates whether the employee has a registered disability. When enabled, this flag can be used in payroll rules for special deductions or benefits applicable to employees with disabilities."
msgstr "Indica si el empleado tiene una discapacidad registrada. Cuando está habilitado, esta marca se puede usar en reglas de nómina para deducciones especiales o beneficios aplicables a empleados con discapacidades."

#. module: payroll_field
#: model:ir.model.fields,help:payroll_field.field_hr_employee__disability
msgid "Inherited from the employee version. Indicates whether the employee has a registered disability status."
msgstr "Heredado de la versión del empleado. Indica si el empleado tiene un estado de discapacidad registrado."

#. module: payroll_field
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip__employee_category_ids
msgid "Employee Tags"
msgstr "Etiquetas de Empleado"

#. module: payroll_field
#: model:ir.model.fields,help:payroll_field.field_hr_payslip__employee_category_ids
msgid "Tags assigned to the employee. Useful for filtering and grouping payslips by employee classification or category."
msgstr "Etiquetas asignadas al empleado. Útil para filtrar y agrupar nóminas por clasificación o categoría de empleado."

#. module: payroll_field
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip__date_start
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_input__date_start
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_line__date_start
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_worked_days__date_start
msgid "Month/Year"
msgstr "Mes/Año"

#. module: payroll_field
#: model:ir.model.fields,help:payroll_field.field_hr_payslip__date_start
msgid "Text representation of the payroll month in MM/YYYY format. Computed automatically from the payslip date range."
msgstr "Representación en texto del mes de nómina en formato MM/AAAA. Calculado automáticamente a partir del rango de fechas de la nómina."

#. module: payroll_field
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip__date_start_dt
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_input__date_start_dt
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_line__date_start_dt
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_worked_days__date_start_dt
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_run__date_st_dt
msgid "Payroll Month"
msgstr "Mes de Nómina"

#. module: payroll_field
#: model:ir.model.fields,help:payroll_field.field_hr_payslip__date_start_dt
msgid "Date field indicating which month the payslip corresponds to. When the payslip spans two months, the month with the most days is selected. Used for grouping and analysis by payroll period."
msgstr "Campo de fecha que indica a qué mes corresponde la nómina. Cuando la nómina abarca dos meses, se selecciona el mes con más días. Utilizado para agrupación y análisis por período de nómina."

#. module: payroll_field
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip__month
msgid "Payroll Month Number"
msgstr "Número del Mes de Nómina"

#. module: payroll_field
#: model:ir.model.fields,help:payroll_field.field_hr_payslip__month
msgid "Two-digit month number (01-12) of the computed payroll month. Useful for sorting and filtering by month."
msgstr "Número de mes de dos dígitos (01-12) del mes de nómina calculado. Útil para ordenar y filtrar por mes."

#. module: payroll_field
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip__year
msgid "Payroll Year"
msgstr "Año de Nómina"

#. module: payroll_field
#: model:ir.model.fields,help:payroll_field.field_hr_payslip__year
msgid "Four-digit year of the computed payroll month. Useful for sorting and filtering by year."
msgstr "Año de cuatro dígitos del mes de nómina calculado. Útil para ordenar y filtrar por año."

#. module: payroll_field
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_input__date_from
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_worked_days__date_from
msgid "Date From"
msgstr "Desde"

#. module: payroll_field
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_input__date_to
#: model:ir.model.fields,field_description:payroll_field.field_hr_payslip_worked_days__date_to
msgid "Date To"
msgstr "Hasta"

