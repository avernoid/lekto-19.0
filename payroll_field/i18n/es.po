#. module: payroll_field
#: model:ir.model.fields,help:payroll_field.field_hr_payslip_run__date_st_dt
msgid "Computed payroll month for this batch. Determined from the batch date range using the same logic as individual payslips: the month with the most days in the range is selected."
msgstr "Mes de nómina calculado para este lote. Determinado a partir del rango de fechas del lote usando la misma lógica que las nóminas individuales: se selecciona el mes con más días en el rango."

#. module: payroll_field
#: model:ir.model.fields,help:payroll_field.field_hr_payslip_input__date_start
#: model:ir.model.fields,help:payroll_field.field_hr_payslip_line__date_start
#: model:ir.model.fields,help:payroll_field.field_hr_payslip_worked_days__date_start
msgid "Text representation (MM/YYYY) of the payroll month."
msgstr "Representación en texto (MM/AAAA) del mes de nómina."

#. module: payroll_field
#: model:ir.model.fields,help:payroll_field.field_hr_payslip_input__date_start_dt
#: model:ir.model.fields,help:payroll_field.field_hr_payslip_line__date_start_dt
#: model:ir.model.fields,help:payroll_field.field_hr_payslip_worked_days__date_start_dt
