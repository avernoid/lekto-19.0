<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Parent Report Categories -->
        <record id="report_category_incomes" model="hr.salary.rule.report.category">
            <field name="name">Ingresos</field>
            <field name="code">INCOMES</field>
            <field name="sequence">10</field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

        <record id="report_category_deductions" model="hr.salary.rule.report.category">
            <field name="name">Descuentos</field>
            <field name="code">DED</field>
            <field name="sequence">20</field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

        <record id="report_category_contributions" model="hr.salary.rule.report.category">
            <field name="name">Aportes</field>
            <field name="code">COMP</field>
            <field name="sequence">30</field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

        <record id="report_category_provisions" model="hr.salary.rule.report.category">
            <field name="name">Provisiones</field>
            <field name="code">PROV</field>
            <field name="sequence">40</field>
            <field name="appears_on_payslip" eval="True"/>
        </record>
    </data>
</odoo>
