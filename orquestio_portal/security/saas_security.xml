<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="saas_instance_portal_rule" model="ir.rule">
            <field name="name">Portal: own instances only</field>
            <field name="model_id" ref="saas_orchestrator.model_saas_instance"/>
            <field name="domain_force">[('tenant_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="saas_env_var_portal_rule" model="ir.rule">
            <field name="name">Portal: own env vars only</field>
            <field name="model_id" ref="saas_orchestrator.model_saas_instance_env_var"/>
            <field name="domain_force">[('instance_id.tenant_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
