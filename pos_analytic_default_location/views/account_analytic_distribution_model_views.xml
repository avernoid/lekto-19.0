<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_analytic_distribution_model_view_form" model="ir.ui.view">
        <field name="name">account.analytic.distribution.model.view.form.inherit.pos</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="inherit_id" ref="analytic.account_analytic_distribution_model_form_view"/>
        <field name="arch" type="xml">
            <field name="partner_category_id" position="after">
                <field name="pos_config_id"/>
            </field>
        </field>
    </record>

    <record id="account_analytic_distribution_model_view_tree" model="ir.ui.view">
        <field name="name">account.analytic.distribution.model.view.tree.inherit.pos</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="inherit_id" ref="analytic.account_analytic_distribution_model_tree_view"/>
        <field name="arch" type="xml">
            <field name="partner_category_id" position="after">
                <field name="pos_config_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
