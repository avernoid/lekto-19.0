<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_analytic_distribution_model_view_search_pos" model="ir.ui.view">
        <field name="name">account.analytic.distribution.model.view.search.inherit.pos</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="inherit_id" ref="account_analytic_default_location.account_analytic_distribution_model_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="pos_config_id"/>
                <filter string="Point of Sale" name="group_pos" context="{'group_by':'pos_config_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
