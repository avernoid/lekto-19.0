<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_lost_reason_wizard_view_form" model="ir.ui.view">
        <field name="name">sale.lost.reason.wizard.view.form</field>
        <field name="model">sale.lost.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Lost Reason">
                <group>
                    <field name="lost_reason_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_lost_reason_wizard" model="ir.actions.act_window">
        <field name="name">Select Lost Reason</field>
        <field name="res_model">sale.lost.reason.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
