#. module: l10n_pe_sire_sunat
#: model:ir.model.fields,field_description:l10n_pe_sire_sunat.field_account_move__l10n_pe_is_complement_sire
msgid "SIRE Complement"
msgstr "Complemento para SIRE"

#. module: l10n_pe_sire_sunat
#: model:ir.model.fields,help:l10n_pe_sire_sunat.field_account_move__l10n_pe_is_complement_sire
msgid "Enable this field if the invoice is a physical CPE (Comprobante de Pago Electrónico) that needs to be included in the SIRE complement TXT file. When activated, the record will be picked up by the complement report generator."
msgstr "Active este campo si la factura es un CPE (Comprobante de Pago Electrónico) físico que necesita ser incluido en el archivo TXT de complemento SIRE. Cuando se activa, el registro será recogido por el generador de reportes de complemento."

#. module: l10n_pe_sire_sunat
#: model:ir.model.fields,field_description:l10n_pe_sire_sunat.field_res_company__exceeds_1500_uit
msgid "Exceeds 1500 UIT"
msgstr "Supera 1500 UIT"

#. module: l10n_pe_sire_sunat
#: model:ir.model.fields,help:l10n_pe_sire_sunat.field_res_company__exceeds_1500_uit
msgid "Enable this if the company's annual income exceeds 1500 UIT (Unidades Impositivas Tributarias). This flag affects specific fields in the SIRE purchase reports as required by SUNAT regulations."
msgstr "Active esta opción si los ingresos anuales de la empresa superan las 1500 UIT (Unidades Impositivas Tributarias). Esta marca afecta campos específicos en los reportes de compras SIRE según lo requiere la normativa SUNAT."

