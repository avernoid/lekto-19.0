<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.personal_information</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='employees_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="generate_legal_name_setting">
                    <div class="o_setting_left_pane">
                        <field name="generate_legal_name"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="generate_legal_name"/>
                        <div class="text-muted">
                            If enabled, the Legal Name field is auto-filled using First Name + Paternal Lastname + Maternal Lastname.
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="generate_employee_name_setting">
                    <div class="o_setting_left_pane">
                        <field name="generate_employee_name"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="generate_employee_name"/>
                        <div class="text-muted">
                            If enabled, the Employee Name field is auto-filled using First Name + Paternal Lastname + Maternal Lastname.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
