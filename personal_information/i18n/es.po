#. module: personal_information
#: model:ir.model.fields,field_description:personal_information.field_res_company__generate_legal_name
msgid "Auto-generate Legal Name"
msgstr "Autogenerar Nombre Legal"


#. module: personal_information
msgid "If enabled, the \"Legal Name\" field of the employee will be automatically updated whenever \"First Name\", \"Paternal Lastname\" or \"Maternal Lastname\" are modified. The result is the concatenation: First Name + Paternal Lastname + Maternal Lastname."
msgstr "Si está activado, el campo \"Nombre Legal\" del empleado se actualizará automáticamente cada vez que se modifiquen \"Nombres\", \"Apellido Paterno\" o \"Apellido Materno\". El resultado es la concatenación: Nombres + Apellido Paterno + Apellido Materno."

#. module: personal_information
msgid "If enabled, the Legal Name field is auto-filled using First Name + Paternal Lastname + Maternal Lastname."
msgstr "Si está activado, el campo Nombre Legal se completa automáticamente con: Nombres + Apellido Paterno + Apellido Materno."

#. module: personal_information
#: model:ir.model.fields,field_description:personal_information.field_res_company__generate_employee_name
msgid "Auto-generate Employee Name"
msgstr "Autogenerar Nombre de Empleado"

#. module: personal_information
msgid "If enabled, the \"Name\" field of the employee will be automatically updated whenever \"First Name\", \"Paternal Lastname\" or \"Maternal Lastname\" are modified. The result is the concatenation: First Name + Paternal Lastname + Maternal Lastname."
msgstr "Si está activado, el campo \"Nombre\" del empleado se actualizará automáticamente cada vez que se modifiquen \"Nombres\", \"Apellido Paterno\" o \"Apellido Materno\". El resultado es la concatenación: Nombres + Apellido Paterno + Apellido Materno."

#. module: personal_information
msgid "If enabled, the Employee Name field is auto-filled using First Name + Paternal Lastname + Maternal Lastname."
msgstr "Si está activado, el campo Nombre del empleado se completa automáticamente con: Nombres + Apellido Paterno + Apellido Materno."

#. module: personal_information
msgid "This field is updated from the \"Relatives\" tab."
msgstr "Este campo se actualiza desde la pestaña \"Parientes\"."

