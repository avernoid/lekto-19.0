<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="base.group_no_one" model="res.groups">
        <field name="users" eval="[(4, ref('base.user_root'))]" />
    </record>
    <record id="group_github_connector_api_user" model="res.groups">
        <field name="name">Connector Github User</field>
        <field name="category_id" ref="module_category_github_connector_api" />
    </record>
    <record id="group_github_connector_api_manager" model="res.groups">
        <field name="name">Connector Github Manager</field>
        <field name="category_id" ref="module_category_github_connector_api" />
        <field
            name="users"
            eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"
        />
        <field
            name="implied_ids"
            eval="[(4, ref('github_connector_api.group_github_connector_api_user'))]"
        />
    </record>
</odoo>
