<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.github.connector</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="0" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
<!--            <widget name='res_config_dev_tool'/>-->
            <xpath expr="//form" position="inside">
                <app data-string="Github Connector" string="Github Connector" name="github_connector_api">
                    <block title="Github Integration" name="github_integration_setting_container">
                        <setting id="github_token" help="Synchronize Odoo with Github">
                            <field name="github_token" password="True"/>
                            <div class="content-group">
                                <div class="mt16">
                                    <a href="https://www.ganemo.co" title="Documentation" class="o_doc_link" target="_blank"> Check Documentation</a>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>


    <record id="action_github_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'github_connector_api'}</field>
    </record>
</odoo>