<?xml version="1.0" encoding="utf-8" ?>

<odoo>

    <record id="view_wizard_create_repository_form" model="ir.ui.view">
        <field name="model">wizard.create.repository</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="organization_id" options="{'no_create': True, 'no_edit': True, 'delete': False, 'no_open': True}"/>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="website"/>
                    <field name="template_repository_id" domain="[('is_github_repository_template','=', True)]"/>
                    <field name="teams_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button
                        name="button_create_in_github"
                        string="Create in Github"
                        type="object"
                        class="oe_highlight"
                    />
                    or
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
