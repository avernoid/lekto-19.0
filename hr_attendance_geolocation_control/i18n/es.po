#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_hr_job__accuracy_high_max
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_res_company__accuracy_high_max
msgid "Maximum margin of error (in meters) for a GPS signal to be considered 'High' reliability. Usually, 0-10m is ideal."
msgstr "Margen de error máximo (en metros) para que una señal GPS se considere de 'Alta' confiabilidad. Usualmente, 0-10m es ideal."

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_hr_job__accuracy_medium_max
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_res_company__accuracy_medium_max
msgid "Maximum margin of error (in meters) for a GPS signal to be considered 'Medium' reliability. Signals beyond this value are marked as 'Low' reliability."
msgstr "Margen de error máximo (en metros) para que una señal GPS se considere de 'Media' confiabilidad. Las señales más allá de este valor se marcan como de 'Baja' confiabilidad."

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,field_description:hr_attendance_geolocation_control.field_hr_job__attendance_geo_enforced
#: model:ir.model.fields,field_description:hr_attendance_geolocation_control.field_res_company__attendance_geo_enforced
msgid "Attendance Geo-Enforced"
msgstr "Asistencia Geo-Obligatoria"

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_hr_job__attendance_geo_enforced
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_res_company__attendance_geo_enforced
msgid "If enabled, Odoo will validate the employee's GPS coordinates against their work location's coordinates during attendance actions. Disable this to skip validation for this specific job position."
msgstr "Si está habilitado, Odoo validará las coordenadas GPS del empleado contra las coordenadas de su lugar de trabajo durante las acciones de asistencia. Deshabilítelo para omitir la validación."

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,field_description:hr_attendance_geolocation_control.field_hr_job__attendance_radius_m
#: model:ir.model.fields,field_description:hr_attendance_geolocation_control.field_res_company__attendance_radius_m
msgid "Attendance Radius (m)"
msgstr "Radio de Asistencia (m)"

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_hr_job__attendance_radius_m
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_res_company__attendance_radius_m
msgid "The maximum allowed distance (in meters) between the employee and the assigned work location. If an employee exceeds this radius, the system applies the 'Out of Location Policy'."
msgstr "La distancia máxima permitida (en metros) entre el empleado y el lugar de trabajo asignado. Si un empleado excede este radio, el sistema aplica la 'Política Fuera de Ubicación'."

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,field_description:hr_attendance_geolocation_control.field_hr_job__out_of_location_policy
#: model:ir.model.fields,field_description:hr_attendance_geolocation_control.field_res_company__out_of_location_policy
msgid "Out of Location Policy"
msgstr "Política Fuera de Ubicación"

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_hr_job__out_of_location_policy
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_res_company__out_of_location_policy
msgid "Determines what happens when an employee checks in/out outside the allowed radius. 'Block' prevents the action; 'Allow with Reason' requires a mandatory justification; 'Allow and Mark' lets them proceed but flags the record for audit."
msgstr "Determina qué sucede cuando un empleado marca entrada/salida fuera del radio permitido. 'Bloquear' previene la acción; 'Permitir con Razón' requiere una justificación obligatoria; 'Permitir y Marcar' les permite proceder pero marca el registro para auditoría."

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,field_description:hr_attendance_geolocation_control.field_hr_job__gps_unavailable_policy
#: model:ir.model.fields,field_description:hr_attendance_geolocation_control.field_res_company__gps_unavailable_policy
msgid "GPS Unavailable Policy"
msgstr "Política GPS No Disponible"

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_hr_job__gps_unavailable_policy
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_res_company__gps_unavailable_policy
msgid "System behavior when GPS coordinates cannot be retrieved (e.g., GPS disabled). 'Block' makes GPS mandatory for attendance."
msgstr "Comportamiento del sistema cuando no se pueden recuperar las coordenadas GPS (ej. GPS desactivado). 'Bloquear' hace que el GPS sea obligatorio para la asistencia."

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,field_description:hr_attendance_geolocation_control.field_hr_job__no_location_policy
#: model:ir.model.fields,field_description:hr_attendance_geolocation_control.field_res_company__no_location_policy
msgid "No Location Policy"
msgstr "Política Sin Ubicación"

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_hr_job__no_location_policy
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_res_company__no_location_policy
msgid "Behavior when an employee signs in on a day without an assigned Work Location. 'Block' forces managers to assign locations before employees can work."
msgstr "Comportamiento cuando un empleado marca en un día sin un Lugar de Trabajo asignado. 'Bloquear' obliga a los gerentes a asignar ubicaciones antes de que los empleados puedan trabajar."

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,field_description:hr_attendance_geolocation_control.field_hr_job__low_accuracy_policy
#: model:ir.model.fields,field_description:hr_attendance_geolocation_control.field_res_company__low_accuracy_policy
msgid "Low Accuracy Policy"
msgstr "Política de Baja Precisión"

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_hr_job__low_accuracy_policy
#: model:ir.model.fields,help:hr_attendance_geolocation_control.field_res_company__low_accuracy_policy
msgid "Action to take when the GPS signal is too weak. 'Block' prevents actions with poor signals; 'Allow with Warning' notifies the user; 'Allow' ignores signal quality."
msgstr "Acción a tomar cuando la señal GPS es demasiado débil. 'Bloquear' previene acciones con señales pobres; 'Permitir con Advertencia' notifica al usuario; 'Permitir' ignora la calidad de la señal."

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__hr_job__low_accuracy_policy__block
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__hr_job__out_of_location_policy__block
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__hr_job__gps_unavailable_policy__block
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__hr_job__no_location_policy__block
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__res_company__low_accuracy_policy__block
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__res_company__out_of_location_policy__block
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__res_company__gps_unavailable_policy__block
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__res_company__no_location_policy__block
msgid "Block"
msgstr "Bloquear"

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__hr_job__low_accuracy_policy__warn
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__res_company__low_accuracy_policy__warn
msgid "Allow with Warning"
msgstr "Permitir con Advertencia"

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__hr_job__low_accuracy_policy__allow
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__res_company__low_accuracy_policy__allow
msgid "Allow"
msgstr "Permitir"

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__hr_job__out_of_location_policy__allow_reason
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__hr_job__gps_unavailable_policy__allow_reason
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__res_company__out_of_location_policy__allow_reason
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__res_company__gps_unavailable_policy__allow_reason
msgid "Allow with Reason"
msgstr "Permitir con Razón"

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__hr_job__out_of_location_policy__allow_mark
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__hr_job__gps_unavailable_policy__allow_mark
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__hr_job__no_location_policy__allow_mark
