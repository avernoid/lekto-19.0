#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__res_company__gps_unavailable_policy__allow_mark
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__res_company__no_location_policy__allow_mark
msgid "Allow and Mark"
msgstr "Permitir y Marcar"

#. module: hr_attendance_geolocation_control
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__hr_job__no_location_policy__no_validate
#: model:ir.model.fields,selection:hr_attendance_geolocation_control.selection__res_company__no_location_policy__no_validate
