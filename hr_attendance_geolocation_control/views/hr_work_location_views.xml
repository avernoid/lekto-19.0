<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_work_location_view_form_inherit_geolocation" model="ir.ui.view">
        <field name="name">hr.work.location.form.inherit.geolocation</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Geofencing Data">
                        <group>
                            <group string="Coordinates">
                                <field name="latitude"/>
                                <field name="longitude"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
