<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_form_inherit_geolocation" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.geolocation</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Attendance Control" groups="hr_attendance.group_hr_attendance_officer">
                    <group>
                        <group string="Enforcement">
                            <field name="attendance_geo_enforced"/>
                            <field name="attendance_radius_m" invisible="not attendance_geo_enforced"/>
                            <field name="out_of_location_policy" invisible="not attendance_geo_enforced"/>
                        </group>
                        <group string="Accuracy &amp; Connectivity">
                            <field name="low_accuracy_policy" invisible="not attendance_geo_enforced"/>
                            <field name="gps_unavailable_policy" invisible="not attendance_geo_enforced"/>
                            <field name="accuracy_high_max" invisible="not attendance_geo_enforced"/>
                            <field name="accuracy_medium_max" invisible="not attendance_geo_enforced"/>
                        </group>
                    </group>
                    <group string="General Policies">
                        <field name="no_location_policy"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
