<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_geolocation" model="ir.ui.view">
        <field name="name">res.company.form.inherit.geolocation</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Attendance Geolocation Defaults" name="attendance_geo_defaults">
                    <group>
                        <group string="Enforcement Defaults">
                            <field name="attendance_geo_enforced_default"/>
                            <field name="attendance_radius_m_default"/>
                        </group>
                        <group string="Accuracy Thresholds">
                            <field name="accuracy_high_max_default"/>
                            <field name="accuracy_medium_max_default"/>
                        </group>
                    </group>
                    <group string="Policy Defaults">
                        <group>
                            <field name="out_of_location_policy_default"/>
                            <field name="low_accuracy_policy_default"/>
                        </group>
                        <group>
                            <field name="gps_unavailable_policy_default"/>
                            <field name="no_location_policy_default"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
