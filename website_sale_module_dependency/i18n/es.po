#. module: website_sale_module_dependency
#: model:ir.model.fields,field_description:website_sale_module_dependency.field_product_template__is_odoo_module
msgid "Is Odoo Module"
msgstr "Es un Módulo Odoo"

#. module: website_sale_module_dependency
#: model:ir.model.fields,help:website_sale_module_dependency.field_product_template__is_odoo_module
msgid "Mark this product as an Odoo module to enable dependency management. When enabled, you can link other module products as dependencies. The eCommerce will auto-add missing dependencies to the cart and display the total price including all required modules."
msgstr "Marque este producto como un módulo Odoo para habilitar la gestión de dependencias. Al activarlo, puede vincular otros productos-módulo como dependencias. El eCommerce añadirá automáticamente las dependencias faltantes al carrito y mostrará el precio total incluyendo todos los módulos requeridos."

#. module: website_sale_module_dependency
#: model:ir.model.fields,field_description:website_sale_module_dependency.field_product_template__technical_module_name
msgid "Technical Module Name"
msgstr "Nombre Técnico del Módulo"

#. module: website_sale_module_dependency
#: model:ir.model.fields,help:website_sale_module_dependency.field_product_template__technical_module_name
msgid "Technical name of the Odoo module, e.g. \"github_connector\". Used for automatic dependency suggestion from module manifests."
msgstr "Nombre técnico del módulo Odoo, por ejemplo \"github_connector\". Utilizado para sugerencias automáticas de dependencias desde manifiestos de módulos."

#. module: website_sale_module_dependency
#: model:ir.model.fields,field_description:website_sale_module_dependency.field_product_template__dependency_ids
msgid "Module Dependencies"
msgstr "Dependencias de Módulo"

#. module: website_sale_module_dependency
#: model:ir.model.fields,help:website_sale_module_dependency.field_product_template__dependency_ids
msgid "Other module products that this module depends upon. When a customer adds this module to their cart, all dependencies will be automatically added as separate cart lines. Dependencies are resolved recursively."
msgstr "Otros productos-módulo de los que este módulo depende. Cuando un cliente añade este módulo a su carrito, todas las dependencias se añadirán automáticamente como líneas separadas del carrito. Las dependencias se resuelven de forma recursiva."

#. module: website_sale_module_dependency
#: model:ir.model.fields,field_description:website_sale_module_dependency.field_product_template__all_dependency_ids
msgid "All Dependencies (cached)"
msgstr "Todas las Dependencias (caché)"

#. module: website_sale_module_dependency
#: model:ir.model.fields,help:website_sale_module_dependency.field_product_template__all_dependency_ids
msgid "Flattened list of all recursive dependencies. Stored for performance — avoids recursive traversal on every page render."
msgstr "Lista aplanada de todas las dependencias recursivas. Almacenada para rendimiento — evita el recorrido recursivo en cada renderizado de página."

#. module: website_sale_module_dependency
#: model:ir.model.fields,field_description:website_sale_module_dependency.field_product_template__total_price_with_deps
msgid "Total Price (with Dependencies)"
msgstr "Precio Total (con Dependencias)"

#. module: website_sale_module_dependency
#: model:ir.model.fields,help:website_sale_module_dependency.field_product_template__total_price_with_deps
msgid "The total price of this module including all its recursive dependencies. Duplicate dependencies are counted only once."
msgstr "El precio total de este módulo incluyendo todas sus dependencias recursivas. Las dependencias duplicadas se cuentan solo una vez."

#. module: website_sale_module_dependency
#: model:ir.model.fields,field_description:website_sale_module_dependency.field_product_template__dependency_count
msgid "Dependency Count"
msgstr "Cantidad de Dependencias"

#. module: website_sale_module_dependency
#: model:ir.model.fields,help:website_sale_module_dependency.field_product_template__dependency_count
msgid "Total number of unique recursive dependencies."
msgstr "Número total de dependencias recursivas únicas."

#. module: website_sale_module_dependency
#: model:ir.model.fields,field_description:website_sale_module_dependency.field_product_template__published_dependency_ids
msgid "Published Dependencies"
msgstr "Dependencias Publicadas"

#. module: website_sale_module_dependency
#: model:ir.model.fields,help:website_sale_module_dependency.field_product_template__published_dependency_ids
msgid "Only dependencies that are published on the website."
msgstr "Solo las dependencias que están publicadas en el sitio web."

#. module: website_sale_module_dependency
#: model:ir.model.fields,field_description:website_sale_module_dependency.field_product_template__published_dependency_count
