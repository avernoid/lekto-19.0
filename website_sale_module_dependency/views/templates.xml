<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Catalog /shop: show total price with deps below product price -->
    <!-- ============================================================ -->
    <template id="products_item_dependency_price"
              inherit_id="website_sale.products_item"
              name="Product Item: Dependency Price">
        <xpath expr="//div[hasclass('product_price')]" position="inside">
            <small t-if="product.is_odoo_module and product.dependency_count"
                   class="d-block text-muted mt-1 module_dep_total"
                   style="font-size: 0.8em;"
                   t-att-data-dep-tmpl-id="product.id">
                <i class="fa fa-cubes me-1" title="Includes dependencies"/>
                <span>Total with <t t-esc="product.dependency_count"/> dependencies: </span>
                <!-- Spinner shown until JS fills in pricelist price -->
                <span class="dep_price_value">
                    <i class="fa fa-spinner fa-spin fa-sm dep_price_spinner"/>
                </span>
                <!-- Hidden fallback (raw list_price) shown if RPC fails -->
                <span class="dep_price_fallback d-none">
                    <span t-esc="website.currency_id.symbol"/>
                    <span t-field="product.total_price_with_deps"
                          t-options='{"widget": "float", "precision": 2}'/>
                </span>
            </small>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Product page /shop/<product>: dependency detail block         -->
    <!-- ============================================================ -->
    <template id="product_dependency_detail"
              inherit_id="website_sale.product"
              name="Product Page: Dependency Detail">
        <xpath expr="//div[@id='product_details']" position="inside">
            <div t-if="product.is_odoo_module and product.dependency_count"
                 class="module_dependencies_block mt-3 p-3 border rounded bg-light"
                 t-att-data-dep-tmpl-id="product.id">
                <h6 class="mb-2">
                    <i class="fa fa-puzzle-piece me-1"/>
                    Required Dependencies
                    <a href="#depHelpText" class="ms-1 text-muted text-decoration-none"
                       data-bs-toggle="collapse"
                       role="button"
                       aria-expanded="false"
                       aria-controls="depHelpText"
                       style="font-size: 0.85em;">
                        <i class="fa fa-question-circle"/>
                    </a>
                </h6>
                <div class="collapse mb-2" id="depHelpText">
                    <small class="text-muted">
                        This module requires all listed dependencies to work correctly.
                        When you add it to your cart, dependencies are included automatically.
                        If you already own any of these modules for the same version,
                        you can remove them from your cart before checkout.
                    </small>
                </div>

                <ul class="list-unstyled mb-2 small">
                    <t t-foreach="product.all_dependency_ids" t-as="dep">
                        <li t-att-class="'d-flex justify-content-between py-1 border-bottom dep_price_item' + (' text-muted opacity-50' if not dep.website_published else '')"
                            t-att-data-dep-id="dep.id">
                            <span>
                                <i t-if="not dep.website_published"
                                   class="fa fa-lock me-1"
                                   title="Not published on website"/>
                                <t t-esc="dep.name"/>
                                <em t-if="not dep.website_published"
                                    class="ms-1"
                                    style="font-size: 0.9em;">
                                    — Not available
                                </em>
                            </span>
                            <span class="text-muted">
                                <!-- Spinner until JS loads pricelist price -->
                                <span class="dep_price_value">
                                    <i class="fa fa-spinner fa-spin fa-sm dep_price_spinner"/>
                                </span>
                                <!-- Hidden fallback (raw list_price) -->
                                <span class="dep_price_fallback d-none">
                                    <span t-esc="website.currency_id.symbol"/>
                                    <span t-field="dep.list_price"
                                          t-options='{"widget": "float", "precision": 2}'/>
                                </span>
                            </span>
                        </li>
                    </t>
                </ul>
                <div class="d-flex justify-content-between fw-bold pt-2">
                    <span>
                        <i class="fa fa-calculator me-1"/>
                        Total price (module + <t t-esc="product.dependency_count"/> dependencies):
                    </span>
                    <span class="text-primary">
                        <!-- Spinner until JS loads -->
                        <span class="dep_total_value">
                            <i class="fa fa-spinner fa-spin fa-sm dep_price_spinner"/>
                        </span>
                        <!-- Hidden fallback -->
                        <span class="dep_price_fallback d-none">
                            <span t-esc="website.currency_id.symbol"/>
                            <span t-field="product.total_price_with_deps"
                                  t-options='{"widget": "float", "precision": 2}'/>
                        </span>
                    </span>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Cart: show dependency badge on auto-added lines              -->
    <!-- ============================================================ -->
    <template id="cart_line_dependency_badge"
              inherit_id="website_sale.cart_lines"
              name="Cart Line: Dependency Badge">
        <xpath expr="//div[@name='o_wsale_cart_line_button_container']" position="inside">
            <small t-if="line.dependency_parent_name"
                   class="d-block text-warning mt-1"
                   style="font-size: 0.8em;">
                <i class="fa fa-link me-1"/>
                <span>Required by </span>
                <span t-esc="line.dependency_parent_name"/>
            </small>
        </xpath>
    </template>

</odoo>
