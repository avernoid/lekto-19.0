<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_add_dependencies" model="ir.ui.view">
        <field name="name">sale.order.form.add.dependencies</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='so_button_below_order_lines']" position="inside">
                <button string="🧩 Add Dependencies"
                        name="action_add_dependencies"
                        type="object"
                        class="btn btn-secondary"
                        invisible="locked or state == 'cancel'"
                        title="Auto-add missing module dependencies to this order"/>
                <button string="🧩 Add Dependencies"
                        name="action_add_dependencies"
                        type="object"
                        class="btn btn-secondary"
                        disabled="1"
                        invisible="not (locked or state == 'cancel')"
                        title="Auto-add missing module dependencies to this order"/>
            </xpath>
        </field>
    </record>

</odoo>
