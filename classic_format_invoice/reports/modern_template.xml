<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_modern">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.invoice_user_id.sudo().lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
                    <t t-call="classic_format_invoice.report_invoice_modern_document" t-lang="lang"/>
                </t>
            </t>
        </template>

        <template id="report_invoice_modern_document">
            <t t-call="web.basic_layout">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-set="primary_color" t-value="o.journal_id.cfi_primary_color or '#00A09D'"/>
                <t t-set="show_qr" t-value="o.journal_id.cfi_show_qr"/>
                <t t-set="has_discount" t-value="any(line.discount for line in o.invoice_line_ids)"/>
                
                <!-- Watermark -->
                <t t-if="o.journal_id.cfi_show_watermark">
                    <div style="position:absolute;opacity:0.12;transform:rotate(-45deg);width:100%;top:400px;text-align:center;z-index:-1000;pointer-events:none;">
                        <span style="font-size:120px;font-weight:900;color:black">
                            <span t-if="o.state == 'draft'">BORRADOR</span>
                            <span t-if="o.state == 'cancel'">CANCELADO</span>
                            <span t-if="o.state == 'posted' and o.payment_state in ('paid', 'in_payment')">PAGADO</span>
                        </span>
                    </div>
                </t>

                <div class="page" t-att-style="'font-family: Roboto, sans-serif; color: #333;'">
                    <!-- Header Section with Color Band -->
                    <div style="width:100%; border-bottom: 3px solid; padding-bottom: 20px; margin-bottom: 30px;" t-att-style="'border-color:' + primary_color">
                        <div class="row">
                            <div class="col-7">
                                <h2 t-att-style="'color:' + primary_color + '; font-weight:bold;'">
                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Factsura</span>
                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Borrador de Factura</span>
                                    <span t-if="o.move_type == 'out_refund'">Nota de Crédito</span>
                                    <span t-if="o.name != '/'" t-field="o.name"/>
                                </h2>
                                <div class="mt-2">
                                     <strong>Cliente:</strong> <span t-field="o.partner_id.name"/><br/>
                                     <t t-if="o.partner_id.vat">
                                        <strong>RUC/NIT:</strong> <span t-field="o.partner_id.vat"/><br/>
                                     </t>
                                     <span t-if="o.partner_id.street" t-field="o.partner_id.street"/><br/>
                                     <span t-if="o.partner_id.city" t-field="o.partner_id.city"/> <span t-if="o.partner_id.country_id" t-field="o.partner_id.country_id.name"/>
                                </div>
                            </div>
                            <div class="col-5 text-right">
                                <!-- QR Code Block (Top Right or next to totals? Latam usually puts it at bottom, but user asked for block. Let's put top right summary or leave for bottom) -->
                                <div class="p-3" style="background-color: #f8f9fa; border-radius: 8px;">
                                    <strong>Fecha de Emisión:</strong> <span t-field="o.invoice_date"/><br/>
                                    <strong>Fecha de Vencimiento:</strong> <span t-field="o.invoice_date_due"/><br/>
                                    <strong>Orden de Compra:</strong> <span t-field="o.ref"/><br/>
                                    <strong>Vendedor:</strong> <span t-field="o.invoice_user_id.name"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Lines Table -->
                    <table class="table table-sm" style="margin-bottom: 30px;">
                        <thead t-att-style="'background-color:' + primary_color + '; color: white;'">
                            <tr>
                                <th t-if="o.journal_id.cfi_show_product_images">Imagen</th>
                                <th>Descripción</th>
                                <th class="text-right">Cantidad</th>
                                <th class="text-right">Precio Unit.</th>
                                <th t-if="has_discount" class="text-right">Desc.%</th>
                                <th class="text-right">Impuestos</th>
                                <th class="text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr t-att-class="'font-weight-bold' if line.display_type == 'line_section' else 'font-italic' if line.display_type == 'line_note' else ''">
                                    <t t-if="line.display_type == 'product'">
                                        <td t-if="o.journal_id.cfi_show_product_images">
                                            <span t-field="line.product_id.image_128" t-options='{"widget": "image", "class": "img-thumbnail", "style": "width:48px;"}'/>
                                        </td>
                                        <td>
                                            <span t-field="line.product_id.name" class="font-weight-bold"/>
                                            <t t-if="line.name != line.product_id.name">
                                                <br/><span t-field="line.name" class="text-muted small"/>
                                            </t>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="line.quantity"/>
                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td t-if="has_discount" class="text-right">
                                            <span t-field="line.discount"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type == 'line_section'">
                                        <td colspan="99" style="background-color: #e9ecef;">
                                            <span t-field="line.name"/>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <td colspan="99">
                                            <span t-field="line.name"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Totals and Footer Info -->
                    <div class="row">
                        <div class="col-7">
                            <!-- Bank Accounts (Structured) -->
                            <t t-if="o.journal_id.cfi_show_banks and o.company_id.partner_id.bank_ids">
                                <div style="margin-top:20px; padding:15px; border:1px solid #ddd; border-left: 5px solid; border-radius: 5px;" t-att-style="'border-left-color:' + primary_color">
                                    <h6 t-att-style="'color:' + primary_color" class="font-weight-bold mb-3">Cuentas Bancarias</h6>
                                    <div class="row">
                                        <t t-foreach="o.company_id.partner_id.bank_ids" t-as="bank">
                                            <div class="col-6 mb-2">
                                                <strong><span t-field="bank.bank_id.name"/>: </strong> 
                                                <span t-field="bank.acc_number"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                            
                            <!-- Notes -->
                            <div class="mt-3 text-muted">
                                <span t-field="o.narration"/>
                            </div>
                        </div>
                        
                        <div class="col-5">
                            <table class="table table-sm" style="border-top: 3px solid;" t-att-style="'border-color:' + primary_color">
                                <!-- Subtotal -->
                                <tr>
                                    <td><strong>Subtotal</strong></td>
                                    <td></td>
                                    <td class="text-right">
                                        <span t-field="o.amount_untaxed"/>
                                    </td>
                                </tr>
                                
                                <!-- Tax Breakdown Header -->
                                <tr class="text-muted" style="font-size: 0.85em; background-color: #f9f9f9;">
                                    <td>Impuesto</td>
                                    <td class="text-right">Base Imp.</td>
                                    <td class="text-right">Monto</td>
                                </tr>

                                <!-- Taxes -->
                                <t t-foreach="o.amount_by_group" t-as="amount_by_group">
                                    <tr style="font-size: 0.9em;">
                                        <td>
                                            <span t-esc="amount_by_group[0]"/>
                                        </td>
                                        <td class="text-right">
                                            <span class="text-nowrap" t-esc="amount_by_group[4]"/>
                                        </td>
                                        <td class="text-right o_price_total">
                                            <span class="text-nowrap" t-esc="amount_by_group[3]"/>
                                        </td>
                                    </tr>
                                </t>
                                
                                <!-- Grand Total -->
                                <tr class="border-top" t-att-style="'border-color:' + primary_color">
                                    <td colspan="2"><strong t-att-style="'color:' + primary_color + '; font-size: 1.1em;'">Total a Pagar</strong></td>
                                    <td class="text-right">
                                        <span class="text-nowrap font-weight-bold" t-field="o.amount_total" style="font-size: 1.3em;"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Footer: Signature and QR -->
                    <div class="row mt-5">
                       <div class="col-8">
                           <t t-if="o.journal_id.cfi_show_signature">
                               <div class="row mt-5">
                                   <div class="col-6">
                                       <div style="border-top: 1px solid #333; width: 80%; padding-top: 5px; text-align: center;">
                                           Firma Autorizada
                                       </div>
                                   </div>
                                   <div class="col-6">
                                       <div style="border-top: 1px solid #333; width: 80%; padding-top: 5px; text-align: center;">
                                           Recibido Conforme (Cliente)
                                       </div>
                                   </div>
                               </div>
                           </t>
                       </div>
                       
                       <t t-if="show_qr">
                           <div class="col-4 text-right">
                                <img t-if="o.generate_qr_code()" style="display:block;margin-left:auto;width:120px;height:120px;" 
                                     t-att-src="o.get_qr_code_url()"/>
                           </div>
                       </t>
                    </div>

                </div>
            </t>
        </template>
    </data>
</odoo>
