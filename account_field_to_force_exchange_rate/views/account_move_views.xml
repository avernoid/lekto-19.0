<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_inherit_force_rate" model="ir.ui.view">
        <field name="name">account.move.form.force.rate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
             <!-- Make Currency and Rate visible for Entries (Misc Operations) -->
            <xpath expr="//field[@name='date']" position="after">
                <!-- Only show if it's an entry (not invoice) and has currency different from company -->
                <field name="currency_id" 
                       groups="base.group_multi_currency"
                       invisible="move_type != 'entry'" 
                       readonly="state != 'draft'"/>
                <field name="invoice_currency_rate" 
                       groups="base.group_multi_currency"
                       invisible="move_type != 'entry'" 
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>