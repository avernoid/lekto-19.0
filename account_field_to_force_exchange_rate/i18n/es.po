#. module: account_field_to_force_exchange_rate
#: model:ir.model.fields,field_description:account_field_to_force_exchange_rate.field_account_payment__to_force_exchange_rate
#: model:ir.model.fields,field_description:account_field_to_force_exchange_rate.field_account_payment_register__to_force_exchange_rate
msgid "Force Exchange Rate"
msgstr "Forzar T.C."

#. module: account_field_to_force_exchange_rate
#: model:ir.model.fields,help:account_field_to_force_exchange_rate.field_account_payment__to_force_exchange_rate
#: model:ir.model.fields,help:account_field_to_force_exchange_rate.field_account_payment_register__to_force_exchange_rate
msgid ""
"Use this field to manually override the exchange rate. If set, this rate will "
"be applied to the Journal Entry instead of the daily system rate."
msgstr ""
"Use este campo para anular manualmente el tipo de cambio. Si se establece, "
"esta tasa se aplicará al asiento contable en lugar de la tasa diaria del sistema."
