<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_inherit_flexible_invoice" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.flexible.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info']" position="inside">
                <label for="allow_invoice_without_delivery" string="Invoice Without Delivery"/>
                <field name="allow_invoice_without_delivery" 
                       widget="boolean_toggle"
                       nolabel="1"
                       invisible="state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
