#. module: github_connector
#: model:ir.model.fields,field_description:github_connector.field_github_organization__name
msgid "Organization Name"
msgstr "Nombre de Organización"

#. module: github_connector
#: model:ir.model.fields,help:github_connector.field_github_organization__name
msgid "The name of the GitHub Organization (e.g., 'ganemo')."
msgstr "El nombre de la Organización en GitHub (ej. 'ganemo')."

#. module: github_connector
#: model:ir.model.fields,field_description:github_connector.field_github_organization__repository_sync_limit
msgid "Branch Sync Limit per Batch"
msgstr "Límite de Sync de Ramas por Lote"

#. module: github_connector
#: model:ir.model.fields,help:github_connector.field_github_organization__repository_sync_limit
msgid ""
"Maximum number of repositories to synchronize branches for in a single execution. Use this to prevent Timeouts on large organizations."
msgstr ""
"Número máximo de repositorios para sincronizar ramas en una sola ejecución. Usa esto para prevenir Timeouts en organizaciones grandes."

#. module: github_connector
#: model:ir.model.fields,field_description:github_connector.field_github_organization__ignored_repository_names
msgid "Ignored Repositories"
msgstr "Repositorios Ignorados"

#. module: github_connector
#: model:ir.model.fields,help:github_connector.field_github_organization__ignored_repository_names
msgid ""
"Set here repository names (one per line) that you want to ignore during synchronization. These repositories will be created in Odoo but will NOT sync branches or download source code. Useful for archiving or ignoring forks.\n"
" Example:\n"
" purchase-workflow\n"
" OCB\n"
""
msgstr ""
"Configura aquí los nombres de repositorios (uno por línea) que deseas ignorar. Se crearán en Odoo pero NO sincronizarán ramas ni código fuente.\n"
" Ejemplo:\n"
" purchase-workflow\n"
" OCB\n"
""

