<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_github_team_partner_search" model="ir.ui.view">
        <field name="model">github.team.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="team_id" />
                <field name="partner_id" />
                <field name="role" />
            </search>
        </field>
    </record>
    <record id="view_github_team_partner_list" model="ir.ui.view">
        <field name="model">github.team.partner</field>
        <field name="arch" type="xml">
            <list create="false" decoration-warning="role == 'member'">
                <field
                    name="team_id"
                    invisible="context_search_default_team_id != 0"/>
                <field
                    name="partner_id"
                    invisible="context_search_default_partner_id != 0"/>
                <field name="role" />
                <field name="context_search_default_team_id" column_invisible="True" />
                <field name="context_search_default_partner_id" column_invisible="True" />
            </list>
        </field>
    </record>
    <record id="view_github_team_partner_form" model="ir.ui.view">
        <field name="model">github.team.partner</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" />
                        </h1>
                        <h2>
                            <field name="team_id" />
                        </h2>
                    </div>
                    <field name="role" />
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_github_team_partner_from_team_kanban" model="ir.ui.view">
        <field name="name">github.team.partner.kanban</field>
        <field name="model">github.team.partner</field>
        <field name="arch" type="xml">
            <kanban create="false">
                <field name="partner_id" />
                <field name="role" />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img
                                    alt="Avatar"
                                    t-attf-src="/web/image/#{record.partner_id.raw_value}"
                                />
                            </div>
                            <div class="oe_kanban_details">
                                <h3>
                                    <field name="partner_id" />
                                </h3>
                                <t t-if="record.role.raw_value == 'member'">
                                    <span class="badge">
                                        <i class="fa fa-fw fa-user" />
                                        <t t-esc="record.role.value" />
                                    </span>
                                </t>
                                <t t-if="record.role.raw_value == 'maintainer'">
                                    <span class="badge">
                                        <i class="fa fa-fw fa-cog" />
                                        <t t-esc="record.role.value" />
                                    </span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_github_team_partner_from_partner_kanban" model="ir.ui.view">
        <field name="model">github.team.partner</field>
        <field name="arch" type="xml">
            <kanban create="false">
                <field name="team_id" />
                <field name="role" />
                <templates>
                    <t t-name="card">
                        <div class="o_res_partner_kanban oe_kanban_global_click">
                            <div class="oe_module_desc">
                                <h3>
                                    <field name="team_id" />
                                </h3>
                                <t t-if="record.role.raw_value == 'member'">
                                    <span class="badge">
                                        <i class="fa fa-fw fa-user" />
                                        <t t-esc="record.role.value" />
                                    </span>
                                </t>
                                <t t-if="record.role.raw_value == 'maintainer'">
                                    <span class="badge">
                                        <i class="fa fa-fw fa-cog" />
                                        <t t-esc="record.role.value" />
                                    </span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
