<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_payroll_structure_search_view_inherit_basic_rule"
            model="ir.ui.view">
        <field name="name">hr.payroll.structure.search.view.inherit.basic_rule</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payroll_structure_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/group" position="inside">
                <filter
                    string="Archived Structures"
                    name="inactive"
                    context="{'group_by':'active'}"/>
            </xpath>
        </field>
    </record>

</odoo>
