msgstr ""
"El documento de origen, o la referencia del movimiento cuando el origen no "
"tiene documento propio."

#. module: stock_move_date_adjust
#: model:ir.model.fields,help:stock_move_date_adjust.field_stock_move_date_adjust_line__product_id
