#: code:addons/stock_move_date_adjust/models/stock_move.py:0
#, python-format
msgid ""
"These movements would land in a closed accounting period:\n"
"\n"
"%(moves)s\n"
"\n"
"Reopen the period or pick another date."
msgstr ""
"Estos movimientos caerían en un periodo contable cerrado:\n"
"\n"
"%(moves)s\n"
"\n"
"Reabre el periodo o elige otra fecha."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
msgid "Select at least one record."
msgstr "Selecciona al menos un registro."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
msgid "The selected records have no stock movements."
msgstr "Los registros seleccionados no tienen movimientos de stock."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
msgid "Fill in the target date first."
msgstr "Primero indica la fecha de destino."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid "Movement date regularisation is not available on %s."
msgstr "La regularización de fechas de movimientos no está disponible en %s."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid "%(days)s days %(hours)sh %(minutes)smin"
msgstr "%(days)s días %(hours)sh %(minutes)smin"

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid "Every movement moves %(gap)s later."
msgstr "Cada movimiento se mueve %(gap)s hacia adelante."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid "Every movement moves %(gap)s earlier."
msgstr "Cada movimiento se mueve %(gap)s hacia atrás."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid ""
"%(count)s movement(s) would land in the future, which is refused. Check the "
"direction of the shift: the target date must be in the past."
msgstr ""
"%(count)s movimiento(s) caerían en el futuro, cosa que se rechaza. Revisa la "
"dirección del desplazamiento: la fecha de destino debe estar en el pasado."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid ""
"You are about to re-date %(moves)s movement(s) across %(documents)s "
"document(s)."
msgstr ""
"Vas a cambiar la fecha de %(moves)s movimiento(s) en %(documents)s "
"documento(s)."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid ""
"%(count)s movement(s) would end up before their own origin movement (e.g. "
"%(move)s before %(origin)s). The chronology of the chain would no longer "
"hold."
msgstr ""
"%(count)s movimiento(s) quedarían antes que su propio movimiento de origen "
"(por ejemplo %(move)s antes que %(origin)s). La cronología de la cadena "
"dejaría de sostenerse."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid ""
"%(count)s movement(s) are not done. On those, the date is the *planned* "
"date, not the effective one."
msgstr ""
"%(count)s movimiento(s) no están hechos. En esos, la fecha es la *prevista*, "
"no la efectiva."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid "%(count)s valuation journal entries will keep their current date, so the stock ledger and the general ledger will differ for those movements."
msgstr "%(count)s asientos de valorización conservarán su fecha actual, así que el kardex y el mayor diferirán para esos movimientos."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid "%(count)s movements regularised."
msgstr "%(count)s movimientos regularizados."

#. module: stock_move_date_adjust
#: model_terms:ir.ui.view,arch_db:stock_move_date_adjust.stock_move_date_adjust_wizard_form
msgid "What will change"
msgstr "Qué va a cambiar"

#. module: stock_move_date_adjust
#: model_terms:ir.ui.view,arch_db:stock_move_date_adjust.stock_move_date_adjust_wizard_form
msgid "Apply"
msgstr "Aplicar"

#. module: stock_move_date_adjust
#: model_terms:ir.ui.view,arch_db:stock_move_date_adjust.stock_move_date_adjust_wizard_form
msgid "Discard"
msgstr "Descartar"

#. module: stock_move_date_adjust
#: model_terms:ir.ui.view,arch_db:stock_move_date_adjust.stock_move_date_adjust_wizard_form
msgid "e.g. 2025 close regularisation"
msgstr "p. ej. regularización cierre 2025"

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid "%(count)s valuation journal entries will be reset to draft, RENUMBERED into the target period and posted again. That leaves a gap in the sequence of their original period. Reconciled, hash-protected or closed-period entries are refused."
msgstr "%(count)s asientos de valorización se devolverán a borrador, se RENUMERARÁN en el periodo de destino y se volverán a contabilizar. Eso deja un hueco en la secuencia de su periodo original. Los asientos conciliados, protegidos por hash o en periodo cerrado se rechazan."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/models/stock_move.py:0
#, python-format
msgid "These valuation entries cannot be re-dated:\n\n%(entries)s\n\nUntick the accounting option, or resolve them in Accounting first."
msgstr "Estos asientos de valorización no se pueden re-fechar:\n\n%(entries)s\n\nDesmarca la opción contable, o resuélvelos antes en Contabilidad."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/models/stock_move.py:0
#, python-format
msgid "- %(entry)s: only a posted entry can be re-dated (it is %(state)s)."
msgstr "- %(entry)s: solo se puede re-fechar un asiento contabilizado (está en %(state)s)."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/models/stock_move.py:0
#, python-format
msgid "- %(entry)s: protected by an inalterability hash."
msgstr "- %(entry)s: protegido por un hash de inalterabilidad."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/models/stock_move.py:0
#, python-format
msgid "- %(entry)s: requires a cancellation request."
msgstr "- %(entry)s: requiere una solicitud de cancelación."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/models/stock_move.py:0
#, python-format
msgid "- %(entry)s: reconciled. Odoo would let it through and break the reconciliation silently; unreconcile it first."
msgstr "- %(entry)s: conciliado. Odoo lo dejaría pasar y rompería la conciliación en silencio; desconcílialo primero."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/models/stock_move.py:0
#, python-format
msgid "- %(entry)s: its current period is closed (%(locks)s)."
msgstr "- %(entry)s: su periodo actual está cerrado (%(locks)s)."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/models/stock_move.py:0
#, python-format
msgid "Re-dated by a stock movement date regularisation. Previously %(old_name)s; renumbered because Odoo ties an entry's number to its period."
msgstr "Re-fechado por una regularización de fechas de movimientos. Antes %(old_name)s; renumerado porque Odoo ata el número de un asiento a su periodo."

#. module: stock_move_date_adjust
#: model:ir.model.fields,field_description:stock_move_date_adjust.field_stock_move_date_adjust_wizard__effective_move_ids
msgid "Movements Actually Affected"
msgstr "Movimientos realmente afectados"

#. module: stock_move_date_adjust
#: model:ir.model.fields,field_description:stock_move_date_adjust.field_stock_move_date_adjust_wizard__sibling_count
msgid "Movements Added"
msgstr "Movimientos añadidos"

#. module: stock_move_date_adjust
#: model:ir.model.fields,help:stock_move_date_adjust.field_stock_move_date_adjust_wizard__effective_move_ids
msgid "The selection plus the movements that syncing the document header would drag along anyway. Odoo propagates a header date back to every movement of its document, so they are included openly instead of moving unannounced."
msgstr "La selección más los movimientos que la sincronización de la cabecera va a arrastrar de todos modos. Odoo propaga la fecha de una cabecera a todos los movimientos de su documento, así que se incluyen abiertamente en vez de moverse sin avisar."

#. module: stock_move_date_adjust
#: model:ir.model.fields,help:stock_move_date_adjust.field_stock_move_date_adjust_wizard__sibling_count
msgid "How many movements were added to the selection because they belong to a document you are re-dating."
msgstr "Cuántos movimientos se añadieron a la selección por pertenecer a un documento que estás re-fechando."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid "%(count)s more movement(s) were added to the list: they share a document with your selection, and Odoo re-dates every movement of a document when its header date changes. They are shown below and get the same traceability. Untick 'Also update the document date' to touch only what you picked."
msgstr "Se añadieron %(count)s movimiento(s) más a la lista: comparten documento con tu selección, y Odoo re-fecha todos los movimientos de un documento cuando cambia la fecha de su cabecera. Aparecen abajo y reciben la misma trazabilidad. Desmarca 'Actualizar también la fecha del documento' para tocar solo lo que elegiste."

#. module: stock_move_date_adjust
#. odoo-python
#: code:addons/stock_move_date_adjust/wizard/stock_move_date_adjust_wizard.py:0
#, python-format
msgid "You are about to re-date %(moves)s movement(s)."
msgstr "Vas a cambiar la fecha de %(moves)s movimiento(s)."
