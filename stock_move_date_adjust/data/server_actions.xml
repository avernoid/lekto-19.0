<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- One wizard, several entry points. Contextual server actions are used on
         purpose: the same binding mechanism serves every source model without
         inheriting a single form view. -->

    <record id="action_date_adjust_stock_move" model="ir.actions.server">
        <field name="name">Regularise Movement Dates</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(6, 0, [ref('stock_move_date_adjust.group_stock_move_date_adjust')])]"/>
        <field name="state">code</field>
        <field name="code">action = env['stock.move.date.adjust.wizard'].action_open(records)</field>
    </record>

    <record id="action_date_adjust_stock_picking" model="ir.actions.server">
        <field name="name">Regularise Movement Dates</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(6, 0, [ref('stock_move_date_adjust.group_stock_move_date_adjust')])]"/>
        <field name="state">code</field>
        <field name="code">action = env['stock.move.date.adjust.wizard'].action_open(records)</field>
    </record>

    <record id="action_date_adjust_stock_scrap" model="ir.actions.server">
        <field name="name">Regularise Movement Dates</field>
        <field name="model_id" ref="stock.model_stock_scrap"/>
        <field name="binding_model_id" ref="stock.model_stock_scrap"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(6, 0, [ref('stock_move_date_adjust.group_stock_move_date_adjust')])]"/>
        <field name="state">code</field>
        <field name="code">action = env['stock.move.date.adjust.wizard'].action_open(records)</field>
    </record>

    <record id="action_date_adjust_restore" model="ir.actions.server">
        <field name="name">Restore Original Date</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(6, 0, [ref('stock_move_date_adjust.group_stock_move_date_adjust')])]"/>
        <field name="state">code</field>
        <field name="code">records.action_restore_original_date()</field>
    </record>

</odoo>
