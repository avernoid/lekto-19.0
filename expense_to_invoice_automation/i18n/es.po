#. module: expense_to_invoice_automation
#: model:ir.model.fields,field_description:expense_to_invoice_automation.field_res_company__autocreate_invoice_from_expense
msgid "Autocreate Invoices from Expenses"
msgstr "Crear Facturas Automáticamente desde Gastos"

#. module: expense_to_invoice_automation
#: model:ir.model.fields,field_description:expense_to_invoice_automation.field_res_company__force_vendor_on_expense
msgid "Force Vendor on Expenses"
msgstr "Forzar Proveedor en Gastos"

#. module: expense_to_invoice_automation
#: model:ir.model.fields,field_description:expense_to_invoice_automation.field_res_company__expense_vendor_bill_journal_id
msgid "Vendor Bill Journal"
msgstr "Diario de Facturas de Proveedor"

#. module: expense_to_invoice_automation
#: model:ir.model.fields,help:expense_to_invoice_automation.field_res_company__autocreate_invoice_from_expense
msgid "If enabled, posting HR Expenses will automatically create Vendor Bills (in_invoice) instead of generic journal entries or receipts. This ensures proper Accounts Payable reconciliation."
msgstr "Si se habilita, contabilizar Gastos de RRHH creará automáticamente Facturas de Proveedor en lugar de asientos contables o recibos genéricos. Esto asegura la correcta conciliación de Cuentas por Pagar."

#. module: expense_to_invoice_automation
#: model:ir.model.fields,help:expense_to_invoice_automation.field_res_company__force_vendor_on_expense
msgid "If enabled, the Vendor (Partner) field becomes strictly required on all expenses regardless of the payment mode, ensuring that every expense can generate a valid Accounts Payable Vendor Bill."
msgstr "Si se habilita, el campo Proveedor será estrictamente obligatorio en todos los gastos independientemente del modo de pago, asegurando que cada gasto pueda generar una Factura de Proveedor válida en Cuentas por Pagar."

#. module: expense_to_invoice_automation
#: model:ir.model.fields,help:expense_to_invoice_automation.field_res_company__expense_vendor_bill_journal_id
msgid "Optional. Select a dedicated Purchase journal for the Vendor Bills created automatically from expenses. If left empty, Odoo's default Purchase journal will be used (which might require Document Types if LatAm is installed)."
msgstr "Opcional. Seleccione un diario de Compras dedicado para las Facturas de Proveedor creadas automáticamente desde los gastos. Si se deja vacío, se usará el diario de Compras principal de Odoo (el cual podría requerir Tipo de Documento si LatAm está instalado)."

#. module: expense_to_invoice_automation
#: model:ir.model.fields,field_description:expense_to_invoice_automation.field_hr_expense__reference
msgid "Reference"
msgstr "Referencia"

#. module: expense_to_invoice_automation
#: model:ir.model.fields,help:expense_to_invoice_automation.field_hr_expense__reference
msgid "Reference of the Vendor Bill. This value will be mapped directly to the 'Bill Reference' field on the generated Vendor Bill."
msgstr "Referencia de la Factura del Proveedor. Este valor se copiará directamente al campo 'Referencia de Factura' en la Factura generada."

#. module: expense_to_invoice_automation
#: model:ir.model.fields,field_description:expense_to_invoice_automation.field_hr_expense__vendor_bill_count
msgid "Vendor Bills Count"
msgstr "Conteo de Facturas"

#. module: expense_to_invoice_automation
#. odoo-python
#: code:addons/expense_to_invoice_automation/models/hr_expense.py:0
msgid "The Vendor field is mandatory when invoice automation is enabled and configured to force its use."
msgstr "El campo Proveedor es obligatorio cuando la automatización de facturas está habilitada y configurada para forzar su uso."

#. module: expense_to_invoice_automation
#. odoo-python
#: code:addons/expense_to_invoice_automation/models/hr_expense.py:0
msgid "The Vendor field is mandatory to automate invoice creation."
msgstr "El campo Proveedor es obligatorio para automatizar la creación de facturas."

#. module: expense_to_invoice_automation
#. odoo-python
#: code:addons/expense_to_invoice_automation/models/hr_expense.py:0
#, python-format
msgid "You need to add a manual payment method on the journal (%s)"
msgstr "Necesitas agregar un método de pago manual en el diario (%s)"

