<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expose skip_wizard_on_sale as hidden field in the stop timer wizard -->
    <record id="view_hr_timesheet_stop_timer_wizard_skip_wizard" model="ir.ui.view">
        <field name="name">hr.timesheet.stop.timer.confirmation.wizard.form.skip.wizard</field>
        <field name="model">hr.timesheet.stop.timer.confirmation.wizard</field>
        <field name="inherit_id" ref="industry_fsm.hr_timesheet_stop_timer_confirmation_wizard_view_form_inherit"/>
        <field name="arch" type="xml">
            <field name="time_spent" position="after">
                <field name="skip_wizard_on_sale" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
