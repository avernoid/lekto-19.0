<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_inherit_fsm_skip_wizard" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.fsm.skip.wizard</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="industry_fsm_sale.project_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allow_material']/.." position="inside">
                <div class="col-lg-12" invisible="not allow_material">
                    <field name="skip_wizard_on_sale"/>
                    <span class="text-muted">Skip wizard if sale exists</span>
                </div>
                <div class="col-lg-12" invisible="not allow_material">
                    <field name="auto_return_to_previous_view"/>
                    <span class="text-muted">Auto return to task list after stopping timer</span>
                </div>
                <div class="col-lg-12 mt8 ms-4"
                     invisible="not allow_material or not auto_return_to_previous_view">
                    <label for="return_action_id" string="Return Action" class="text-muted fw-bold"/>
                    <field name="return_action_id"
                           placeholder="Leave empty to use FSM task list as fallback"
                           options="{'no_create': True, 'no_open': True}"/>
                </div>
            </xpath>
        </field>

    </record>
</odoo>

