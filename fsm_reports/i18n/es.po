#. module: fsm_reports
#: model:ir.model.fields,help:fsm_reports.field_report_fsm_task_visit__not_executed
msgid "1 if the visit was marked as not executed by the auto_cancel_fsm_task module, else 0."
msgstr "1 si la visita fue marcada como no ejecutada por el módulo auto_cancel_fsm_task, de lo contrario 0."

#. module: fsm_reports
#: model:ir.model.fields,help:fsm_reports.field_report_fsm_task_visit__executed
msgid "1 if the visit was actually carried out (not_executed = False), else 0."
msgstr "1 si la visita fue realmente realizada (not_executed = False), de lo contrario 0."

#. module: fsm_reports
#: model:ir.model.fields,help:fsm_reports.field_report_fsm_task_visit__has_sale
msgid "1 if a confirmed Sale Order is linked to this visit, else 0."
msgstr "1 si una orden de venta confirmada está vinculada a esta visita, de lo contrario 0."

#. module: fsm_reports
#: model:ir.model.fields,help:fsm_reports.field_report_fsm_task_visit__planned
msgid ""
"Always 1 per row. When summed in pivot/graph, gives the total number "
"of planned visits regardless of execution status or sales outcome."
msgstr ""
"Siempre 1 por fila. Al sumar en pivot/gráfico, da el número total "
"de visitas planificadas sin importar el estado de ejecución o resultado de ventas."

#. module: fsm_reports
#: model:ir.model.fields,help:fsm_reports.field_report_fsm_task_visit__execution_rate
msgid ""
"Percentage of planned visits that were executed. "
"Executed visit = 100.0, Not executed = 0.0. "
"When grouped in pivot, the average equals the execution rate of the group."
msgstr ""
"Porcentaje de visitas planificadas que fueron ejecutadas. "
"Visita ejecutada = 100.0, No ejecutada = 0.0. "
"Al agrupar en pivot, el promedio equivale a la tasa de ejecución del grupo."

#. module: fsm_reports
#: model:ir.model.fields,help:fsm_reports.field_report_fsm_task_visit__not_execution_rate
msgid ""
"Percentage of planned visits that were NOT executed (auto-cancelled). "
"Not executed = 100.0, Executed = 0.0. "
"Complementary to Execution Rate: execution_rate + not_execution_rate = 100."
msgstr ""
"Porcentaje de visitas planificadas que NO fueron ejecutadas (auto-canceladas). "
"No ejecutada = 100.0, Ejecutada = 0.0. "
"Complementario a la Tasa de Ejecución: execution_rate + not_execution_rate = 100."

#. module: fsm_reports
#: model:ir.model.fields,help:fsm_reports.field_report_fsm_task_visit__conversion_rate
msgid ""
"Percentage of executed visits that generated a confirmed Sale Order. "
"Executed + sale = 100.0, Executed + no sale = 0.0, Not executed = NULL (excluded from average). "
"When grouped in pivot, the average of these row values equals the conversion rate of the group."
msgstr ""
"Porcentaje de visitas ejecutadas que generaron una orden de venta confirmada. "
"Ejecutada + venta = 100.0, Ejecutada + sin venta = 0.0, No ejecutada = NULL (excluida del promedio). "
"Al agrupar en pivot, el promedio de estos valores por fila equivale a la tasa de conversión del grupo."

#. module: fsm_reports
#: model:ir.model.fields,help:fsm_reports.field_report_fsm_task_visit__avg_ticket_untaxed
msgid ""
"Average net sale amount per visit with sale. "
"Equal to sale_amount_untaxed when has_sale = 1, NULL otherwise. "
"NULL rows are excluded from AVG, so the grouped average equals "
"the average net ticket over visits with sale only."
msgstr ""
"Importe neto promedio de venta por visita con venta. "
"Igual a sale_amount_untaxed cuando has_sale = 1, NULL en caso contrario. "
"Las filas NULL se excluyen del AVG, por lo que el promedio agrupado equivale "
"al ticket promedio neto solo sobre visitas con venta."

#. module: fsm_reports
#: model:ir.model.fields,help:fsm_reports.field_report_fsm_task_visit__avg_ticket_total
msgid ""
"Average total sale amount per visit with sale. "
"Equal to sale_amount_total when has_sale = 1, NULL otherwise. "
"NULL rows are excluded from AVG, so the grouped average equals "
"the average total ticket over visits with sale only."
msgstr ""
"Importe total promedio de venta por visita con venta. "
"Igual a sale_amount_total cuando has_sale = 1, NULL en caso contrario. "
"Las filas NULL se excluyen del AVG, por lo que el promedio agrupado equivale "
"al ticket promedio total solo sobre visitas con venta."

#. module: fsm_reports
#: model:ir.model.fields,help:fsm_reports.field_project_project__include_in_visit_report
msgid ""
"Controls whether tasks from this project are included in FSM visit reports.\n"
"When enabled, this project's visits are considered in Visit Compliance, "
"Conversion, and Sales Analysis report menus.\n"
"When disabled, tasks from this project are excluded globally from "
"report.fsm.task.visit analytics.\n"
"Default is enabled for new projects."
msgstr ""
"Controla si las tareas de este proyecto se incluyen en los reportes de "
"visitas FSM.\n"
"Cuando está habilitado, las visitas de este proyecto se consideran en los "
"menús de reportes Cumplimiento de Visitas, Conversión y Análisis de Ventas.\n"
"Cuando está deshabilitado, las tareas de este proyecto se excluyen de forma "
"global de la analítica report.fsm.task.visit.\n"
"Para nuevos proyectos, se habilita por defecto."

