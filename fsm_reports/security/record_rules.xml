<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        RECORD RULES for report.fsm.task.visit
        ========================================
        FSM User  → sees only rows where user_id = uid (their own tasks)
        FSM Manager → sees all rows (no restriction)

        Both rules apply READ only (this is a SQL view, no writes occur).
    -->

    <!-- Rule: FSM User — only own visits -->
    <record id="rule_fsm_report_visit_user" model="ir.rule">
        <field name="name">FSM Report Visit: Solo mis visitas</field>
        <field name="model_id" ref="fsm_reports.model_report_fsm_task_visit"/>
        <field name="groups" eval="[(4, ref('industry_fsm.group_fsm_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rule: FSM Manager — unrestricted access -->
    <record id="rule_fsm_report_visit_manager" model="ir.rule">
        <field name="name">FSM Report Visit: Ver todos los registros</field>
        <field name="model_id" ref="fsm_reports.model_report_fsm_task_visit"/>
        <field name="groups" eval="[(4, ref('industry_fsm.group_fsm_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
