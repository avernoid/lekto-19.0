<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_inherit_fsm_reports" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.fsm.reports</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="industry_fsm_sale.project_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allow_material']/.." position="inside">
                <div class="col-lg-12" invisible="not is_fsm">
                    <field name="include_in_visit_report"/>
                    <span class="text-muted">Include this project in FSM visit analytics reports</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

