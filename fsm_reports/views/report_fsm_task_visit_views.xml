<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================================
         REPORT 1: Visit Compliance
         Goal: Executed vs. not-executed visits by salesperson and month.
    ==================================================================== -->

    <!-- LIST VIEW -->
    <record id="view_fsm_report_effectiveness_list" model="ir.ui.view">
        <field name="name">report.fsm.task.visit.effectiveness.list</field>
        <field name="model">report.fsm.task.visit</field>
        <field name="arch" type="xml">
            <list string="Visit Compliance" create="false" edit="false" delete="false">
                <field name="planned_date" string="Date"/>
                <field name="user_id" string="Salesperson"/>
                <field name="partner_id" string="Customer"/>
                <field name="project_id" string="Project" optional="hide"/>
                <field name="state" string="State" optional="show"/>
                <field name="planned" string="Planned"/>
                <field name="executed" string="Executed"/>
                <field name="not_executed" string="Not Executed"/>
                <field name="has_sale" string="With Sale"/>
                <field name="lost_reason_id" string="Lost Reason" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="sale_amount_total" string="Total Sales" widget="monetary" optional="show"/>
            </list>
        </field>
    </record>

    <!-- PIVOT VIEW -->
    <record id="view_fsm_report_effectiveness_pivot" model="ir.ui.view">
        <field name="name">report.fsm.task.visit.effectiveness.pivot</field>
        <field name="model">report.fsm.task.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visit Compliance" display_quantity="true">
                <field name="planned_month" type="col" string="Month"/>
                <field name="user_id" type="row" string="Salesperson"/>
                <field name="planned" type="measure" string="Planned"/>
                <field name="executed" type="measure" string="Executed"/>
                <field name="execution_rate" type="measure" string="Execution Rate (%)"/>
                <field name="not_executed" type="measure" string="Not Executed"/>
                <field name="not_execution_rate" type="measure" string="Not Executed Rate (%)"/>
            </pivot>
        </field>
    </record>

    <!-- GRAPH VIEW -->
    <record id="view_fsm_report_effectiveness_graph" model="ir.ui.view">
        <field name="name">report.fsm.task.visit.effectiveness.graph</field>
        <field name="model">report.fsm.task.visit</field>
        <field name="arch" type="xml">
            <graph string="Visit Compliance" type="bar" stacked="true">
                <field name="user_id" type="row" string="Salesperson"/>
                <field name="execution_rate" type="measure" string="Execution Rate (%)"/>
                <field name="not_execution_rate" type="measure" string="Not Executed Rate (%)"/>
            </graph>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_fsm_report_effectiveness" model="ir.actions.act_window">
        <field name="name">Visit Compliance</field>
        <field name="res_model">report.fsm.task.visit</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[]</field>
        <field name="context">{
            'search_default_group_user': 1,
            'search_default_filter_this_quarter': 1
        }</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_fsm_report_effectiveness_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_fsm_report_effectiveness_graph')}),
            (0, 0, {'view_mode': 'list',  'view_id': ref('view_fsm_report_effectiveness_list')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No completed visits to display.
            </p>
            <p>
                This report shows field-visit compliance:
                how many visits were executed vs not executed, grouped by salesperson and month.
            </p>
        </field>
    </record>


    <!-- ====================================================================
         REPORT 2: Visit → Sale Conversion
         Goal: Of executed visits, how many generated a confirmed sale order.
               Includes lost reasons for visits without a sale.
    ==================================================================== -->

    <!-- LIST VIEW -->
    <record id="view_fsm_report_conversion_list" model="ir.ui.view">
        <field name="name">report.fsm.task.visit.conversion.list</field>
        <field name="model">report.fsm.task.visit</field>
        <field name="arch" type="xml">
            <list string="Visit → Sale Conversion" create="false" edit="false" delete="false">
                <field name="planned_date" string="Date"/>
                <field name="user_id" string="Salesperson"/>
                <field name="partner_id" string="Customer"/>
                <field name="executed" string="Executed"/>
                <field name="has_sale" string="With Sale"/>
                <field name="lost_reason_id" string="Lost Reason"/>
                <field name="sale_order_count" string="# Orders"/>
                <field name="conversion_rate" string="Conversion Rate (%)"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="sale_amount_untaxed" string="Untaxed Amount" widget="monetary" optional="show"/>
                <field name="sale_amount_total" string="Total Sales" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- PIVOT VIEW -->
    <record id="view_fsm_report_conversion_pivot" model="ir.ui.view">
        <field name="name">report.fsm.task.visit.conversion.pivot</field>
        <field name="model">report.fsm.task.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visit → Sale Conversion" display_quantity="true">
                <field name="planned_month" type="col" string="Month"/>
                <field name="user_id" type="row" string="Salesperson"/>
                <field name="planned" type="measure" string="Planned"/>
                <field name="executed" type="measure" string="Executed"/>
                <field name="has_sale" type="measure" string="With Sale"/>
                <field name="conversion_rate" type="measure" string="Conversion Rate (%)"/>
                <field name="sale_amount_total" type="measure" string="Total Sales"/>
            </pivot>
        </field>
    </record>

    <!-- GRAPH VIEW -->
    <record id="view_fsm_report_conversion_graph" model="ir.ui.view">
        <field name="name">report.fsm.task.visit.conversion.graph</field>
        <field name="model">report.fsm.task.visit</field>
        <field name="arch" type="xml">
            <graph string="Visit → Sale Conversion" type="bar">
                <field name="user_id" type="row" string="Salesperson"/>
                <field name="conversion_rate" type="measure" string="Conversion Rate (%)"/>
                <field name="has_sale" type="measure" string="With Sale"/>
                <field name="executed" type="measure" string="Executed"/>
            </graph>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_fsm_report_conversion" model="ir.actions.act_window">
        <field name="name">Visit → Sale Conversion</field>
        <field name="res_model">report.fsm.task.visit</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[]</field>
        <field name="context">{
            'search_default_group_user': 1,
            'search_default_filter_this_quarter': 1
        }</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_fsm_report_conversion_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_fsm_report_conversion_graph')}),
            (0, 0, {'view_mode': 'list',  'view_id': ref('view_fsm_report_conversion_list')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No executed visits to display.
            </p>
            <p>
                This report shows the visit-to-sale conversion rate.
                It automatically filters only executed visits and indicates whether
                a confirmed sale order was generated.
            </p>
        </field>
    </record>


    <!-- ====================================================================
         REPORT 3: FSM Sales Analysis
         Goal: Sales amounts, order count, and avg ticket by customer/salesperson.
               Only accessible to FSM Managers (configured in menus.xml).
    ==================================================================== -->

    <!-- LIST VIEW -->
    <record id="view_fsm_report_sales_list" model="ir.ui.view">
        <field name="name">report.fsm.task.visit.sales.list</field>
        <field name="model">report.fsm.task.visit</field>
        <field name="arch" type="xml">
            <list string="Sales Analysis" create="false" edit="false" delete="false">
                <field name="planned_date" string="Date"/>
                <field name="user_id" string="Salesperson"/>
                <field name="partner_id" string="Customer"/>
                <field name="project_id" string="Project" optional="show"/>
                <field name="sale_order_count" string="# Orders"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="sale_amount_untaxed" string="Untaxed Amount" widget="monetary"/>
                <field name="sale_amount_total" string="Total Sales" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- PIVOT VIEW -->
    <record id="view_fsm_report_sales_pivot" model="ir.ui.view">
        <field name="name">report.fsm.task.visit.sales.pivot</field>
        <field name="model">report.fsm.task.visit</field>
        <field name="arch" type="xml">
            <pivot string="Sales Analysis" display_quantity="true">
                <field name="planned_month" type="col" string="Month"/>
                <field name="partner_id" type="row" string="Customer"/>
                <field name="user_id" type="row" string="Salesperson"/>
                <field name="sale_order_count" type="measure" string="# Orders"/>
                <field name="sale_amount_untaxed" type="measure" string="Untaxed Amount"/>
                <field name="sale_amount_total" type="measure" string="Total Sales"/>
                <field name="avg_ticket_untaxed" type="measure" string="Avg Ticket Untaxed"/>
                <field name="avg_ticket_total" type="measure" string="Avg Ticket Total"/>
            </pivot>
        </field>
    </record>

    <!-- GRAPH VIEW -->
    <record id="view_fsm_report_sales_graph" model="ir.ui.view">
        <field name="name">report.fsm.task.visit.sales.graph</field>
        <field name="model">report.fsm.task.visit</field>
        <field name="arch" type="xml">
            <graph string="Sales Analysis" type="bar">
                <field name="user_id" type="row" string="Salesperson"/>
                <field name="sale_amount_total" type="measure" string="Total Sales"/>
                <field name="sale_order_count" type="measure" string="# Orders"/>
            </graph>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_fsm_report_sales" model="ir.actions.act_window">
        <field name="name">Sales Analysis</field>
        <field name="res_model">report.fsm.task.visit</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[]</field>
        <field name="context">{
            'search_default_group_user': 1,
            'search_default_filter_this_quarter': 1
        }</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_fsm_report_sales_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_fsm_report_sales_graph')}),
            (0, 0, {'view_mode': 'list',  'view_id': ref('view_fsm_report_sales_list')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No FSM sales to display.
            </p>
            <p>
                This report shows sales generated from field visits:
                totals, order count, and average ticket by customer and salesperson.
            </p>
        </field>
    </record>


    <!-- ====================================================================
         SEARCH VIEW (shared across all 3 reports)
    ==================================================================== -->
    <record id="view_fsm_report_visit_search" model="ir.ui.view">
        <field name="name">report.fsm.task.visit.search</field>
        <field name="model">report.fsm.task.visit</field>
        <field name="arch" type="xml">
            <search string="Search Visits">
                <field name="user_id" string="Salesperson"/>
                <field name="partner_id" string="Customer"/>
                <field name="project_id" string="Project"/>
                <field name="lost_reason_id" string="Lost Reason"/>
                <!-- Filters -->
                <filter name="filter_executed"
                        string="Executed"
                        domain="[('executed', '=', 1)]"/>
                <filter name="filter_not_executed"
                        string="Not Executed"
                        domain="[('not_executed', '=', 1)]"/>
                <filter name="filter_with_sale"
                        string="With Sale"
                        domain="[('has_sale', '=', 1)]"/>
                <filter name="filter_without_sale"
                        string="Without Sale"
                        domain="[('executed', '=', 1), ('has_sale', '=', 0)]"/>
                <separator/>
                <filter name="filter_this_quarter"
                        string="This Quarter"
                        domain="[
                            ('planned_date_begin', '&gt;=', (context_today() + relativedelta(months=-2, day=1)).strftime('%Y-%m-%d')),
                            ('planned_date_begin', '&lt;',  (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))
                        ]"/>
                <filter name="filter_this_month"
                        string="This Month"
                        domain="[
                            ('planned_date_begin', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                            ('planned_date_begin', '&lt;',  (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))
                        ]"/>
                <filter name="filter_last_month"
                        string="Last Month"
                        domain="[
                            ('planned_date_begin', '&gt;=', (context_today() + relativedelta(months=-1, day=1)).strftime('%Y-%m-%d')),
                            ('planned_date_begin', '&lt;',  (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))
                        ]"/>
                <!-- Group by -->
                <separator/>
                <filter name="group_user"
                        string="Salesperson"
                        context="{'group_by': 'user_id'}"/>
                <filter name="group_partner"
                        string="Customer"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="group_project"
                        string="Project"
                        context="{'group_by': 'project_id'}"/>
                <filter name="group_lost_reason"
                        string="Lost Reason"
                        context="{'group_by': 'lost_reason_id'}"/>
                <separator/>
                <filter name="group_month"
                        string="Month"
                        context="{'group_by': 'planned_month'}"/>
                <filter name="group_week"
                        string="Week"
                        context="{'group_by': 'planned_week'}"/>
                <filter name="group_date"
                        string="Date"
                        context="{'group_by': 'planned_date'}"/>
            </search>
        </field>
    </record>

</odoo>
