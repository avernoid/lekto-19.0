<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Sub-menu items added under the native FSM "Reporting" menu
        (industry_fsm.fsm_menu_reporting, id=726).

        Effective Visits & Conversion: visible to both User and Manager.
        Sales Analysis: restricted to Manager only (sensitive monetary data).
    -->

    <!-- Report 1: Visit Compliance -->
    <menuitem
        id="menu_fsm_report_effectiveness"
        name="Visit Compliance"
        parent="industry_fsm.fsm_menu_reporting"
        action="fsm_reports.action_fsm_report_effectiveness"
        sequence="50"
        groups="industry_fsm.group_fsm_user,industry_fsm.group_fsm_manager"
    />

    <!-- Report 2: Visit → Sale Conversion -->
    <menuitem
        id="menu_fsm_report_conversion"
        name="Visit → Sale Conversion"
        parent="industry_fsm.fsm_menu_reporting"
        action="fsm_reports.action_fsm_report_conversion"
        sequence="60"
        groups="industry_fsm.group_fsm_user,industry_fsm.group_fsm_manager"
    />

    <!-- Report 3: Sales Analysis (Manager only) -->
    <menuitem
        id="menu_fsm_report_sales"
        name="Sales Analysis"
        parent="industry_fsm.fsm_menu_reporting"
        action="fsm_reports.action_fsm_report_sales"
        sequence="70"
        groups="industry_fsm.group_fsm_manager"
    />

</odoo>
