<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_analytic_distribution_model_view_search" model="ir.ui.view">
        <field name="name">account.analytic.distribution.model.search</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="arch" type="xml">
            <search string="Analytic Distribution Model">
                <field name="partner_id"/>
                <field name="partner_category_id"/>
                <field name="origin_warehouse_id"/>
                <field name="invoice_user_id"/>
                <field name="journal_id"/>
                <field name="account_prefix"/>
                <separator/>
                <filter string="Origin Warehouse" name="group_warehouse" context="{'group_by':'origin_warehouse_id'}"/>
                <filter string="Salesperson (Invoice)" name="group_salesperson" context="{'group_by':'invoice_user_id'}"/>
                <filter string="Journal (Invoice)" name="group_journal" context="{'group_by':'journal_id'}"/>

                <filter string="Partner" name="group_partner" context="{'group_by':'partner_id'}"/>
            </search>
        </field>
    </record>


    <record id="analytic_distribution_model_form_view_inherit_account_analytic_default_location" model="ir.ui.view">
        <field name="name">account.analytic.distribution.model.inherit.form</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="inherit_id" ref="analytic.account_analytic_distribution_model_form_view"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="origin_warehouse_id"/>
                <field name="origin_location_id"/>
                <field name="dest_location_id"/>
                <field name="invoice_user_id"/>
                <field name="user_id"/>
                <field name="journal_id"/>
            </field>
        </field>
    </record>

    <record id="analytic.action_analytic_distribution_model" model="ir.actions.act_window">
        <field name="search_view_id" ref="account_analytic_distribution_model_view_search"/>
    </record>


</odoo>

