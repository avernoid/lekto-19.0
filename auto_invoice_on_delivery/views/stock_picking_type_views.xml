<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_inherit_auto_invoice" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.auto.invoice</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='second']" position="after">
                <group string="Facturación" name="invoicing">
                    <field name="auto_invoice"/>
                    <field name="auto_invoice_on_validate" invisible="not auto_invoice"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
