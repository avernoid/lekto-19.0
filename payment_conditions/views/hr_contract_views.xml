<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_inherit_payment_condition" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.payment_condition</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='payroll_information']/group/group[@name='contract']/field[@name='structure_type_id']" position="after">
                <field name="special_situation_id"/>
            </xpath>
            <xpath expr="//page[@name='payroll_information']/group/group[@name='contract']/field[@name='registration_number']" position="after">
                <separator string="Condiciones de pago"/>
                <field name="payment_type_id"/>
                <field name="variable_payment_id"/>
            </xpath>
        </field>
    </record>

    <record id="hr_version_template_form_inherit_extra_info" model="ir.ui.view">
        <field name="name">hr.version.template.form.inherit.extra.info</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='information']/group/group[@name='contract']/field[@name='structure_type_id']"
                   position="after">
                <field name="special_situation_id"/>

                <separator string="Condiciones de pago"/>
                <field name="payment_type_id"/>
                <field name="variable_payment_id"/>
            </xpath>

        </field>
    </record>

</odoo>
