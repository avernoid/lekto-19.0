<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_mobilvendor_sync_customers" model="ir.cron">
            <field name="name">Mobilvendor: Sincronizar Clientes y Rutas</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model.sync_customers_users()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_mobilvendor_sync_invoices" model="ir.cron">
            <field name="name">Mobilvendor: Sincronizar Facturas, Pagos e Inventario</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model.sync_all()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_mobilvendor_sync_prices" model="ir.cron">
            <field name="name">Mobilvendor: Sincronizar Lista de Precios</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model.sync_price_list_products()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>