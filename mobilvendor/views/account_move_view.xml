<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_mobilvendor" model="ir.ui.view">
            <field name="name">account.move.form.inherit.mobilvendor</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//header" position="inside">
                    <button name="action_check_mobilvendor_status" 
                            string="Consultar Estado Mobilvendor" 
                            type="object" 
                            class="oe_highlight" 
                            invisible="not mobilvendor_id or state == 'cancel'"/>
                </xpath>

                <xpath expr="//field[@name='partner_shipping_id']" position="after">

                    <field name="mobilvendor_route_id"
                           readonly="1"
                           force_save="1"
                           options="{'no_open': False}"/>

                    <field name="mobilvendor_id" readonly="1" invisible="not mobilvendor_id"/>

                    <field name="mobilvendor_vendor_id"
                           options="{'no_create': True, 'no_open': False}"/>

                </xpath>

            </field>
        </record>
    </data>
</odoo>