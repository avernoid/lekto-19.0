<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add button to the product.pricelist form view -->
    <record id="view_product_pricelist_form_mobilvendor" model="ir.ui.view">
        <field name="name">product.pricelist.form.mobilvendor</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <!-- Create a header if it doesn't exist to place the action button -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_sync_mobilvendor" type="object" string="Enviar Tarifa a Mobilvendor" class="oe_highlight"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Add Server Action for the tree (list) view -->
    <record id="action_sync_pricelist_mobilvendor" model="ir.actions.server">
        <field name="name">Sincronizar a Mobilvendor</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="binding_model_id" ref="product.model_product_pricelist"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_sync_mobilvendor()
        </field>
    </record>
</odoo>
