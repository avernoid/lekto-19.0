<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_location_form_inherit_mobilvendor" model="ir.ui.view">
            <field name="name">stock.location.form.inherit.mobilvendor</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='replenish_location']" position="after">
                    <field name="mobilvendor_sync" widget="boolean_toggle"/>
                </xpath>

            </field>
        </record>

        <record id="view_location_tree_inherit_mobilvendor" model="ir.ui.view">
            <field name="name">stock.location.tree.inherit.mobilvendor</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_tree2"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="mobilvendor_sync" widget="boolean_toggle" optional="show"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>