<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add button to the product.template form view -->
    <record id="view_product_template_form_mobilvendor" model="ir.ui.view">
        <field name="name">product.template.form.mobilvendor</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Puts the button in the header structure of the form -->
            <xpath expr="//header" position="inside">
                <button name="action_sync_mobilvendor" type="object" string="Sincronizar a Mobilvendor" class="oe_highlight"/>
            </xpath>
        </field>
    </record>

    <!-- Add Server Action for the tree (list) view -->
    <record id="action_sync_product_mobilvendor" model="ir.actions.server">
        <field name="name">Sincronizar a Mobilvendor</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_sync_mobilvendor()
        </field>
    </record>
</odoo>
