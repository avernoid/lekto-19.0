msgid "Sales Goals"
msgstr "Metas de Ventas"

msgid "My Goals"
msgstr "Mis Metas"

msgid "This Month"
msgstr "Este Mes"

msgid "Sale Orders"
msgstr "Pedidos de Venta"

msgid "Invoices"
msgstr "Facturas"

msgid "Goals Analysis"
msgstr "Análisis de Metas"

msgid "Goal Lines"
msgstr "Líneas de Meta"

msgid "Sales Goals Analysis"
msgstr "Análisis de Metas de Ventas"
