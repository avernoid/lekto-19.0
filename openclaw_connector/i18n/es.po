#. module: openclaw_connector
#: model:ir.model.fields,field_description:openclaw_connector.field_res_config_settings__openclaw_api_url
msgid "Openclaw API URL"
msgstr "URL de la API de Openclaw"

#. module: openclaw_connector
#: model:ir.model.fields,field_description:openclaw_connector.field_res_config_settings__openclaw_api_key
msgid "Openclaw API Key"
msgstr "Clave de API de Openclaw"

#. module: openclaw_connector
#: model:ir.model.fields,help:openclaw_connector.field_res_config_settings__openclaw_api_url
msgid ""
"Base URL of the Openclaw API endpoint (e.g. https://api.openclaw.io). "
"This is the root URL that all API requests will be sent to. "
"Do not include trailing slashes or specific endpoint paths."
msgstr ""
"URL base del endpoint de la API de Openclaw (ej. https://api.openclaw.io). "
"Esta es la URL raíz a la que se enviarán todas las solicitudes de la API. "
"No incluya barras finales ni rutas de endpoints específicos."

#. module: openclaw_connector
#: model:ir.model.fields,help:openclaw_connector.field_res_config_settings__openclaw_api_key
msgid ""
"Secret key used to authenticate requests with the Openclaw API. "
"You can obtain this key from your Openclaw account dashboard "
"under the API settings section. Keep this value confidential."
msgstr ""
"Clave secreta utilizada para autenticar las solicitudes con la API de Openclaw. "
"Puede obtener esta clave desde el panel de su cuenta de Openclaw "
"en la sección de configuración de API. Mantenga este valor confidencial."

