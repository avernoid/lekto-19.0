<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Extends the Connectors settings view to add an "Openclaw" credentials block.
        Inherits from universal_connector so it appears inside the same settings page.
    -->
    <record id="openclaw_connector_config_settings_view" model="ir.ui.view">
        <field name="name">openclaw.connector.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="universal_connector.res_config_settings_view_form_connector"/>
        <field name="arch" type="xml">
            <xpath
                expr="//app[@name='universal_connector']/block[@name='universal_connector_block']"
                position="after">
                <block title="Openclaw" name="openclaw_connector_block">
                    <setting
                        string="API URL"
                        help="Base URL for the Openclaw API endpoint.">
                        <field
                            name="openclaw_api_url"
                            placeholder="https://api.openclaw.io"/>
                    </setting>
                    <setting
                        string="API Key"
                        help="Secret key to authenticate with the Openclaw API.">
                        <field name="openclaw_api_key" password="True"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
