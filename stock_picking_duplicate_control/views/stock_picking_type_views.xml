<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_inherit_duplicate_control" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.duplicate.control</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='second']" position="inside">
                <group string="Duplicate Control">
                    <field name="duplicate_product_policy" widget="radio"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
