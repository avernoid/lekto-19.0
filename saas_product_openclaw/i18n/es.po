#. module: saas_product_openclaw
#: model:saas.product.operation,label:saas_product_openclaw.op_openclaw_upgrade
msgid "Upgrade OpenClaw"
msgstr "Actualizar OpenClaw"

#. module: saas_product_openclaw
#: model:saas.product.operation,description:saas_product_openclaw.op_openclaw_upgrade
msgid "Rolling replacement del container: pull, start lateral, Nginx upstream switch, cooldown 30s, cleanup del viejo."
msgstr "Reemplazo gradual del contenedor: pull, inicio lateral, cambio de upstream Nginx, enfriamiento 30s, limpieza del antigua."

#. module: saas_product_openclaw
#: model:saas.product.operation.param,label:saas_product_openclaw.op_openclaw_upgrade_param_version
msgid "Target Version"
msgstr "Versión Objetivo"

#. module: saas_product_openclaw
#: model:saas.product.operation,label:saas_product_openclaw.op_openclaw_restart
msgid "Restart OpenClaw"
msgstr "Reiniciar OpenClaw"

#. module: saas_product_openclaw
#: model:saas.product.operation,description:saas_product_openclaw.op_openclaw_restart
msgid "Hard restart del container OpenClaw. ~5-10s de downtime (sin drain). Usar Upgrade si se necesita zero-downtime."
msgstr "Reinicio duro del contenedor OpenClaw. ~5-10s de inactividad (sin drain). Usar Actualizar si se necesita cero tiempo de inactividad."

#. module: saas_product_openclaw
#: model:saas.product.operation,label:saas_product_openclaw.op_openclaw_rotate_password
msgid "Rotate Gateway Password"
msgstr "Rotar Contraseña del Gateway"

#. module: saas_product_openclaw
#: model:saas.product.operation,description:saas_product_openclaw.op_openclaw_rotate_password
msgid "Genera un password nuevo, actualiza Secrets Manager y reinicia el container. Sesiones activas se invalidan."
msgstr "Genera una nueva contraseña, actualiza Secrets Manager y reinicia el contenedor. Las sesiones activas se invalidan."

#. module: saas_product_openclaw
#: model:saas.product.operation.param,label:saas_product_openclaw.op_openclaw_rotate_password_param_notify
msgid "Notify Client"
msgstr "Notificar al Cliente"

#. module: saas_product_openclaw
#: model:saas.product.operation,label:saas_product_openclaw.op_openclaw_update_env_var
msgid "Update Env Var"
msgstr "Actualizar Variable de Entorno"

#. module: saas_product_openclaw
#: model:saas.product.operation,description:saas_product_openclaw.op_openclaw_update_env_var
msgid "Setea o actualiza una variable de entorno del container OpenClaw. Reinicia el container para aplicar el cambio."
msgstr "Establece o actualiza una variable de entorno del contenedor OpenClaw. Reinicia el contenedor para aplicar el cambio."

#. module: saas_product_openclaw
#: model:saas.product.operation.param,label:saas_product_openclaw.op_openclaw_update_env_var_param_name
msgid "Variable Name"
msgstr "Nombre de Variable"

#. module: saas_product_openclaw
#: model:saas.product.operation.param,label:saas_product_openclaw.op_openclaw_update_env_var_param_value
msgid "Value"
msgstr "Valor"

#. module: saas_product_openclaw
#: model:saas.product.operation.param,label:saas_product_openclaw.op_openclaw_update_env_var_param_secret
msgid "Mark as Secret (mask in logs)"
msgstr "Marcar como Secreto (ocultar en logs)"

#. module: saas_product_openclaw
#: model:saas.product.operation,label:saas_product_openclaw.op_openclaw_add_custom_domain
msgid "Add Custom Domain"
msgstr "Agregar Dominio Personalizado"

#. module: saas_product_openclaw
#: model:saas.product.operation,description:saas_product_openclaw.op_openclaw_add_custom_domain
msgid "Registra un dominio del cliente vía Let's Encrypt (HTTP-01) y monta un server block de nginx que enruta tráfico al backend de OpenClaw. El cliente debe haber apuntando primero su DNS al subdominio -direct."
msgstr "Registra un dominio del cliente vía Let's Encrypt (HTTP-01) y monta un bloque de servidor en nginx que enruta tráfico al backend de OpenClaw. El cliente debe haber apuntando primero su DNS al subdominio -direct."

#. module: saas_product_openclaw
#: model:saas.product.operation.param,label:saas_product_openclaw.op_openclaw_add_custom_domain_param_domain
msgid "Custom Domain"
msgstr "Dominio Personalizado"

#. module: saas_product_openclaw
#: model:saas.product.operation,label:saas_product_openclaw.op_openclaw_remove_custom_domain
msgid "Remove Custom Domain"
msgstr "Eliminar Dominio Personalizado"

#. module: saas_product_openclaw
#: model:saas.product.operation,description:saas_product_openclaw.op_openclaw_remove_custom_domain
msgid "Borra el certificado Let's Encrypt y el server block de nginx asociado al dominio del cliente. Idempotente."
msgstr "Borra el certificado Let's Encrypt y el bloque de servidor de nginx asociado al dominio del cliente. Idempotente."

#. module: saas_product_openclaw
#: model:saas.product.operation.param,label:saas_product_openclaw.op_openclaw_remove_custom_domain_param_domain
msgid "Custom Domain"
msgstr "Dominio Personalizado"