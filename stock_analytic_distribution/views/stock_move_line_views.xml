<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Detailed operations (in the transfer) -->
    <record id="view_stock_move_line_detailed_operation_tree_analytic" model="ir.ui.view">
        <field name="name">stock.move.line.detailed - analytic distribution</field>
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"
        />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    optional="hide"
                    groups="analytic.group_analytic_accounting"
                    options="{'product_field': 'product_id', 'business_domain': 'stock_move'}"
                />
            </field>
        </field>
    </record>

    <!-- Search: filter and group operations by analytic account -->
    <record id="stock_move_line_view_search_analytic" model="ir.ui.view">
        <field name="name">stock.move.line.search - analytic distribution</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field
                    name="analytic_distribution"
                    string="Analytic Account"
                    groups="analytic.group_analytic_accounting"
                />
            </field>
            <filter name="groupby_product_id" position="after">
                <filter
                    string="Analytic Account"
                    name="groupby_analytic_distribution"
                    domain="[]"
                    context="{'group_by': 'analytic_distribution'}"
                    groups="analytic.group_analytic_accounting"
                />
            </filter>
        </field>
    </record>
</odoo>
