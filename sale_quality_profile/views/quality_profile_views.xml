<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_profile_view_list" model="ir.ui.view">
        <field name="name">quality.profile.list</field>
        <field name="model">quality.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="enforcement"/>
                <field name="point_count" string="# Points"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="quality_profile_view_form" model="ir.ui.view">
        <field name="name">quality.profile.form</field>
        <field name="model">quality.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Premium"/></h1>
                    </div>
                    <group>
                        <field name="enforcement"/>
                        <field name="active" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="point_ids">
                        <list>
                            <field name="name"/>
                            <field name="title"/>
                            <field name="measure_on"/>
                            <field name="picking_type_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="quality_profile_action" model="ir.actions.act_window">
        <field name="name">Quality Profiles</field>
        <field name="res_model">quality.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_quality_profile"
        name="Quality Profiles"
        parent="quality_control.menu_quality_configuration"
        action="quality_profile_action"
        sequence="25"/>
</odoo>
