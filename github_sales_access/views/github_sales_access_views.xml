<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SERVER ACTIONS (Acción ▾ desde la lista)                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Sync en lote: opera sobre registros padre seleccionados -->
    <record id="action_server_sync_selected_accesses" model="ir.actions.server">
        <field name="name">🔄 Sincronizar todos los repos</field>
        <field name="model_id" ref="model_github_sales_access"/>
        <field name="binding_model_id" ref="model_github_sales_access"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_sync_all_repos()</field>
    </record>

    <!-- Revoke en lote -->
    <record id="action_server_revoke_selected_accesses" model="ir.actions.server">
        <field name="name">❌ Revocar todos los repos</field>
        <field name="model_id" ref="model_github_sales_access"/>
        <field name="binding_model_id" ref="model_github_sales_access"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_revoke_all_repos()</field>
    </record>

    <!-- Detectar huérfanos (equiv. cron semanal) -->
    <record id="action_server_check_discrepancies" model="ir.actions.server">
        <field name="name">🔍 Detectar Huérfanos en GitHub</field>
        <field name="model_id" ref="model_github_sales_access"/>
        <field name="binding_model_id" ref="model_github_sales_access"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">model.cron_check_discrepancies()</field>
    </record>

    <!-- Rellenar repos de huérfanos (sobre registros seleccionados) -->
    <record id="action_server_fill_orphan_repos" model="ir.actions.server">
        <field name="name">📦 Rellenar repos de huérfanos</field>
        <field name="model_id" ref="model_github_sales_access"/>
        <field name="binding_model_id" ref="model_github_sales_access"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_fill_orphan_repos()</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- ACTION principal                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="action_github_sales_access_all" model="ir.actions.act_window">
        <field name="name">Accesos GitHub</field>
        <field name="res_model">github.sales.access</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay accesos GitHub registrados.
            </p>
            <p>
                Los accesos se crean automáticamente al confirmar un pedido
                que contenga el producto "GitHub Connector". También puedes
                crearlos manualmente desde aquí.
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- KANBAN VIEW                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_github_sales_access_kanban" model="ir.ui.view">
        <field name="name">github.sales.access.kanban</field>
        <field name="model">github.sales.access</field>
        <field name="arch" type="xml">
            <kanban default_group_by="github_status" class="o_kanban_small_column">
                <field name="github_status"/>
                <field name="github_username"/>
                <field name="partner_id"/>
                <field name="github_partner_id"/>
                <field name="repo_count"/>
                <field name="order_id"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_color_#{record.color.value} oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <strong>
                                    <t t-esc="record.github_username.value or 'Sin usuario'"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="text-muted">
                                    <t t-esc="record.partner_id.value"/>
                                </span><br/>
                                <span>
                                    <i class="fa fa-code-fork" title="Repos"/>
                                    <t t-esc="record.repo_count.value"/> repos
                                </span>
                                <t t-if="record.order_id.value">
                                    <br/><small class="text-muted">
                                        <t t-esc="record.order_id.value"/>
                                    </small>
                                </t>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="github_status" widget="badge"
                                       decoration-success="github_status == 'active'"
                                       decoration-warning="github_status == 'pending'"
                                       decoration-danger="github_status in ('error', 'inactive', 'orphan')"
                                       decoration-muted="github_status == 'draft'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- LIST VIEW                                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_github_sales_access_list" model="ir.ui.view">
        <field name="name">github.sales.access.list</field>
        <field name="model">github.sales.access</field>
        <field name="arch" type="xml">
            <list string="Accesos GitHub"
                  editable="top"
                  decoration-success="github_status == 'active'"
                  decoration-warning="github_status == 'pending'"
                  decoration-danger="github_status in ('error', 'inactive', 'orphan')"
                  decoration-muted="github_status == 'draft'">
                <field name="partner_id" readonly="1" optional="show"/>
                <field name="github_partner_id"
                       string="Usuario GitHub"
                       placeholder="ej. octocat"/>
                <field name="github_username" string="GitHub Login" optional="show"/>
                <field name="order_id" string="Pedido" readonly="1" optional="show"/>
                <field name="repo_count" string="Repos" widget="integer" readonly="1"/>
                <field name="github_status" widget="badge"
                       decoration-success="github_status == 'active'"
                       decoration-warning="github_status == 'pending'"
                       decoration-danger="github_status in ('error', 'inactive', 'orphan')"
                       decoration-muted="github_status == 'draft'"
                       readonly="1"/>
                <field name="order_sale_state" string="Estado Pedido"
                       widget="badge"
                       decoration-success="order_sale_state == 'sale'"
                       decoration-info="order_sale_state == 'sent'"
                       decoration-danger="order_sale_state == 'cancel'"
                       decoration-muted="order_sale_state == 'draft'"
                       readonly="1" optional="show"/>
                <field name="order_state" string="Estado Suscripción"
                       widget="badge"
                       decoration-success="order_state in ('2_renewal', '3_progress', '7_upsell')"
                       decoration-warning="order_state == '4_paused'"
                       decoration-danger="order_state == '6_churn'"
                       readonly="1" optional="show"/>
                <field name="last_sync_date" readonly="1" optional="show"/>
                <button name="action_sync_all_repos"
                        string=""
                        type="object"
                        icon="fa-refresh"
                        title="Sincronizar todos los repos de este acceso"/>
                <button name="action_open_form"
                        string=""
                        type="object"
                        icon="fa-external-link"
                        title="Abrir vista detalle"/>
            </list>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- FORM VIEW                                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_github_sales_access_form" model="ir.ui.view">
        <field name="name">github.sales.access.form</field>
        <field name="model">github.sales.access</field>
        <field name="arch" type="xml">
            <form string="Acceso GitHub">
                <header>
                    <button name="action_sync_all_repos"
                            string="🔄 Sincronizar Todos los Repos"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_revoke_all_repos"
                            string="❌ Revocar Todos los Repos"
                            type="object"
                            class="btn-danger"
                            confirm="¿Estás seguro? Se revocarán TODOS los repositorios de este usuario."/>
                    <button name="action_fill_orphan_repos"
                            string="🔍 Detectar repos en GitHub"
                            type="object"
                            class="btn-secondary"
                            invisible="github_status != 'orphan'"
                            title="Busca en qué repositorios de GitHub tiene acceso este usuario y los añade como filas hijo."/>
                    <field name="github_status" widget="statusbar"
                           statusbar_visible="draft,pending,active,inactive"/>
                </header>
                <sheet>
                    <group string="Usuario GitHub">
                        <group>
                            <field name="github_partner_id"
                                   placeholder="ej. octocat"/>
                            <field name="github_username"/>
                        </group>
                    </group>
                    <group string="Suscripción">
                        <group>
                            <field name="order_line_id"
                                   domain="[('product_id.product_tmpl_id.github_product_type', '=', 'connector')]"/>
                            <field name="order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="order_sale_state" string="Estado Pedido"
                                   widget="badge"
                                   decoration-success="order_sale_state == 'sale'"
                                   decoration-info="order_sale_state == 'sent'"
                                   decoration-danger="order_sale_state == 'cancel'"
                                   decoration-muted="order_sale_state == 'draft'"
                                   readonly="1"/>
                            <field name="order_state" string="Estado Suscripción"
                                   widget="badge"
                                   decoration-success="order_state in ('2_renewal', '3_progress', '7_upsell')"
                                   decoration-warning="order_state == '4_paused'"
                                   decoration-danger="order_state == '6_churn'"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="last_sync_date" readonly="1"/>
                        </group>
                    </group>

                    <!-- Tabla de repositorios hijo -->
                    <notebook>
                        <page string="Repositorios" name="repos">
                            <field name="repo_ids" nolabel="1">
                                <list string="Repositorios"
                                      editable="bottom"
                                      decoration-success="github_status == 'active'"
                                      decoration-warning="github_status == 'pending'"
                                      decoration-danger="github_status in ('error', 'inactive', 'orphan')"
                                      decoration-muted="github_status == 'draft'">
                                    <field name="repository_id" options="{'no_create': True}"/>
                                    <field name="github_status" widget="badge"
                                           decoration-success="github_status == 'active'"
                                           decoration-warning="github_status == 'pending'"
                                           decoration-danger="github_status in ('error', 'inactive', 'orphan')"
                                           decoration-muted="github_status == 'draft'"/>
                                    <field name="last_sync_date" readonly="1" optional="show"/>
                                    <field name="sync_message" readonly="1" optional="hide"/>
                                    <button name="action_sync"
                                            string="Sync"
                                            type="object"
                                            icon="fa-refresh"
                                            title="Sincronizar este repositorio"/>
                                    <button name="action_revoke"
                                            string="Revocar"
                                            type="object"
                                            icon="fa-times"
                                            title="Revocar acceso a este repositorio"
                                            confirm="¿Revocar el acceso a este repositorio?"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SEARCH VIEW                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_github_sales_access_search" model="ir.ui.view">
        <field name="name">github.sales.access.search</field>
        <field name="model">github.sales.access</field>
        <field name="arch" type="xml">
            <search string="Buscar Accesos GitHub">
                <field name="github_partner_id" string="Usuario GitHub"/>
                <field name="github_username" string="GitHub Login"/>
                <field name="partner_id" string="Cliente"/>
                <separator/>
                <filter string="Activos"
                        name="active_in_github"
                        domain="[('github_status', '=', 'active')]"/>
                <filter string="Pendientes"
                        name="pending_sync"
                        domain="[('github_status', '=', 'pending')]"/>
                <filter string="Con Error"
                        name="with_error"
                        domain="[('github_status', '=', 'error')]"/>
                <filter string="Revocados"
                        name="inactive"
                        domain="[('github_status', '=', 'inactive')]"/>
                <filter string="⚠️ Huérfanos (sin suscripción)"
                        name="orphan"
                        domain="[('github_status', '=', 'orphan')]"/>
                <separator/>
                <filter string="⚠️ Sin usuario GitHub asignado"
                        name="missing_github_user"
                        domain="[('github_partner_id', '=', False), ('github_username', '=', False), ('order_state', 'in', ['2_renewal', '3_progress', '7_upsell'])]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Usuario GitHub" name="group_github_user" context="{'group_by': 'github_partner_id'}"/>
                    <filter string="Estado GitHub" name="group_status" context="{'group_by': 'github_status'}"/>
                    <filter string="Estado Suscripción" name="group_order_state" context="{'group_by': 'order_state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
