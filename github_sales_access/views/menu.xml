<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- MENU — Ventas > Pedidos > Accesos GitHub                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Entrada bajo el menú principal de Pedidos de sale (siempre disponible) -->
    <menuitem id="menu_github_sales_access"
              name="Accesos GitHub"
              parent="sale.sale_order_menu"
              action="action_github_sales_access_all"
              sequence="30"/>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- MENU — Suscripciones > Accesos GitHub                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Entrada bajo el menú de Suscripciones (requiere sale_subscription) -->
    <menuitem id="menu_github_sales_access_subscription"
              name="Accesos GitHub"
              parent="sale_subscription.menu_sale_subscription"
              action="action_github_sales_access_all"
              sequence="30"
              groups="sales_team.group_sale_salesman"/>
</odoo>
