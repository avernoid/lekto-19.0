<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron MENSUAL: sincronizar accesos activos -->
    <record id="cron_sync_github_sales_accesses" model="ir.cron">
        <field name="name">GitHub: Sync Active Sales Accesses</field>
        <field name="model_id" search="[('model', '=', 'github.sales.access')]"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_active_accesses()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active">True</field>
        <field name="priority">10</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Cron semanal: detectar discrepancias (colaboradores huérfanos) -->
    <record id="cron_check_github_sales_discrepancies" model="ir.cron">
        <field name="name">GitHub: Check Collaborator Discrepancies</field>
        <field name="model_id" search="[('model', '=', 'github.sales.access')]"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_discrepancies()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="priority">15</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
