<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_inherit_types_system_pension" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.types_system_pension</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='citizenship']//div[field[@name='passport_id']]" position="after">
                <field name="pension_system_id" groups="hr.group_hr_manager"/>
                <field name="commission_type" invisible="is_cuspp == False" groups="hr.group_hr_manager"/>
                <field name="cuspp" invisible="is_cuspp == False"  groups="hr.group_hr_manager"/>
                <field name="is_cuspp" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
