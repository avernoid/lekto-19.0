#. module: add_user_by_journal
#: code:addons/add_user_by_journal/models/account_journal.py:0
#, python-format
msgid "<i>None</i>"
msgstr "<i>Ninguno</i>"

#. module: add_user_by_journal
#: code:addons/add_user_by_journal/models/account_journal.py:0
#, python-format
msgid ""
"\n"
"                    <div class=\"alert alert-info\" role=\"alert\">\n"
"                        <strong>✅ Public Access:</strong> This journal is visible to <b>ALL users</b> with accounting rights.<br/>\n"
"                        <small>(Because both 'Assigned Users' and 'Allowed Groups' are empty)</small>\n"
"                    </div>\n"
"                "
msgstr ""
"\n"
"                    <div class=\"alert alert-info\" role=\"alert\">\n"
"                        <strong>✅ Acceso Público:</strong> Este diario es visible para <b>TODOS los usuarios</b> con permisos contables.<br/>\n"
"                        <small>(Porque tanto 'Usuarios Asignados' como 'Grupos Permitidos' están vacíos)</small>\n"
"                    </div>\n"
"                "

#. module: add_user_by_journal
#: code:addons/add_user_by_journal/models/account_journal.py:0
#, python-format
msgid ""
"\n"
"                    <div class=\"alert alert-warning\" role=\"alert\">\n"
"                        <strong>🔒 Restricted Access:</strong> Only the following will have access:\n"
"                        <ul>\n"
"                            <li><b>Users:</b> %s</li>\n"
"                            <li><b>Groups:</b> %s</li>\n"
"                            <li><b>Administrators</b> (Always have access)</li>\n"
"                        </ul>\n"
"                    </div>\n"
"                "
msgstr ""
"\n"
"                    <div class=\"alert alert-warning\" role=\"alert\">\n"
"                        <strong>🔒 Acceso Restringido:</strong> Solo los siguientes tendrán acceso:\n"
"                        <ul>\n"
"                            <li><b>Usuarios:</b> %s</li>\n"
"                            <li><b>Grupos:</b> %s</li>\n"
"                            <li><b>Administradores</b> (Siempre tienen acceso)</li>\n"
"                        </ul>\n"
"                    </div>\n"
"                "

#. module: add_user_by_journal
#: model:ir.ui.view,arch_db:add_user_by_journal.account_journal_view_form_inherit_add_user_by_journal
