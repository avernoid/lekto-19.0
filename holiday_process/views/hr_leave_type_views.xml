<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_type_view_form_inherit_holiday_process" model="ir.ui.view">
        <field name="name">hr.leave.type.view.form.inherit.holiday_process</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="priority" eval="2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='leave_validation_type']" position="after">
                <field name="show_in_time_off_request"/>
            </xpath>
        </field>
    </record>

</odoo>
