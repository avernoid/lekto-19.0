<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.form.inherit.portal.assign</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="before">
                <field name="allow_portal_user" invisible="1"/>
            </field>
            <field name="user_ids" position="attributes">
                <attribute name="domain">['&amp;', ('active', '=', True), '|', ('share', '=', False), ('share', '=', allow_portal_user)]</attribute>
            </field>
        </field>
    </record>

    <record id="view_task_tree2" model="ir.ui.view">
        <field name="name">project.task.tree.inherit.portal.assign</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="before">
                <field name="allow_portal_user" column_invisible="True"/>
            </field>
            <field name="user_ids" position="attributes">
                <attribute name="domain">['&amp;', ('active', '=', True), '|', ('share', '=', False), ('share', '=', allow_portal_user)]</attribute>
            </field>
        </field>
    </record>
</odoo>
