<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_reclass" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.reclass</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="reclass_mirror_journal"
                         string="Reclassification Journal"
                         company_dependent="1"
                         help="Default journal for the reclassification entries, used when neither the account nor the journal of the bill defines one.">
                    <field name="reclass_mirror_journal_id"
                           options="{'no_quick_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
