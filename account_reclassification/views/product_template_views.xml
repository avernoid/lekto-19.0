<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_reclass" model="ir.ui.view">
        <field name="name">product.template.form.inherit.reclass</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']//group[@name='properties']" position="inside">
                <group string="Reclassification" name="reclass">
                    <field name="reclass_production_account_id"
                           placeholder="From Category"
                           options="{'no_create': True}"/>
                    <field name="reclass_effective_production_account_id"
                           invisible="reclass_production_account_id or not reclass_effective_production_account_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
