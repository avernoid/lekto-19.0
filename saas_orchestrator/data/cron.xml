<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_purge_task_history" model="ir.cron">
        <field name="name">SaaS: Purge Task History</field>
        <field name="model_id" ref="model_saas_task_history"/>
        <field name="state">code</field>
        <field name="code">env['saas.instance']._cron_purge_task_history()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="cron_check_subscription_status" model="ir.cron">
        <field name="name">SaaS: Check Subscription Status</field>
        <field name="model_id" ref="model_saas_instance"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_subscription_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="cron_sync_openclaw_versions" model="ir.cron">
        <field name="name">SaaS: Sync OpenClaw Versions</field>
        <field name="model_id" ref="model_saas_openclaw_version"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_versions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
