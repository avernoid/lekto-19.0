<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="saas_operation_upgrade_wizard_view_form" model="ir.ui.view">
        <field name="name">saas.operation.upgrade.wizard.form</field>
        <field name="model">saas.operation.upgrade.wizard</field>
        <field name="arch" type="xml">
            <form string="Upgrade Instance">
                <sheet>
                    <div class="oe_title">
                        <h2>Upgrade Instance</h2>
                    </div>
                    <group>
                        <field name="instance_id" readonly="1"/>
                        <field name="target_version"
                               placeholder="e.g. v2026.4.11"/>
                    </group>
                    <div class="alert alert-info" role="status">
                        This will dispatch the upgrade script declared in the
                        blueprint catalog. The operation runs asynchronously on
                        the orchestrator; track its progress in the Task History.
                    </div>
                </sheet>
                <footer>
                    <button name="action_run"
                            type="object"
                            string="Run Upgrade"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="saas_operation_upgrade_wizard_action" model="ir.actions.act_window">
        <field name="name">Upgrade Instance</field>
        <field name="res_model">saas.operation.upgrade.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
