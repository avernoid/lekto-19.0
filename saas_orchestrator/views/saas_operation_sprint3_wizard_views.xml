<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================================
         Restart wizard
         ==================================================================== -->
    <record id="saas_operation_restart_wizard_view_form" model="ir.ui.view">
        <field name="name">saas.operation.restart.wizard.form</field>
        <field name="model">saas.operation.restart.wizard</field>
        <field name="arch" type="xml">
            <form string="Restart Instance">
                <sheet>
                    <div class="oe_title">
                        <h2>Restart Instance</h2>
                    </div>
                    <group>
                        <field name="instance_id" readonly="1"/>
                    </group>
                    <div class="alert alert-warning" role="status">
                        Restart causes ~5-10 seconds of downtime. In-flight requests
                        will be dropped (OpenClaw has no drain endpoint). Use Upgrade
                        if you need zero-downtime semantics.
                    </div>
                </sheet>
                <footer>
                    <button name="action_run" type="object"
                            string="Restart Now" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="saas_operation_restart_wizard_action" model="ir.actions.act_window">
        <field name="name">Restart Instance</field>
        <field name="res_model">saas.operation.restart.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ====================================================================
         Rotate password wizard
         ==================================================================== -->
    <record id="saas_operation_rotate_password_wizard_view_form" model="ir.ui.view">
        <field name="name">saas.operation.rotate_password.wizard.form</field>
        <field name="model">saas.operation.rotate_password.wizard</field>
        <field name="arch" type="xml">
            <form string="Rotate Gateway Password">
                <sheet>
                    <div class="oe_title">
                        <h2>Rotate Gateway Password</h2>
                    </div>
                    <group>
                        <field name="instance_id" readonly="1"/>
                        <field name="notify_client"/>
                        <field name="confirmed"/>
                    </group>
                    <div class="alert alert-warning" role="status">
                        This generates a new gateway password, updates AWS Secrets
                        Manager, and restarts the container. <strong>All active
                        sessions will be invalidated</strong> and clients will need
                        to re-authenticate.
                    </div>
                </sheet>
                <footer>
                    <button name="action_run" type="object"
                            string="Rotate Now" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="saas_operation_rotate_password_wizard_action" model="ir.actions.act_window">
        <field name="name">Rotate Gateway Password</field>
        <field name="res_model">saas.operation.rotate_password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ====================================================================
         Update env var wizard
         ==================================================================== -->
    <record id="saas_operation_update_env_var_wizard_view_form" model="ir.ui.view">
        <field name="name">saas.operation.update_env_var.wizard.form</field>
        <field name="model">saas.operation.update_env_var.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Env Var">
                <sheet>
                    <div class="oe_title">
                        <h2>Update Env Var</h2>
                    </div>
                    <group>
                        <field name="instance_id" readonly="1"/>
                        <field name="var_name" placeholder="MY_VAR_NAME"/>
                        <field name="var_value" placeholder="value"/>
                        <field name="is_secret"/>
                    </group>
                    <div class="alert alert-info" role="status">
                        Sets or replaces an environment variable on the OpenClaw
                        container. The container will be restarted so the new value
                        takes effect (~5-10s downtime).
                    </div>
                </sheet>
                <footer>
                    <button name="action_run" type="object"
                            string="Update &amp; Restart" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="saas_operation_update_env_var_wizard_action" model="ir.actions.act_window">
        <field name="name">Update Env Var</field>
        <field name="res_model">saas.operation.update_env_var.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
