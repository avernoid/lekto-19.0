<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_view_form_saas" model="ir.ui.view">
        <field name="name">product.template.form.saas</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="SaaS">
                    <group>
                        <group string="SaaS Product">
                            <field name="saas_blueprint_id"/>
                            <field name="saas_plan_id"/>
                        </group>
                        <group string="Add-on">
                            <field name="is_saas_addon"/>
                            <field name="addon_type" invisible="not is_saas_addon"/>
                            <field name="addon_qty" invisible="not is_saas_addon"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
