<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="saas_task_history_view_tree" model="ir.ui.view">
        <field name="name">saas.task.history.tree</field>
        <field name="model">saas.task.history</field>
        <field name="arch" type="xml">
            <list string="Operations History">
                <field name="instance_id"/>
                <field name="operation_id"/>
                <field name="task_type"/>
                <field name="orchestrator_task_id" column_invisible="1"/>
                <field name="state" widget="badge"/>
                <field name="created_at"/>
                <field name="completed_at"/>
                <field name="duration_seconds"/>
            </list>
        </field>
    </record>

    <record id="saas_task_history_view_form" model="ir.ui.view">
        <field name="name">saas.task.history.form</field>
        <field name="model">saas.task.history</field>
        <field name="arch" type="xml">
            <form string="Control Plane Operation">
                <sheet>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="operation_id"/>
                            <field name="task_type"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="orchestrator_task_id"/>
                            <field name="created_at"/>
                            <field name="completed_at"/>
                            <field name="duration_seconds"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload"/>
                        </page>
                        <page string="Execution Details">
                            <field name="ssm_command_id"/>
                            <field name="result_summary"/>
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="saas_task_history_action" model="ir.actions.act_window">
        <field name="name">Operations History</field>
        <field name="res_model">saas.task.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
