<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="saas_tenant_view_tree" model="ir.ui.view">
        <field name="name">saas.tenant.tree</field>
        <field name="model">saas.tenant</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="slug"/>
                <field name="partner_id"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="saas_tenant_view_form" model="ir.ui.view">
        <field name="name">saas.tenant.form</field>
        <field name="model">saas.tenant</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="slug" readonly="1"/>
                        <field name="partner_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Instances">
                            <field name="instance_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="saas_tenant_action" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">saas.tenant</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
