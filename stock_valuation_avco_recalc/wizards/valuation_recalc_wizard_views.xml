<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_valuation_recalc_wizard_form" model="ir.ui.view">
        <field name="name">stock.valuation.recalc.wizard.form</field>
        <field name="model">stock.valuation.recalc.wizard</field>
        <field name="arch" type="xml">
            <form string="AVCO Valuation Recalculation">
                <sheet>
                    <div class="alert alert-info" role="status" style="margin-bottom: 20px;">
                        <h4><i class="fa fa-info-circle" title="Info"/> Stock Valuation Recalculation (AVCO)</h4>
                        <p>
                            This tool corrects valuation inconsistencies by recalculating the <strong>Average Cost</strong> sequentially ("Waterfall" method).
                        </p>
                        <hr/>
                        <div class="mb-0">
                            <strong>How to use:</strong>
                            <ol>
                                <li><strong>Smart Start Date:</strong> The system automatically found earlier moves to ensure a complete fix. <em>(It sets the <strong>Start From</strong> date to the oldest move that contributes to the current stock).</em></li>
                                <li><strong>Verify Initial Balance:</strong> These values represent your stock <strong>strictly BEFORE</strong> that Start Date. <em>(e.g., If 'Start From' is your very first move, Initial Balance will correctly be 0.0).</em></li>
                                <li>
                                    <strong>Execute:</strong> The tool will recalculate the Average Cost sequentially from that point forward.
                                </li>
                            </ol>
                        </div>
                        <p class="text-muted" style="font-size: 0.9em;">
                            <i class="fa fa-warning" title="Warning"/> <strong>Note:</strong> This operation updates <code>stock.move</code> records directly. It does not generate new Journal Entries.
                        </p>
                    </div>
                    <group>
                        <field name="mode"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="product_id" force_save="1"/>
                            <field name="start_date" force_save="1"/>
                            <field name="initial_qty" decoration-warning="initial_qty &lt; 0"/>
                            <field name="initial_value" decoration-warning="initial_value &lt; 0"/>
                            <field name="new_standard_price" optional="show"
                                   column_invisible="parent.mode != 'restate'"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm_recalc" string="Confirm &amp; Execute" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
