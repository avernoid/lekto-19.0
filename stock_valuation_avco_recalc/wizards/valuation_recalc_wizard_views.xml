<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_valuation_recalc_wizard_form" model="ir.ui.view">
        <field name="name">stock.valuation.recalc.wizard.form</field>
        <field name="model">stock.valuation.recalc.wizard</field>
        <field name="arch" type="xml">
            <form string="Rebuild Stock Valuation">
                <sheet>
                    <div class="alert alert-info" role="status">
                        <p>The stored value of the deliveries and customer returns of these products is brought back to what Odoo's own valuation engine gives them, with the same method used for late revaluations.</p>
                        <ul class="mb-0">
                            <li>No journal entry is posted: review the differences with your accountant.</li>
                            <li>Periods before <strong>Known From</strong> keep the values they were reported with.</li>
                            <li>The product cost is refreshed by Odoo; manual valuations are kept.</li>
                        </ul>
                    </div>
                    <group>
                        <field name="date"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm_recalc" string="Rebuild" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
