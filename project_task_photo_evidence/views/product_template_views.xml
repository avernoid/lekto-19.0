<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_evidence" model="ir.ui.view">
        <field name="name">product.template.form.evidence</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale']" position="after">
                <group string="Task Evidence" name="evidence">
                    <field name="evidence_required"/>
                    <field name="evidence_min_qty" invisible="not evidence_required"/>
                    <field name="evidence_max_qty" invisible="not evidence_required"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
