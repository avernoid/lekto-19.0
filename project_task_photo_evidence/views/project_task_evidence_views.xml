<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_evidence_tree" model="ir.ui.view">
        <field name="name">project.task.evidence.list</field>
        <field name="model">project.task.evidence</field>
        <field name="arch" type="xml">
            <list string="Evidences">
                <field name="sequence" widget="handle"/>
                <field name="task_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="exclude_from_report"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_project_task_evidence_form" model="ir.ui.view">
        <field name="name">project.task.evidence.form</field>
        <field name="model">project.task.evidence</field>
        <field name="arch" type="xml">
            <form string="Evidence">
                <sheet>
                    <group>
                        <group>
                            <field name="task_id"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="exclude_from_report"/>
                        </group>
                        <group>
                            <field name="image" widget="image" options="{'size': [300, 300]}"/>
                        </group>
                        <group string="Geolocation">
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="map_url" widget="url"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
