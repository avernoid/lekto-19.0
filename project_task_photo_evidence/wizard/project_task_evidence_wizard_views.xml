<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_evidence_wizard_form" model="ir.ui.view">
        <field name="name">project.task.evidence.wizard.form</field>
        <field name="model">project.task.evidence.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Photo Evidence" js_class="evidence_geolocation_wizard">
                <group>
                    <field name="task_id" readonly="1"/>
                    <field name="product_id"/>
                    <field name="name"/>
                    <field name="image" widget="image_camera"/>
                </group>
                <group string="Geolocation">
                    <group>
                        <field name="latitude" readonly="1" force_save="1"/>
                    </group>
                    <group>
                        <field name="longitude" readonly="1" force_save="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_save" string="Save &amp; Close" type="object" class="btn-primary"/>
                    <button name="action_save_and_new" string="Save &amp; New" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_task_evidence_wizard" model="ir.actions.act_window">
        <field name="name">Add Information</field>
        <field name="res_model">project.task.evidence.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
