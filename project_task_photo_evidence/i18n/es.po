#. module: project_task_photo_evidence
#: model:ir.model.fields,help:project_task_photo_evidence.field_product_template__evidence_required
msgid ""
"If checked, tasks linked to this product (via Sales Order Item) will require "
"photo evidence. This enforces quality control for field service operations."
msgstr "Si está marcado, las tareas vinculadas a este producto (vía línea de pedido) requerirían evidencia fotográfica. Esto refuerza el control de calidad para operaciones de campo."

#. module: project_task_photo_evidence
#: model:ir.model.fields,help:project_task_photo_evidence.field_product_template__evidence_min_qty
msgid ""
"Minimum number of photos required to consider the evidence collection "
"sufficient for this product."
msgstr "Número mínimo de fotos requeridas para considerar la recolección de evidencia suficiente para este producto."

#. module: project_task_photo_evidence
#: model:ir.model.fields,help:project_task_photo_evidence.field_product_template__evidence_max_qty
msgid ""
"Maximum number of photos allowed for this product. Useful to prevent storage "
"waste. Set to 0 for unlimited."
msgstr "Número máximo de fotos permitidas para este producto. Útil para prevenir desperdicio de almacenamiento. Establecer en 0 para ilimitado."

#. module: project_task_photo_evidence
#: model:ir.model.fields,help:project_task_photo_evidence.field_project_task_evidence__name
#: model:ir.model.fields,help:project_task_photo_evidence.field_project_task_evidence_wizard__name
msgid "Short description or label for this photo evidence."
msgstr "Descripción corta o etiqueta para esta evidencia fotográfica."

#. module: project_task_photo_evidence
#: model:ir.model.fields,help:project_task_photo_evidence.field_project_task_evidence__image
#: model:ir.model.fields,help:project_task_photo_evidence.field_project_task_evidence_wizard__image
msgid "Photo evidence captured. Automatically resized to max 1280x1280."
msgstr "Evidencia fotográfica capturada. Redimensionada automáticamente a un máximo de 1280x1280."

#. module: project_task_photo_evidence
#: model:ir.model.fields,help:project_task_photo_evidence.field_project_task_evidence__task_id
msgid "The Project Task this evidence belongs to."
msgstr "La Tarea de Proyecto a la que pertenece esta evidencia."

#. module: project_task_photo_evidence
#: model:ir.model.fields,help:project_task_photo_evidence.field_project_task_evidence__product_id
msgid ""
"The Product associated with the evidence, usually inherited from the Task's "
"Sales Order Item."
msgstr "El Producto asociado con la evidencia, usualmente heredado de la línea de pedido de venta de la tarea."

#. module: project_task_photo_evidence
