<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_report_financial_view_form" model="ir.ui.view">
        <field name="name">wizard.report.financial.view.form</field>
        <field name="model">wizard.report.financial</field>
        <field name="arch" type="xml">
            <form string="Financial Annexes Report">
                <group>
                    <group string="Report Period">
                        <field name="date_start" widget="daterange"/>
                        <field name="date_end" widget="daterange"/>
                        <field name="seniority_report"/>
                    </group>
                    <group string="Configuration">
                        <field name="xls_filename" invisible="1"/>
                        <div class="text-muted" colspan="2">
                            Select the accounts you want to include in the report. Usually Payable or Receivable accounts.
                        </div>
                    </group>
                </group>
                <separator string="Filter Accounts"/>
                <field name="account_ids" nolabel="1">
                    <list>
                        <field name="code"/>
                        <field name="name"/>
                    </list>
                </field>
                <footer>
                    <button string="Generate Excel" name="action_generate_excel" type="object" default_focus="1" class="oe_highlight" icon="fa-download"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" icon="fa-times"/>
                    <field name="xls_binary" filename="xls_filename" readonly="1" invisible="not xls_filename" widget="binary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_report_financial" model="ir.actions.act_window">
        <field name="name">Financial Annexes (Excel)</field>
        <field name="res_model">wizard.report.financial</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_financial_reports" name="Financial Reports" parent="account.menu_finance_reports"/>
    <menuitem id="menu_reports_notes" name="Financial Annexes (Excel)" action="action_wizard_report_financial" parent="menu_financial_reports" sequence="1"/>

</odoo>
