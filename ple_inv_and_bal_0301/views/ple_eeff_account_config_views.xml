<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ple_eeff_account_config_tree" model="ir.ui.view">
        <field name="name">ple.eeff.account.config.tree</field>
        <field name="model">ple.eeff.account.config</field>
        <field name="arch" type="xml">
            <list string="Configuración Cuentas EEFF" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="account_prefix"/>
                <field name="account_suffix"/>
                <field name="eeff_ple_id"/>
                <field name="internal_group"/>
                <button name="action_update_eeff_wizard" string="Asignar" type="object" icon="fa-cogs"/>
            </list>
        </field>
    </record>

    <record id="view_ple_eeff_account_config_form" model="ir.ui.view">
        <field name="name">ple.eeff.account.config.form</field>
        <field name="model">ple.eeff.account.config</field>
        <field name="arch" type="xml">
            <form string="Configuración Cuenta EEFF">
                <sheet>
                    <group>
                        <group string="Identificación de Cuenta">
                            <field name="name"/>
                            <field name="account_prefix"/>
                            <field name="account_suffix"/>
                        </group>
                        <group string="Configuración EEFF">
                            <field name="eeff_ple_id"/>
                            <field name="internal_group"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ple_eeff_account_config_search" model="ir.ui.view">
        <field name="name">ple.eeff.account.config.search</field>
        <field name="model">ple.eeff.account.config</field>
        <field name="arch" type="xml">
            <search string="Configuración Cuentas EEFF">
                <field name="name"/>
                <field name="account_suffix"/>
                <field name="eeff_ple_id"/>
                <separator/>
                <filter name="group_asset" string="Activo" domain="[('internal_group', '=', 'asset')]"/>
                <filter name="group_liability" string="Pasivo" domain="[('internal_group', '=', 'liability')]"/>
                <filter name="group_equity" string="Capital" domain="[('internal_group', '=', 'equity')]"/>
                <group>
                    <filter name="groupby_eeff" string="Rubro EEFF" context="{'group_by': 'eeff_ple_id'}"/>
                    <filter name="groupby_group" string="Grupo interno" context="{'group_by': 'internal_group'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ple_eeff_account_config" model="ir.actions.act_window">
        <field name="name">Configuración Cuentas EEFF</field>
        <field name="res_model">ple.eeff.account.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define el mapeo entre cuentas contables y rubros EEFF (3.1).
            </p>
        </field>
    </record>

    <record id="action_ple_eeff_account_config_bulk_update" model="ir.actions.server">
        <field name="name">Asignar Rubros EEFF</field>
        <field name="model_id" ref="model_ple_eeff_account_config"/>
        <field name="binding_model_id" ref="model_ple_eeff_account_config"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_window',
                'res_model': 'ple.update.eeff.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {'default_config_ids': records.ids},
            }
        </field>
    </record>

    <!-- Menu entry under existing EEFF PLE menus -->
    <menuitem
        id="menu_ple_eeff_account_config"
        name="Configuración Cuentas EEFF"
        parent="ple_sale_book.menu_ple_config"
        action="action_ple_eeff_account_config"
        sequence="20"/>
</odoo>
