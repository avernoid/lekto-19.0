<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="external_layout_ple_0301">
        <div class="article doc_report_layout_standard" t-att-data-oe-model="doc and doc._name"
             t-att-data-oe-id="doc and doc.id"
             t-att-data-oe-lang="doc and doc.env.context.get('lang')">
            <t t-call="web.address_layout"/>
            <t t-out="0"/>
        </div>
    </template>
    <template id="print_status_finance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ple_inv_and_bal_0301.external_layout_ple_0301">
                    <div class="page">
                        <link href="/ple_inv_and_bal_0301/static/src/scss/ple_inv_and_bal_0301.css" rel="stylesheet"/>
                        <t t-if="not company">
                            <t t-if="company_id">
                                <t t-set="company" t-value="company_id"/>
                            </t>
                            <t t-elif="doc and 'company_id' in doc">
                                <t t-set="company" t-value="doc.company_id.sudo()"/>
                            </t>
                            <t t-else="else">
                                <t t-set="company" t-value="res_company"/>
                            </t>
                        </t>
                        <!-- ===== HEADER (untouched) ===== -->
                        <div class="title_0301">
                            <strong>FORMATO 3.1: LIBRO DE INVENTARIOS Y BALANCES - BALANCE GENERAL" (1)</strong>
                        </div>
                        <div class="subtitle_0301">
                            <div>
                                <strong>EJERCICIO :&amp;nbsp;</strong>
                            </div>
                            <span t-esc="doc.date_end.strftime('%Y')"/>
                            <br/>
                            <div>
                                <strong>RUC :&amp;nbsp;</strong>
                            </div>
                            <div t-field="company.partner_id.vat"/>
                            <br/>
                            <div>
                                <strong>APELLIDOS Y NOMBRES, DENOMINACIÓN O RAZÓN SOCIAL: &amp;nbsp;</strong>
                            </div>
                            <div t-field="company.partner_id.name"  style="display: inline-block; vertical-align: top;"/>
                        </div>
                        <br/>

                        <!-- ===== TWO-COLUMN LAYOUT via wrapper table ===== -->
                        <table class="ple_wrapper">
                            <tr>
                                <!-- ========== LEFT COLUMN: ACTIVO ========== -->
                                <td>
                                    <table class="ple_table">
                                        <tbody>
                                            <!-- Section: ACTIVO -->
                                            <tr class="ple_section_header">
                                                <td>ACTIVO</td>
                                                <td></td>
                                            </tr>
                                            <!-- Sub-section: ACTIVO CORRIENTE -->
                                            <tr class="ple_subsection_header">
                                                <td>ACTIVO CORRIENTE</td>
                                                <td></td>
                                            </tr>
                                            <!-- Level 3: Activo Corriente (parent = 1D01ST) -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-foreach="line.eeff_ple_id.parent_ids" t-as="parent_id">
                                                    <t t-if="parent_id.code == '1D01ST' and float(line.credit) >= 0.00">
                                                        <tr class="ple_data_row">
                                                            <td>
                                                                <t t-esc="line.eeff_ple_id.description"/>
                                                            </td>
                                                            <td>
                                                                <t t-esc="'{:,}'.format(round(float(line.credit)))"/>
                                                            </td>
                                                        </tr>
                                                        <!-- Level 4 sub-detail -->
                                                        <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="subline">
                                                            <t t-if="line.eeff_ple_id.id in subline.eeff_ple_id.parent_ids.ids and abs(float(subline.credit)) >= 0.50">
                                                                <tr class="ple_subdetail_row">
                                                                    <td>
                                                                        <t t-esc="subline.eeff_ple_id.description"/>
                                                                    </td>
                                                                    <td>
                                                                        <t t-esc="'{:,}'.format(round(float(subline.credit)))"/>
                                                                    </td>
                                                                </tr>
                                                            </t>
                                                        </t>
                                                    </t>
                                                </t>
                                            </t>
                                            <!-- Subtotal: Total Activos Corrientes -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-if="line.financial_state_code == '1D01ST' and float(line.credit) >= 0.50">
                                                    <tr class="ple_subtotal_row">
                                                        <td>
                                                            <t t-esc="line.eeff_ple_id.description"/>
                                                        </td>
                                                        <td>
                                                            <t t-esc="'{:,}'.format(round(float(line.credit)))"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <!-- Spacer -->
                                            <tr class="ple_spacer"><td></td><td></td></tr>
                                            <!-- Sub-section: ACTIVO NO CORRIENTE -->
                                            <tr class="ple_subsection_header">
                                                <td>ACTIVO NO CORRIENTE</td>
                                                <td></td>
                                            </tr>
                                            <!-- Level 3: Activo No Corriente (parent = 1D02ST) -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-foreach="line.eeff_ple_id.parent_ids" t-as="parent_id">
                                                    <t t-if="parent_id.code == '1D02ST' and abs(float(line.credit)) >= 0.50">
                                                        <tr class="ple_data_row">
                                                            <td>
                                                                <t t-esc="line.eeff_ple_id.description"/>
                                                            </td>
                                                            <td>
                                                                <t t-esc="'{:,}'.format(round(float(line.credit)))"/>
                                                            </td>
                                                        </tr>
                                                        <!-- Level 4 sub-detail -->
                                                        <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="subline">
                                                            <t t-if="line.eeff_ple_id.id in subline.eeff_ple_id.parent_ids.ids and abs(float(subline.credit)) >= 0.50">
                                                                <tr class="ple_subdetail_row">
                                                                    <td>
                                                                        <t t-esc="subline.eeff_ple_id.description"/>
                                                                    </td>
                                                                    <td>
                                                                        <t t-esc="'{:,}'.format(round(float(subline.credit)))"/>
                                                                    </td>
                                                                </tr>
                                                            </t>
                                                        </t>
                                                    </t>
                                                </t>
                                            </t>
                                            <!-- Subtotal: Total Activos No Corrientes -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-if="line.financial_state_code == '1D02ST' and abs(float(line.credit)) >= 0.50">
                                                    <tr class="ple_subtotal_row">
                                                        <td>
                                                            <t t-esc="line.eeff_ple_id.description"/>
                                                        </td>
                                                        <td>
                                                            <t t-esc="'{:,}'.format(round(float(line.credit)))"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <!-- Spacer -->
                                            <tr class="ple_spacer"><td></td><td></td></tr>
                                            <!-- Grand Total: TOTAL DE ACTIVOS -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-if="line.financial_state_code == '1D020T' and abs(float(line.credit)) >= 0.50">
                                                    <tr class="ple_grandtotal_row">
                                                        <td>
                                                            <t t-esc="line.eeff_ple_id.description"/>
                                                        </td>
                                                        <td>
                                                            <t t-esc="'{:,}'.format(round(float(line.credit)))"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                </td>

                                <!-- ========== RIGHT COLUMN: PASIVO Y PATRIMONIO ========== -->
                                <td>
                                    <table class="ple_table">
                                        <tbody>
                                            <!-- Section: PASIVO Y PATRIMONIO -->
                                            <tr class="ple_section_header">
                                                <td>PASIVO Y PATRIMONIO</td>
                                                <td></td>
                                            </tr>
                                            <!-- Sub-section: PASIVO CORRIENTE -->
                                            <tr class="ple_subsection_header">
                                                <td>PASIVO CORRIENTE</td>
                                                <td></td>
                                            </tr>
                                            <!-- Level 3: Pasivo Corriente (parent = 1D03ST) -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-foreach="line.eeff_ple_id.parent_ids" t-as="parent_id">
                                                    <t t-if="parent_id.code == '1D03ST' and abs(float(line.credit)) >= 0.50">
                                                        <tr class="ple_data_row">
                                                            <td>
                                                                <t t-esc="line.eeff_ple_id.description"/>
                                                            </td>
                                                            <td>
                                                                <t t-esc="'{:,}'.format(round(abs(float(line.credit))))"/>
                                                            </td>
                                                        </tr>
                                                        <!-- Level 4 sub-detail -->
                                                        <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="subline">
                                                            <t t-if="line.eeff_ple_id.id in subline.eeff_ple_id.parent_ids.ids and abs(float(subline.credit)) >= 0.50">
                                                                <tr class="ple_subdetail_row">
                                                                    <td>
                                                                        <t t-esc="subline.eeff_ple_id.description"/>
                                                                    </td>
                                                                    <td>
                                                                        <t t-esc="'{:,}'.format(round(abs(float(subline.credit))))"/>
                                                                    </td>
                                                                </tr>
                                                            </t>
                                                        </t>
                                                    </t>
                                                </t>
                                            </t>
                                            <!-- Subtotal: Total Pasivos Corrientes -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-if="line.financial_state_code == '1D03ST' and abs(float(line.credit)) >= 0.50">
                                                    <tr class="ple_subtotal_row">
                                                        <td>
                                                            <t t-esc="line.eeff_ple_id.description"/>
                                                        </td>
                                                        <td>
                                                            <t t-esc="'{:,}'.format(round(abs(float(line.credit))))"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <!-- Spacer -->
                                            <tr class="ple_spacer"><td></td><td></td></tr>
                                            <!-- Sub-section: PASIVO NO CORRIENTE -->
                                            <tr class="ple_subsection_header">
                                                <td>PASIVO NO CORRIENTE</td>
                                                <td></td>
                                            </tr>
                                            <!-- Level 3: Pasivo No Corriente (parent = 1D04ST) -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-foreach="line.eeff_ple_id.parent_ids" t-as="parent_id">
                                                    <t t-if="parent_id.code == '1D04ST' and abs(float(line.credit)) >= 0.50">
                                                        <tr class="ple_data_row">
                                                            <td>
                                                                <t t-esc="line.eeff_ple_id.description"/>
                                                            </td>
                                                            <td>
                                                                <t t-esc="'{:,}'.format(round(abs(float(line.credit))))"/>
                                                            </td>
                                                        </tr>
                                                        <!-- Level 4 sub-detail -->
                                                        <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="subline">
                                                            <t t-if="line.eeff_ple_id.id in subline.eeff_ple_id.parent_ids.ids and abs(float(subline.credit)) >= 0.50">
                                                                <tr class="ple_subdetail_row">
                                                                    <td>
                                                                        <t t-esc="subline.eeff_ple_id.description"/>
                                                                    </td>
                                                                    <td>
                                                                        <t t-esc="'{:,}'.format(round(abs(float(subline.credit))))"/>
                                                                    </td>
                                                                </tr>
                                                            </t>
                                                        </t>
                                                    </t>
                                                </t>
                                            </t>
                                            <!-- Subtotal: Total Pasivos No Corrientes -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-if="line.financial_state_code == '1D04ST' and abs(float(line.credit)) >= 0.50">
                                                    <tr class="ple_subtotal_row">
                                                        <td>
                                                            <t t-esc="line.eeff_ple_id.description"/>
                                                        </td>
                                                        <td>
                                                            <t t-esc="'{:,}'.format(round(abs(float(line.credit))))"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <!-- Spacer -->
                                            <tr class="ple_spacer"><td></td><td></td></tr>
                                            <!-- Grand Total: Total Pasivos -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-if="line.financial_state_code == '1D040T' and abs(float(line.credit)) >= 0.50">
                                                    <tr class="ple_subtotal_row">
                                                        <td>
                                                            <t t-esc="line.eeff_ple_id.description"/>
                                                        </td>
                                                        <td>
                                                            <t t-esc="'{:,}'.format(round(abs(float(line.credit))))"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <!-- Spacer -->
                                            <tr class="ple_spacer"><td></td><td></td></tr>
                                            <!-- Sub-section: PATRIMONIO NETO -->
                                            <tr class="ple_subsection_header">
                                                <td>PATRIMONIO NETO</td>
                                                <td></td>
                                            </tr>
                                            <!-- Level 3: Patrimonio (parent = 1D07ST) -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-foreach="line.eeff_ple_id.parent_ids" t-as="parent_id">
                                                    <t t-if="parent_id.code == '1D07ST' and abs(float(line.credit)) >= 0.50">
                                                        <tr class="ple_data_row">
                                                            <td>
                                                                <t t-esc="line.eeff_ple_id.description"/>
                                                            </td>
                                                            <td>
                                                                <t t-esc="'{:,}'.format(round(abs(float(line.credit))))"/>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </t>
                                            </t>
                                            <!-- Subtotal: Total Patrimonio -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-if="line.financial_state_code == '1D07ST' and abs(float(line.credit)) >= 0.50">
                                                    <tr class="ple_subtotal_row">
                                                        <td>
                                                            <t t-esc="line.eeff_ple_id.description"/>
                                                        </td>
                                                        <td>
                                                            <t t-esc="'{:,}'.format(round(abs(float(line.credit))))"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <!-- Spacer -->
                                            <tr class="ple_spacer"><td></td><td></td></tr>
                                            <!-- Grand Total: TOTAL PASIVO Y PATRIMONIO -->
                                            <t t-foreach="doc.line_ids.sorted(key=lambda x: x.sequence)" t-as="line">
                                                <t t-if="line.financial_state_code == '1D070T' and abs(float(line.credit)) >= 0.50">
                                                    <tr class="ple_grandtotal_row">
                                                        <td>
                                                            <t t-esc="line.eeff_ple_id.description"/>
                                                        </td>
                                                        <td>
                                                            <t t-esc="'{:,}'.format(round(abs(float(line.credit))))"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
