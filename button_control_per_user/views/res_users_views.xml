<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Extend res.users form view to add Button Rules tab -->
    <record id="view_users_form_button_rules" model="ir.ui.view">
        <field name="name">res.users.form.button.rules</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Add new tab in notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Interface Rules" name="button_rules" groups="base.group_system">
                    <group>
                        <group>
                            <field name="button_rule_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Button Visibility Rules">
                        <p class="text-muted">
                            Configure which interface buttons should be hidden for this user 
                            in specific contexts. Rules only affect UI visibility, not permissions.
                        </p>
                        <p class="text-muted">
                            <strong>Important:</strong> If no rules are configured, the user will see 
                            Odoo's native interface without any modifications.
                        </p>
                    </group>
                    <field name="button_rule_ids" context="{'default_user_id': id}">
                        <list editable="bottom">
                            <field name="res_model" 
                                   placeholder="Leave empty for all models"
                                   help="Model where this rule applies (e.g., project.task). Leave empty to apply to all models."/>
                            <field name="view_type" 
                                   help="Type of view where this rule applies"/>
                            <field name="button_name" 
                                   help="Button to control"/>
                            <field name="context_key" 
                                   help="Business context where this rule applies"/>
                            <field name="hide" 
                                   help="Check to hide the button, uncheck to show"/>
                        </list>
                    </field>
                    <group>
                        <group string="Field Descriptions" class="text-muted">
                            <p><strong>Model:</strong> Technical name of the model (e.g., project.task, sale.order). 
                               Leave empty to apply the rule to all models.</p>
                            <p><strong>View Type:</strong> The type of view where the button should be hidden 
                               (Kanban, List, or Form).</p>
                            <p><strong>Button:</strong> The standard button to hide.</p>
                            <p><strong>Business Context:</strong></p>
                            <ul>
                                <li><em>Any Context:</em> Rule always applies</li>
                                <li><em>Field Service:</em> Only in FSM (Field Service Management) views</li>
                                <li><em>From Sales:</em> Only when opened from a sales order</li>
                                <li><em>Read-only Mode:</em> Only when the view is in read-only mode</li>
                            </ul>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    
</odoo>
