<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Inherit product.product form view -->
    <record id="product_product_form_github" model="ir.ui.view">
        <field name="name">product.product.form.github.doc</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- Add sync button in header -->
            <xpath expr="//header" position="inside">
                <button name="button_sync_github_doc"
                        type="object"
                        string="Sync GitHub Doc"
                        class="btn-secondary"
                        icon="fa-github"
                        invisible="not github_branch_id"/>
                <button name="button_count_lines_of_code"
                        type="object"
                        string="Count Lines"
                        class="btn-secondary"
                        icon="fa-code"
                        invisible="not github_branch_id"/>
            </xpath>
            <!-- Add GitHub fields in Sales tab -->
            <xpath expr="//page[@name='sales']" position="inside">
                <separator string="GitHub Connector"/>
                <group>
                    <group>
                        <field name="github_branch_id"/>
                        <field name="lines_of_code"
                               invisible="not github_branch_id"/>
                    </group>
                    <group>
                        <field name="github_doc_needs_update"
                               invisible="not github_branch_id"
                               readonly="1"
                               widget="boolean_toggle"/>
                        <field name="lines_of_code_date"
                               invisible="not github_branch_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Server action for list view multi-select: Sync GitHub Doc -->
    <record id="action_sync_github_doc" model="ir.actions.server">
        <field name="name">Sync GitHub Doc</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.button_sync_github_doc()
        </field>
    </record>

    <!-- Server action for list view multi-select: Count Lines of Code -->
    <record id="action_count_lines_of_code" model="ir.actions.server">
        <field name="name">Count Lines of Code</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.button_count_lines_of_code()
        </field>
    </record>

</odoo>

