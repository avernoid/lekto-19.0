        <field name="categ_id" ref="categ_demo_itde"/>
        <field name="standard_price">620.0</field>
        <field name="list_price">820.0</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
    </record>
    <record id="product_impresora" model="product.product">
