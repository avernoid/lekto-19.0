        <field name="default_code">ITDE-SIL01</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="categ_id" ref="categ_demo_itde"/>
        <field name="standard_price">240.0</field>
        <field name="list_price">360.0</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
    </record>
    <record id="product_escritorio" model="product.product">
        <field name="name">Escritorio Melamina 1.20m</field>
        <field name="default_code">ITDE-ESC01</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="categ_id" ref="categ_demo_itde"/>
