    </record>
    <record id="customer_sur" model="res.partner">
        <field name="name">Corporación Servicios del Sur S.A.C.</field>
        <field name="company_type">company</field>
        <field name="customer_rank">1</field>
        <field name="country_id" ref="base.pe"/>
    </record>
    <record id="customer_pacifico" model="res.partner">
        <field name="name">Inversiones El Pacífico S.A.C.</field>
        <field name="company_type">company</field>
        <field name="customer_rank">1</field>
        <field name="country_id" ref="base.pe"/>
    </record>
    <record id="customer_oficentro" model="res.partner">
        <field name="name">Oficentro Lima S.A.C.</field>
        <field name="company_type">company</field>
        <field name="customer_rank">1</field>
        <field name="country_id" ref="base.pe"/>
    </record>

    <!-- ============================================================= -->
    <!-- Build the captured history programmatically                    -->
    <!-- ============================================================= -->
    <function model="invoice.type.document.demo" name="_generate_demo_data"/>

</odoo>
