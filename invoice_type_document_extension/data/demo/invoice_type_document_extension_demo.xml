<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        DEMO DATA for invoice_type_document_extension (PLE 13.1 - Kardex
        transfer-document capture).

        This file declares the *static* master data (product category, products,
        partners). The actual history — confirmed purchases/sales, validated
        receipts/deliveries, posted vendor bills and customer invoices, a
        purchase return, internal transfers — is generated
        programmatically by ``invoice.type.document.demo._generate_demo_data()``
        (called at the end of this file), because captured stock moves cannot be
        created as flat XML: they must go through the real confirm/receive/post
        flow so the capture events fire exactly as in production.

        All data is 100% SYNTHETIC.

        How to study it (Inventory > Operations > Product Moves, add the optional
        "Doc Type / Serie / Correlativo / Transfer Doc Manually Set" columns):
          - Most moves already carry the fiscal document taken from their bill or
            invoice (the steady state).
          - Select some moves > Action > "Assign document type & number" to try
            the wizard. The demo purposely leaves examples for every strategy:
              * empty-but-derivable moves      -> "Fill empty" / "Re-derive"
              * moves with a stale value        -> "Re-derive" fixes them
              * hand-edited (manual) moves      -> protected unless include_manual
              * moves whose picking has a legacy value -> "Recover serie/number"
              * internal transfers / unposted bills / no-prefix bill -> stay empty
    -->

    <!-- ============================================================= -->
    <!-- Product category: periodic valuation, so studying the transfer -->
    <!-- document needs no stock-accounting configuration.              -->
    <!-- ============================================================= -->
    <record id="categ_demo_itde" model="product.category">
        <field name="name">Demo PLE / Documentos de traslado</field>
        <field name="property_valuation">periodic</field>
        <field name="property_cost_method">average</field>
    </record>

    <!-- ============================================================= -->
    <!-- Products (synthetic office/IT catalogue)                       -->
    <!-- ============================================================= -->
    <record id="product_laptop" model="product.product">
        <field name="name">Laptop Empresarial 14\" i5</field>
        <field name="default_code">ITDE-LAP01</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="categ_id" ref="categ_demo_itde"/>
        <field name="standard_price">2800.0</field>
        <field name="list_price">3500.0</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
    </record>
    <record id="product_monitor" model="product.product">
        <field name="name">Monitor 24\" Full HD</field>
        <field name="default_code">ITDE-MON24</field>
        <field name="type">consu</field>
