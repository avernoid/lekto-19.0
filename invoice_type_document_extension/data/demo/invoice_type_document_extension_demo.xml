    </record>
    <record id="product_ssd" model="product.product">
        <field name="name">Disco SSD NVMe 1TB</field>
        <field name="default_code">ITDE-SSD01</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="categ_id" ref="categ_demo_itde"/>
        <field name="standard_price">255.0</field>
        <field name="list_price">380.0</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
    </record>

    <!-- ============================================================= -->
    <!-- Partners (synthetic PE-style vendors and customers)            -->
    <!-- ============================================================= -->
    <record id="vendor_tecnoandes" model="res.partner">
        <field name="name">Importaciones TecnoAndes S.A.C.</field>
        <field name="company_type">company</field>
        <field name="supplier_rank">1</field>
        <field name="country_id" ref="base.pe"/>
