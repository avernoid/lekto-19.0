<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The three transfer fields moved to stock.move (per-movement).  The
         picking form keeps only a quick-set launcher for the common
         "one picking = one document" case (design doc 3.5). -->
    <record id="stock_picking_view_form_inherit_invoice_type_document_extension" model="ir.ui.view">
        <field name="name">stock.picking.form.transfer.document.quickset</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <button name="action_confirm" position="before">
                <button name="action_itde_quickset_transfer_document"
                        type="object"
                        string="Set PLE Document"
                        invisible="country_code != 'PE' or state == 'draft'"/>
            </button>
            <!-- Optional (hidden-by-default) columns on the picking's Operations
                 move list (stock.view_picking_form -> field move_ids inline list). -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='date_deadline']" position="after">
                <field name="transfer_document_type_id" optional="hide"/>
                <field name="serie_transfer_document" optional="hide"/>
                <field name="number_transfer_document" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
