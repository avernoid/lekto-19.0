<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_transfer_document_quickset_form" model="ir.ui.view">
        <field name="name">stock.transfer.document.quickset.form</field>
        <field name="model">stock.transfer.document.quickset</field>
        <field name="arch" type="xml">
            <form string="Set Transfer Document">
                <group>
                    <field name="picking_id" invisible="1"/>
                    <field name="transfer_document_type_id"/>
                    <field name="serie_transfer_document"/>
                    <field name="number_transfer_document"/>
                    <field name="override_manual"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
