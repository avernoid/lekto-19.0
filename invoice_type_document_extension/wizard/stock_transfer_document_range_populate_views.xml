<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_transfer_document_range_populate_form" model="ir.ui.view">
        <field name="name">stock.transfer.document.range.populate.form</field>
        <field name="model">stock.transfer.document.range.populate</field>
        <field name="arch" type="xml">
            <form string="Populate PLE Transfer Document">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="mode" widget="radio"/>
                        <field name="overwrite" invisible="mode != 'rederive'"/>
                    </group>
                </group>
                <p class="text-muted">
                    Runs in batches over the movements of the selected date range.
                    Manual edits are always preserved.
                </p>
                <footer>
                    <button name="action_run" type="object" string="Run" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_transfer_document_range_populate" model="ir.actions.act_window">
        <field name="name">PLE: Populate Transfer Document (by date)</field>
        <field name="res_model">stock.transfer.document.range.populate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_transfer_document_range_populate"
              name="PLE: Populate Transfer Document"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_stock_transfer_document_range_populate"
              groups="stock.group_stock_manager"
              sequence="95"/>
</odoo>
