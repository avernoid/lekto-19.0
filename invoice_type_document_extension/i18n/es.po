#. module: invoice_type_document_extension
#. odoo-python
#: code:addons/invoice_type_document_extension/models/stock_move.py:0
#, python-format
msgid "The transfer document number must be 20 characters or fewer (got %s)."
msgstr ""
"El número del documento de traslado debe tener 20 caracteres o menos (se "
"recibió %s)."

#. module: invoice_type_document_extension
#. odoo-python
#: code:addons/invoice_type_document_extension/models/stock_move.py:0
#, python-format
msgid "The transfer document number must be positive (got %s)."
msgstr "El número del documento de traslado debe ser positivo (se recibió %s)."
