<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_form_view_inherit_various_data" model="ir.ui.view">
        <field name="name">hr.employee.form.view.inherit.various_data</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='personal_information']/group" position="inside">
                <group string="SCTR" name="sctr_info" groups="hr.group_hr_manager">
                    <field name="pension_sctr"/>
                    <field name="sctr_id"
                           widget="many2many_tags"
                           invisible="pension_sctr == False"/>
                    <field name="sctr_name" string="Policy Name"
                           invisible="not pension_sctr" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
