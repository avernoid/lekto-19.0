<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_carrier_form_carrier_purchase" model="ir.ui.view">
        <field name="name">delivery.carrier.form.carrier.purchase</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <div name="title" position="before">
                <field name="carrier_purchase_enabled" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not purchase_auto_warning">
                    <i class="fa fa-exclamation-triangle" title="Warning"/>
                    The delivery product of this method creates a purchase by itself when a sale is confirmed
                    (Purchase Automatically), and the transport is also bought per shipment.
                    Disable Purchase Automatically on the product so the transport is not bought twice.
                </div>
            </div>
            <notebook position="inside">
                <page string="Transport Purchase" name="carrier_purchase" invisible="not carrier_purchase_enabled"
                      groups="purchase.group_purchase_user">
                    <group>
                        <group>
                            <field name="purchase_partner_id"/>
                            <field name="purchase_product_id" placeholder="Delivery product"/>
                        </group>
                        <group>
                            <field name="purchase_cost_type"/>
                            <field name="purchase_fixed_cost" invisible="purchase_cost_type != 'fixed'"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
