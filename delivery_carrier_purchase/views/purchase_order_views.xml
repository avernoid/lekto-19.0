<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_carrier_purchase" model="ir.ui.view">
        <field name="name">purchase.order.form.carrier.purchase</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_carrier_pickings" type="object" class="oe_stat_button" icon="fa-truck"
                        invisible="not carrier_picking_count" groups="stock.group_stock_user">
                    <field name="carrier_picking_count" widget="statinfo" string="Shipments"/>
                </button>
            </div>
            <field name="origin" position="after">
                <field name="carrier_purchase_period" invisible="not carrier_purchase_period"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_line_form2_carrier_purchase" model="ir.ui.view">
        <field name="name">purchase.order.line.form2.carrier.purchase</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <separator string="Shipments" invisible="not carrier_picking_ids"/>
                <field name="carrier_picking_ids" invisible="not carrier_picking_ids" readonly="1"
                       widget="many2many_tags" groups="stock.group_stock_user"/>
            </field>
        </field>
    </record>

</odoo>
