<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_carrier_purchase_cancel_form" model="ir.ui.view">
        <field name="name">carrier.purchase.cancel.form</field>
        <field name="model">carrier.purchase.cancel</field>
        <field name="arch" type="xml">
            <form string="Cancel Transport Purchase">
                <p>
                    The purchase line of the transport is not deleted: its price goes to 0 and its
                    description starts with CANCELLED and the reason. A line already billed is not
                    changed (ask the vendor for a credit note).
                </p>
                <group>
                    <field name="picking_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Cancel Transport Purchase" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Discard" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
