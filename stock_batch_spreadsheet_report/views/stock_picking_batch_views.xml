<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_batch_form_inherit_spreadsheet" model="ir.ui.view">
        <field name="name">stock.picking.batch.form.inherit.spreadsheet</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_spreadsheet_reports"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-table"
                        invisible="spreadsheet_count == 0">
                    <field name="spreadsheet_count" widget="statinfo" string="Reports"/>
                </button>
            </div>
            <header position="inside">
                <button name="action_create_spreadsheet_report"
                        string="Create Report"
                        type="object"
                        class="oe_highlight"
                        invisible="state == 'draft'"/>
            </header>
        </field>
    </record>
</odoo>
