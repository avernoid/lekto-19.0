<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_batch_spreadsheet_template_view_form" model="ir.ui.view">
        <field name="name">stock.batch.spreadsheet.template.view.form</field>
        <field name="model">stock.batch.spreadsheet.template</field>
        <field name="arch" type="xml">
            <form string="Batch Spreadsheet Template">
                <header>
                    <button string="Create Spreadsheet" type="object" name="action_create_spreadsheet" 
                            class="btn-primary" invisible="spreadsheet_id"/>
                    <button string="Edit Spreadsheet" type="object" name="action_open_spreadsheet" 
                            class="btn-primary" invisible="not spreadsheet_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="picking_type_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="spreadsheet_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_batch_spreadsheet_template_view_tree" model="ir.ui.view">
        <field name="name">stock.batch.spreadsheet.template.view.tree</field>
        <field name="model">stock.batch.spreadsheet.template</field>
        <field name="arch" type="xml">
            <list string="Batch Spreadsheet Templates" editable="bottom">
                <field name="name"/>
                <field name="spreadsheet_id" optional="hide"/>
                <button string="Create" class="float-end" icon="fa-plus-circle" type="object" name="action_create_spreadsheet" 
                        invisible="spreadsheet_id"/>
                <button string="Edit" class="float-end" icon="fa-pencil" type="object" name="action_open_spreadsheet" 
                        invisible="not spreadsheet_id"/>
            </list>
        </field>
    </record>

    <record id="action_stock_batch_spreadsheet_template" model="ir.actions.act_window">
        <field name="name">Batch Spreadsheet Templates</field>
        <field name="res_model">stock.batch.spreadsheet.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Spreadsheet Template for Batch Pickings
            </p>
        </field>
    </record>

    <menuitem id="menu_stock_batch_spreadsheet_template"
              parent="stock.menu_stock_config_settings"
              action="action_stock_batch_spreadsheet_template"
              sequence="100"/>
</odoo>
