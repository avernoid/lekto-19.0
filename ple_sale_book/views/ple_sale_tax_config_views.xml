<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ple_sale_tax_config_tree" model="ir.ui.view">
        <field name="name">ple.sale.tax.config.tree</field>
        <field name="model">ple.sale.tax.config</field>
        <field name="arch" type="xml">
            <list string="PLE Sales Tax Configuration" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="tax_prefix"/>
                <field name="tax_code"/>
                <field name="repartition_type"/>
                <field name="tag_invoice_id"/>
                <field name="tag_refund_id"/>
                <button name="action_update_tags_wizard" string="Run Update" type="object" icon="fa-cogs"/>
            </list>
        </field>
    </record>

    <record id="view_ple_sale_tax_config_form" model="ir.ui.view">
        <field name="name">ple.sale.tax.config.form</field>
        <field name="model">ple.sale.tax.config</field>
        <field name="arch" type="xml">
            <form string="PLE Sales Tax Configuration">
                <sheet>
                    <group>
                        <group string="Tax Identification">
                            <field name="name"/>
                            <field name="tax_prefix"/>
                            <field name="tax_code"/>
                        </group>
                        <group string="Configuration">
                            <field name="repartition_type"/>
                            <field name="tag_invoice_id"/>
                            <field name="tag_refund_id"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ple_sale_tax_config" model="ir.actions.act_window">
        <field name="name">Tax Configuration (PLE)</field>
        <field name="res_model">ple.sale.tax.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define the mapping between Taxes and PLE Tags.
            </p>
        </field>
    </record>
    <record id="action_ple_sale_tax_config_bulk_update_tags" model="ir.actions.server">
        <field name="name">Update Tags</field>
        <field name="model_id" ref="model_ple_sale_tax_config"/>
        <field name="binding_model_id" ref="model_ple_sale_tax_config"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_window',
                'res_model': 'ple.update.tags.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {'default_config_ids': records.ids},
            }
        </field>
    </record>
</odoo>
