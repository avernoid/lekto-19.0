<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="account_move_view_form_inherit_ple_sale_book" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.ple_sale_book</field>
        <field name="model">account.move</field>
        <field name="inherit_id"
            ref="account_origin_invoice.account_move_form_view_inherit_account_origin_invoice" />
        <field name="arch" type="xml">
            <page name="other_info" position="inside">
                <group>
                    <group>
                        <field name="bool_pay_invoice" />
                    </group>
                </group>
                <group string="Información PLE" name="ple_group">
                    <field name="ple_date" />
                    <field name="ple_state" readonly="move_type in ['out_invoice', 'out_refund']" />
                    <field name="ple_its_declared" />
                </group>
            </page>
        </field>
    </record>

    <record id="move_form_inherit_ple_sale_book" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ple_sale_book</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='aml_tab']/field[@name='line_ids']/list/field[@name='account_id']" position="after">
                <field name="ple_correlative" />
            </xpath>
        </field>
    </record>
</odoo>