<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ======================================================== -->
        <!-- ACCOUNT TAGS (Created explicitly if missing) -->
        <!-- ======================================================== -->
        
        <!-- S_BASE_OG: Operación Gravada -->
        <record id="tag_ple_sale_base_og" model="account.account.tag">
            <field name="name">S_BASE_OG</field>
            <field name="applicability">taxes</field>
            <field name="country_id" ref="base.pe"/>
        </record>

        <!-- S_TAX_OG: IGV -->
        <record id="tag_ple_sale_tax_og" model="account.account.tag">
            <field name="name">S_TAX_OG</field>
            <field name="applicability">taxes</field>
            <field name="country_id" ref="base.pe"/>
        </record>

        <!-- S_BASE_OE: Exonerado -->
        <record id="tag_ple_sale_base_oe" model="account.account.tag">
            <field name="name">S_BASE_OE</field>
            <field name="applicability">taxes</field>
            <field name="country_id" ref="base.pe"/>
        </record>

        <!-- S_BASE_OU: Inafecto -->
        <record id="tag_ple_sale_base_ou" model="account.account.tag">
            <field name="name">S_BASE_OU</field>
            <field name="applicability">taxes</field>
            <field name="country_id" ref="base.pe"/>
        </record>

        <!-- S_TAX_ISC: ISC -->
        <record id="tag_ple_sale_tax_isc" model="account.account.tag">
            <field name="name">S_TAX_ISC</field>
            <field name="applicability">taxes</field>
            <field name="country_id" ref="base.pe"/>
        </record>

        <!-- S_BASE_EXP: Exportación -->
        <record id="tag_ple_sale_base_exp" model="account.account.tag">
            <field name="name">S_BASE_EXP</field>
            <field name="applicability">taxes</field>
            <field name="country_id" ref="base.pe"/>
        </record>
        
        <!-- S_BASE_IVAP: IVAP Base -->
        <record id="tag_ple_sale_base_ivap" model="account.account.tag">
            <field name="name">S_BASE_IVAP</field>
            <field name="applicability">taxes</field>
            <field name="country_id" ref="base.pe"/>
        </record>
        
        <!-- S_TAX_IVAP: IVAP Tax -->
        <record id="tag_ple_sale_tax_ivap" model="account.account.tag">
            <field name="name">S_TAX_IVAP</field>
            <field name="applicability">taxes</field>
            <field name="country_id" ref="base.pe"/>
        </record>
        
        <!-- S_TAX_OTHER: Otros -->
        <record id="tag_ple_sale_tax_other" model="account.account.tag">
            <field name="name">S_TAX_OTHER</field>
            <field name="applicability">taxes</field>
            <field name="country_id" ref="base.pe"/>
        </record>
        
        <!-- S_TAX_ICBP: Bolsas -->
        <record id="tag_ple_sale_tax_icbp" model="account.account.tag">
            <field name="name">S_TAX_ICBP</field>
            <field name="applicability">taxes</field>
            <field name="country_id" ref="base.pe"/>
        </record>


        <!-- ======================================================== -->
        <!-- DEFAULT CONFIGURATION RULES -->
        <!-- ======================================================== -->

        <!-- IGV 18% -->
        <record id="config_ple_sale_igv_18_base" model="ple.sale.tax.config">
            <field name="name">IGV 18% - Base Imponible</field>
            <field name="sequence">1</field>
            <field name="tax_prefix">account</field>
            <field name="tax_code">sale_tax_igv_18</field>
            <field name="repartition_type">base</field>
            <field name="tag_invoice_id" ref="tag_ple_sale_base_og"/>
            <field name="tag_refund_id" ref="tag_ple_sale_base_og"/>
        </record>
        <record id="config_ple_sale_igv_18_tax" model="ple.sale.tax.config">
            <field name="name">IGV 18% - Impuesto</field>
            <field name="sequence">2</field>
            <field name="tax_prefix">account</field>
            <field name="tax_code">sale_tax_igv_18</field>
            <field name="repartition_type">tax</field>
            <field name="tag_invoice_id" ref="tag_ple_sale_tax_og"/>
            <field name="tag_refund_id" ref="tag_ple_sale_tax_og"/>
        </record>

        <!-- IGV 18% Included -->
        <record id="config_ple_sale_igv_18_incl_base" model="ple.sale.tax.config">
            <field name="name">IGV 18% (Incluido) - Base Imponible</field>
            <field name="sequence">3</field>
            <field name="tax_prefix">account</field>
            <field name="tax_code">sale_tax_igv_18_included</field>
            <field name="repartition_type">base</field>
            <field name="tag_invoice_id" ref="tag_ple_sale_base_og"/>
            <field name="tag_refund_id" ref="tag_ple_sale_base_og"/>
        </record>
        <record id="config_ple_sale_igv_18_incl_tax" model="ple.sale.tax.config">
            <field name="name">IGV 18% (Incluido) - Impuesto</field>
            <field name="sequence">4</field>
            <field name="tax_prefix">account</field>
            <field name="tax_code">sale_tax_igv_18_included</field>
            <field name="repartition_type">tax</field>
            <field name="tag_invoice_id" ref="tag_ple_sale_tax_og"/>
            <field name="tag_refund_id" ref="tag_ple_sale_tax_og"/>
        </record>

        <!-- Exonerated -->
        <record id="config_ple_sale_exo_base" model="ple.sale.tax.config">
            <field name="name">Exonerado (0%) - Base</field>
            <field name="sequence">5</field>
            <field name="tax_prefix">account</field>
            <field name="tax_code">sale_tax_exo</field>
            <field name="repartition_type">base</field>
            <field name="tag_invoice_id" ref="tag_ple_sale_base_oe"/>
            <field name="tag_refund_id" ref="tag_ple_sale_base_oe"/>
        </record>

        <!-- Inafecto -->
        <record id="config_ple_sale_ina_base" model="ple.sale.tax.config">
            <field name="name">Inafecto (0%) - Base</field>
            <field name="sequence">6</field>
            <field name="tax_prefix">account</field>
            <field name="tax_code">sale_tax_ina</field>
            <field name="repartition_type">base</field>
            <field name="tag_invoice_id" ref="tag_ple_sale_base_ou"/>
            <field name="tag_refund_id" ref="tag_ple_sale_base_ou"/>
        </record>

        <!-- ISC -->
        <record id="config_ple_sale_ics_base" model="ple.sale.tax.config">
            <field name="name">ISC - Base</field>
            <field name="sequence">7</field>
            <field name="tax_prefix">account</field>
            <field name="tax_code">sale_tax_ics_0</field>
            <field name="repartition_type">base</field>
            <field name="tag_invoice_id" ref="tag_ple_sale_tax_isc"/>
            <field name="tag_refund_id" ref="tag_ple_sale_tax_isc"/>
        </record>
        
        <!-- Exportation -->
        <record id="config_ple_sale_exp_base" model="ple.sale.tax.config">
            <field name="name">Exportación - Base</field>
            <field name="sequence">8</field>
            <field name="tax_prefix">account</field>
            <field name="tax_code">sale_tax_exp</field>
            <field name="repartition_type">base</field>
            <field name="tag_invoice_id" ref="tag_ple_sale_base_exp"/>
            <field name="tag_refund_id" ref="tag_ple_sale_base_exp"/>
        </record>

        <!-- Gratuito -->
        <record id="config_ple_sale_gra_base" model="ple.sale.tax.config">
            <field name="name">0% Gratuito</field>
            <field name="sequence">9</field>
            <field name="tax_prefix">account</field>
            <field name="tax_code">sale_tax_gra</field>
            <field name="repartition_type">base</field>
            <field name="tag_invoice_id" ref="tag_ple_sale_base_oe"/>
            <field name="tag_refund_id" ref="tag_ple_sale_base_oe"/>
        </record>

    </data>
</odoo>
