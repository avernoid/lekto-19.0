#. module: ple_sale_book
#: model:ir.model.fields,field_description:ple_sale_book.field_account_move__ple_state
msgid "Status PLE"
msgstr "Estado PLE"

#. module: ple_sale_book
#: model:ir.model.fields,help:ple_sale_book.field_account_move__ple_state
msgid "Indicates the status of the document in the PLE. 1: Registered in the period. 2: Cancelled document. 8: Registered in a previous period. 9: Correction of a previous period."
msgstr "Indica el estado del documento en el PLE. 1: Registrado en el periodo. 2: Documento cancelado. 8: Registrado en un periodo previo. 9: Corrección de un periodo previo."

#. module: ple_sale_book
