#: model:ir.model.fields,help:ple_sale_book.field_account_move__ple_its_declared
msgid "Checked if this document has already been declared to SUNAT."
msgstr "Marcado si este documento ya fue declarado a SUNAT."

#. module: ple_sale_book
#: model:ir.model.fields,field_description:ple_sale_book.field_account_move__ple_date
msgid "Date PLE"
msgstr "Fecha PLE"

#. module: ple_sale_book
#: model:ir.model.fields,help:ple_sale_book.field_account_move__ple_date
msgid "Date used to determine the PLE reporting period. Defaults to Invoice Date."
msgstr "Fecha usada para decidir el periodo de reporte PLE. Por defecto es la Fecha de Factura."

#. module: ple_sale_book
#: model:ir.model.fields,field_description:ple_sale_book.field_account_move__bool_pay_invoice
