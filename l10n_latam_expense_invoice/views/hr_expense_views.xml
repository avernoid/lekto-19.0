<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_form_latam_expense" model="ir.ui.view">
        <field name="name">hr.expense.view.form.inherit.latam.expense</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vendor_id']" position="after">
                <field name="allowed_document_type_ids" invisible="1"/>
                <field name="l10n_latam_document_type_id" options="{'no_create': True, 'no_open': True}" invisible="not allowed_document_type_ids"/>
                <field name="l10n_latam_document_number" invisible="not allowed_document_type_ids or not l10n_latam_document_type_id"/>
            </xpath>
        </field>
    </record>
</odoo>
