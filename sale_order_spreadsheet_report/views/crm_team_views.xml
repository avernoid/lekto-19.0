<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_view_form_inherit_sale_spreadsheet" model="ir.ui.view">
        <field name="name">crm.team.form.inherit.sale.spreadsheet</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="sale_spreadsheet_template_id"/>
            </xpath>
        </field>
    </record>
</odoo>
