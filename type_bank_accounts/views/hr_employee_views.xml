<?xml version="1.0" encoding="utf-8"?>
<odoo>



    <record id="view_employee_form_inherit_bank_view" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.bank.view</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information']" position="inside">
                    <group string="Payments">
                        <field name="account_salary_bank"/>
                        <field name="type_salary_bank"/>
                        <field name="account_cts_bank"/>
                        <field name="type_cts_bank"/>
                    </group>
            </xpath>
        </field>
    </record>

</odoo>
