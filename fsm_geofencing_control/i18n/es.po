#. module: fsm_geofencing_control
#: model:ir.model.fields,field_description:fsm_geofencing_control.field_project_project__control_distance_on_start
msgid "Control Distance on Start"
msgstr "Controlar distancia al iniciar"

#. module: fsm_geofencing_control
#: model:ir.model.fields,help:fsm_geofencing_control.field_project_project__control_distance_on_start
msgid "Validate technician is within allowed distance from customer when starting timer."
msgstr "Validar que el técnico esté dentro de la distancia permitida del cliente al iniciar el temporizador."

#. module: fsm_geofencing_control
#: model:ir.model.fields,field_description:fsm_geofencing_control.field_project_project__allowed_distance
msgid "Allowed Distance (m)"
msgstr "Distancia permitida (m)"

#. module: fsm_geofencing_control
#: model:ir.model.fields,help:fsm_geofencing_control.field_project_project__allowed_distance
msgid "Maximum distance in meters allowed between technician and customer location."
msgstr "Distancia máxima en metros permitida entre el técnico y la ubicación del cliente."

#. module: fsm_geofencing_control
#: model:ir.model.fields,field_description:fsm_geofencing_control.field_project_project__control_distance_on_stop
msgid "Control Distance on Stop"
msgstr "Controlar distancia al salir"

#. module: fsm_geofencing_control
#: model:ir.model.fields,help:fsm_geofencing_control.field_project_project__control_distance_on_stop
msgid "Validate technician is within allowed distance from customer when stopping timer."
msgstr "Validar que el técnico esté dentro de la distancia permitida del cliente al detener el temporizador."

#. module: fsm_geofencing_control
#: model:ir.model.fields,field_description:fsm_geofencing_control.field_project_project__auto_mark_done
msgid "Auto Mark Done"
