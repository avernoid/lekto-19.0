<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Project Form View -->
    <record id="view_project_form_geofencing" model="ir.ui.view">
        <field name="name">project.project.form.geofencing</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="geofencing" string="Geofencing" invisible="not is_fsm">
                    <group>
                        <group>
                            <field name="allow_geolocation"/>
                            <field name="control_distance_on_start" 
                                   invisible="not allow_geolocation"
                                   widget="boolean_toggle"/>
                            <field name="control_distance_on_stop" 
                                   invisible="not allow_geolocation"
                                   widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="allowed_distance" 
                                   invisible="not control_distance_on_start and not control_distance_on_stop"
                                   required="control_distance_on_start or control_distance_on_stop"/>
                            <field name="auto_mark_done" 
                                   widget="boolean_toggle"/>
                            <field name="use_lost_reason" 
                                   widget="boolean_toggle"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
