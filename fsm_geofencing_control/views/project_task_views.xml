<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Task Form View to show last location (for debugging/audit) -->
    <record id="view_task_form_geofencing" model="ir.ui.view">
        <field name="name">project.task.form.geofencing</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Add last location fields in developer mode -->
            <xpath expr="//notebook" position="inside">
                <page string="Geofencing Debug" groups="base.group_no_one">
                    <group>
                        <group>
                            <field name="last_latitude"/>
                            <field name="last_longitude"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
