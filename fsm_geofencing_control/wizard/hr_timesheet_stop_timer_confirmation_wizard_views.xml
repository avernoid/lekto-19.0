<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Stop Timer Wizard Form View -->
    <record id="view_hr_timesheet_stop_timer_wizard_geofencing" model="ir.ui.view">
        <field name="name">hr.timesheet.stop.timer.confirmation.wizard.form.geofencing</field>
        <field name="model">hr.timesheet.stop.timer.confirmation.wizard</field>
        <field name="inherit_id" ref="industry_fsm.hr_timesheet_stop_timer_confirmation_wizard_view_form_inherit"/>
        <field name="arch" type="xml">
            <!-- Add lost reason field after time_spent -->
            <field name="time_spent" position="after">
                <field name="use_lost_reason" invisible="1"/>
                <field name="task_has_confirmed_sale" invisible="1"/>
                <field name="control_distance_on_stop" invisible="1"/>
                <field name="auto_mark_done" invisible="1"/>
                <field name="lost_reason_id" 
                       required="use_lost_reason and not task_has_confirmed_sale"
                       invisible="not use_lost_reason or task_has_confirmed_sale"
                       placeholder="Select a reason why the sale was not confirmed..."/>
            </field>
        </field>
    </record>
</odoo>
