<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_variant_import_view_form" model="ir.ui.view">
        <field name="name">product.variant.import.form</field>
        <field name="model">product.variant.import</field>
        <field name="arch" type="xml">
            <form string="Variant Import Toolkit">
                <group invisible="state == 'done'">
                    <group>
                        <field name="data_file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                        <field name="delimiter"/>
                        <field name="encoding"/>
                    </group>
                    <group>
                        <field name="assign_template_xmlid"/>
                        <field name="claim_existing"/>
                        <field name="freeze_others"/>
                        <field name="module_prefix"/>
                    </group>
                </group>
                <field name="state" invisible="1"/>
                <field name="result_html" invisible="state != 'done'" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="product_variant_import_action" model="ir.actions.act_window">
        <field name="name">Variant Import Toolkit</field>
        <field name="res_model">product.variant.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_product_variant_import"
              name="Variant Import Toolkit"
              parent="stock.menu_stock_inventory_control"
              action="product_variant_import_action"
              sequence="90"
              groups="stock.group_stock_manager"/>

</odoo>
