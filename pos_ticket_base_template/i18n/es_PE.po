#. module: pos_ticket_base_template
#: model:ir.model.fields,field_description:pos_ticket_base_template.field_pos_config__automatic_download_electronic_invoice
#: model:ir.model.fields,field_description:pos_ticket_base_template.field_res_config_settings__pos_automatic_download_electronic_invoice
msgid "Automatic Electronic Invoice Download"
msgstr "Descarga automática factura electrónica"

#. module: pos_ticket_base_template
#: model:ir.model.fields,help:pos_ticket_base_template.field_pos_config__automatic_download_electronic_invoice
#: model:ir.model.fields,help:pos_ticket_base_template.field_res_config_settings__pos_automatic_download_electronic_invoice
msgid "If enabled, the browser will automatically initiate a download of the electronic invoice PDF once the POS order is validated."
msgstr "Si está activado, el navegador iniciará automáticamente una descarga del PDF de la factura electrónica una vez que se valide el pedido del POS."

#. module: pos_ticket_base_template
#: model:ir.model.fields,field_description:pos_ticket_base_template.field_pos_config__automatic_print_electronic_invoice
#: model:ir.model.fields,field_description:pos_ticket_base_template.field_res_config_settings__pos_automatic_print_electronic_invoice
msgid "Automatic Electronic Invoice Printing"
msgstr "Impresión automática factura electrónica"

#. module: pos_ticket_base_template
#: model:ir.model.fields,help:pos_ticket_base_template.field_pos_config__automatic_print_electronic_invoice
#: model:ir.model.fields,help:pos_ticket_base_template.field_res_config_settings__pos_automatic_print_electronic_invoice
msgid "If enabled, the system will automatically trigger the print dialog for the electronic invoice PDF immediately after the POS order is validated."
msgstr "Si está activado, el sistema abrirá automáticamente el cuadro de diálogo de impresión para el PDF de la factura electrónica inmediatamente después de que se valide el pedido del POS."

