#. module: account_reclassification_mrp
#: model:ir.model.fields,field_description:account_reclassification_mrp.field_product_template__reclass_recognition_account_id
#: model:ir.model.fields,field_description:account_reclassification_mrp.field_product_product__reclass_recognition_account_id
