<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_reclass_mrp" model="ir.ui.view">
        <field name="name">product.template.form.inherit.reclass.mrp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account_reclassification.product_template_form_view_reclass"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='reclass']" position="inside">
                <field name="reclass_recognition_account_id"
                       placeholder="From Category"
                       options="{'no_create': True}"/>
                <field name="reclass_operations_account_id"
                       placeholder="From Category"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_category_property_form_reclass_mrp" model="ir.ui.view">
        <field name="name">product.category.form.inherit.reclass.mrp</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="account_reclassification.view_category_property_form_reclass"/>
        <field name="arch" type="xml">
            <field name="reclass_effective_production_account_id" position="after">
                <field name="reclass_recognition_account_id"
                       options="{'no_create': True}"/>
                <field name="reclass_operations_account_id"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>

</odoo>
